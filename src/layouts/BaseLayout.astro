---
import "../styles/fonts";
import "../styles/global.css";
import "../styles/site.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { APPLE_TOUCH_ICON_SRC, FAVICON_SRC } from "@/lib/brand";
import {
  allowIndexing,
  absoluteUrl,
  buildBreadcrumbList,
  buildLocalBusiness,
  buildWebPage,
  buildWebSite,
  DEFAULT_LOCALE,
  DEFAULT_OG_IMAGE,
  mergeJsonLd,
  resolveSiteUrl,
  SITE_NAME,
  type JsonLd,
} from "@/lib/seo";

interface Props {
  title: string;
  description: string;
  breadcrumb?: { href?: string; label: string }[];
  jsonLd?: JsonLd | JsonLd[];
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** Chemin canonique alternatif (ex. /cgv pour les versions imprimables). */
  canonicalPath?: string;
}

const {
  title,
  description,
  breadcrumb,
  jsonLd,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = "website",
  noindex = false,
  canonicalPath,
} = Astro.props;

const siteUrl = resolveSiteUrl(Astro.site?.href, Astro.url.origin);
const pathname = canonicalPath ?? Astro.url.pathname;
const canonical = absoluteUrl(pathname, siteUrl);
const ogImageUrl = absoluteUrl(ogImage, siteUrl);
const shouldIndex = allowIndexing && !noindex;
const isHome = pathname === "/" || pathname === "";

const extraSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas: JsonLd[] = isHome
  ? [buildWebSite(siteUrl), buildLocalBusiness(siteUrl), ...extraSchemas]
  : [buildWebPage({ siteUrl, canonical, title, description }), buildLocalBusiness(siteUrl), ...extraSchemas];

if (breadcrumb?.length) {
  schemas.push(buildBreadcrumbList(breadcrumb, siteUrl, canonical));
}

const structured = mergeJsonLd(schemas);
---

<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Céline Meunier Ben Neji" />
    <meta name="theme-color" content="#1d3557" />
    {!shouldIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={canonical} />
    <link rel="icon" type="image/png" href={FAVICON_SRC} />
    <link rel="apple-touch-icon" href={APPLE_TOUCH_ICON_SRC} />
    <title>{title}</title>
    <meta property="og:locale" content={DEFAULT_LOCALE} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${SITE_NAME} — accompagnement social à domicile`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {shouldIndex && Object.keys(structured).length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(structured)} />
    )}
  </head>
  <body class="site">
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <SiteHeader />
    <main id="contenu">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import "@/scripts/site";
    </script>
  </body>
</html>
