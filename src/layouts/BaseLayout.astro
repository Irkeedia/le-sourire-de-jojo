---
import "../styles/global.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import BrandBackdrop from "@/components/BrandBackdrop.astro";
import CursorTracker from "@/components/CursorTracker.astro";
import { LOGO_SRC } from "@/lib/brand";
import {
  allowIndexing,
  absoluteUrl,
  buildBreadcrumbList,
  buildLocalBusiness,
  buildWebPage,
  buildWebSite,
  DEFAULT_LOCALE,
  DEFAULT_OG_IMAGE,
  mergeJsonLd,
  resolveSiteUrl,
  SITE_NAME,
  type JsonLd,
} from "@/lib/seo";

interface Props {
  title: string;
  description: string;
  breadcrumb?: { href?: string; label: string }[];
  jsonLd?: JsonLd | JsonLd[];
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** Chemin canonique alternatif (ex. /cgv pour les versions imprimables). */
  canonicalPath?: string;
}

const {
  title,
  description,
  breadcrumb,
  jsonLd,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = "website",
  noindex = false,
  canonicalPath,
} = Astro.props;
const cspNonce = Astro.locals.cspNonce;

const siteUrl = resolveSiteUrl(Astro.site?.href, Astro.url.origin);
const pathname = canonicalPath ?? Astro.url.pathname;
const canonical = absoluteUrl(pathname, siteUrl);
const ogImageUrl = absoluteUrl(ogImage, siteUrl);
const shouldIndex = allowIndexing && !noindex;
const isHome = pathname === "/" || pathname === "";

const extraSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas: JsonLd[] = isHome
  ? [buildWebSite(siteUrl), buildLocalBusiness(siteUrl), ...extraSchemas]
  : [buildWebPage({ siteUrl, canonical, title, description }), buildLocalBusiness(siteUrl), ...extraSchemas];

if (breadcrumb?.length) {
  schemas.push(buildBreadcrumbList(breadcrumb, siteUrl, canonical));
}

const structured = mergeJsonLd(schemas);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Céline Meunier Benneji" />
    <meta name="theme-color" content="#1d3557" />
    {!shouldIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={canonical} />
    <link rel="icon" type="image/png" href={LOGO_SRC} />
    <link rel="apple-touch-icon" href={LOGO_SRC} />
    <title>{title}</title>
    <meta property="og:locale" content={DEFAULT_LOCALE} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${SITE_NAME} — accompagnement social à domicile`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@500;600;700&family=Lato:ital,wght@0,400;0,700;1,400&family=Playfair+Display:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
    {shouldIndex && Object.keys(structured).length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(structured)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <BrandBackdrop />
    <CursorTracker />
    <SiteHeader />
    {
      breadcrumb && breadcrumb.length > 0 && (
        <nav aria-label="Fil d'Ariane" class="relative z-10 mx-auto w-full max-w-6xl px-4 py-3 text-sm text-marine/80 md:px-6">
          <ol class="flex flex-wrap items-center gap-2">
            {breadcrumb.map((item, i) => (
              <li class="flex items-center gap-2">
                {i > 0 && <span class="text-marine/40">/</span>}
                {item.href ? (
                  <a href={item.href} class="underline decoration-marine/30 underline-offset-2 hover:text-marine">
                    {item.label}
                  </a>
                ) : (
                  <span class="font-medium text-marine">{item.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <main id="contenu-principal" class="relative z-10 flex-1">
      <slot />
    </main>
    <SiteFooter />
    <script is:inline nonce={cspNonce}>
      (function () {
        function initScrollReveals() {
          var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          var main = document.querySelector("main");
          if (!main) return;

          var seen = new WeakSet();
          var targets = [];

          function add(el) {
            if (!(el instanceof HTMLElement)) return;
            if (seen.has(el)) return;
            seen.add(el);
            targets.push(el);
            el.classList.add("reveal-on-scroll");
            var delay = el.getAttribute("data-reveal-delay");
            if (delay && !reduce) el.style.setProperty("--reveal-delay", delay + (delay.endsWith("ms") ? "" : "ms"));
          }

          if (reduce) {
            Array.from(main.children).forEach(function (el) {
              if (!(el instanceof HTMLElement)) return;
              if (el.hasAttribute("data-reveal-skip")) return;
              el.classList.add("reveal-on-scroll", "is-inview");
            });
            Array.from(main.querySelectorAll("[data-reveal]")).forEach(function (el) {
              if (!(el instanceof HTMLElement)) return;
              el.classList.add("reveal-on-scroll", "is-inview");
            });
            document.querySelectorAll("footer [data-reveal]").forEach(function (el) {
              if (!(el instanceof HTMLElement)) return;
              el.classList.add("reveal-on-scroll", "is-inview");
            });
            return;
          }

          Array.from(main.children).forEach(function (el) {
            if (!(el instanceof HTMLElement)) return;
            if (el.hasAttribute("data-reveal-skip")) return;
            add(el);
          });

          main.querySelectorAll("[data-reveal]").forEach(add);
          document.querySelectorAll("footer [data-reveal]").forEach(add);

          var io = new IntersectionObserver(
            function (entries) {
              for (var i = 0; i < entries.length; i++) {
                var en = entries[i];
                var t = en.target;
                if (!(t instanceof HTMLElement)) continue;
                if (en.isIntersecting) t.classList.add("is-inview");
                else t.classList.remove("is-inview");
              }
            },
            { threshold: 0, rootMargin: "0px" },
          );

          function markVisibleIfInViewport(el) {
            var r = el.getBoundingClientRect();
            var vh = window.innerHeight || document.documentElement.clientHeight;
            if (r.bottom > 0 && r.top < vh) el.classList.add("is-inview");
          }

          for (var j = 0; j < targets.length; j++) {
            io.observe(targets[j]);
            markVisibleIfInViewport(targets[j]);
          }
        }

        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initScrollReveals);
        else initScrollReveals();
      })();
    </script>
    <script is:inline nonce={cspNonce}>
      (function () {
        /**
         * offsetLeft est relatif à offsetParent (souvent un ancêtre positionné), pas au
         * conteneur overflow — on aligne donc chaque enfant via getBoundingClientRect().
         */
        function snapCarouselStep(viewport, direction) {
          var kids = viewport.children;
          if (!kids.length) return;

          var vRect = viewport.getBoundingClientRect();
          var vCenter = vRect.left + vRect.width / 2;
          var activeIdx = 0;
          var minDist = Infinity;
          var i;

          for (i = 0; i < kids.length; i++) {
            var r = kids[i].getBoundingClientRect();
            var c = r.left + r.width / 2;
            var d = Math.abs(c - vCenter);
            if (d < minDist) {
              minDist = d;
              activeIdx = i;
            }
          }

          var nextIdx = activeIdx + (direction > 0 ? 1 : -1);
          if (nextIdx < 0) nextIdx = 0;
          if (nextIdx >= kids.length) nextIdx = kids.length - 1;
          if (nextIdx === activeIdx) return;

          var target = kids[nextIdx];
          var left = viewport.scrollLeft + (target.getBoundingClientRect().left - vRect.left);
          viewport.scrollTo({ left: Math.max(0, left), behavior: "smooth" });
        }

        function handleSnapControl(e) {
          var prev = e.target && e.target.closest && e.target.closest("[data-snap-prev]");
          var next = e.target && e.target.closest && e.target.closest("[data-snap-next]");
          if (!prev && !next) return;
          var id = prev ? prev.getAttribute("data-snap-prev") : next.getAttribute("data-snap-next");
          var viewport = id ? document.getElementById(id) : null;
          if (!viewport || !viewport.children || !viewport.children.length) return;
          e.preventDefault();
          snapCarouselStep(viewport, prev ? -1 : 1);
        }

        document.addEventListener("click", handleSnapControl, false);
      })();
    </script>
  </body>
</html>
