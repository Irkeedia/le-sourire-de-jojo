---
/**
 * Mise en page « application » de l'espace familles (connecté) :
 * - ordinateur : menu latéral (initiales, « Bonjour … », rubriques), en-tête avec cloche ;
 * - mobile : barre du haut compacte + barre d'onglets en bas + panneau « Plus ».
 * L'en-tête et le pied de page du site public sont volontairement absents.
 */
import "../styles/fonts";
import "../styles/global.css";
import Icon from "@/components/espace/Icon.astro";
import { FAVICON_SRC, APPLE_TOUCH_ICON_SRC, LOGO_SRC } from "@/lib/brand";
import { fmt, notificationsFor, unreadMessages, type NotificationItem } from "@/lib/dossier-data";
import type { EspaceSection, IconName } from "@/lib/espace-types";

interface Props {
  /** Titre de la page (H1). */
  title: string;
  subtitle?: string;
  active: EspaceSection;
  dossier?: { id: string; name: string };
  /** Lien de retour discret au-dessus du titre (ex. « Toutes les visites »). */
  back?: { href: string; label: string };
  /** Titre de l'onglet du navigateur, si différent. */
  pageTitle?: string;
  /** Sur mobile, masque le titre (la carte d'accueil du tableau de bord suffit). */
  hideMobileTitle?: boolean;
}

const { title, subtitle, active, dossier, back, pageTitle, hideMobileTitle = false } = Astro.props;
const user = Astro.locals.user!;
const admin = user.role === "admin";
const firstName = user.name.split(" ")[0];
const initials = user.name
  .split(/\s+/)
  .slice(0, 2)
  .map((p) => p.charAt(0).toUpperCase())
  .join("");

const base = dossier ? `/compte/dossier/${dossier.id}` : "";
const [unread, notifications] = dossier
  ? await Promise.all([unreadMessages(user.id, dossier.id), notificationsFor(user, dossier.id)])
  : [0, { count: 0, items: [] as NotificationItem[] }];

type NavItem = { key: EspaceSection; href: string; label: string; icon: IconName; badge?: number };
const dossierNav: NavItem[] = dossier
  ? [
      { key: "dashboard", href: base, label: "Tableau de bord", icon: "home" },
      { key: "carnet", href: `${base}/carnet`, label: "Carnet de sourires", icon: "carnet" },
      { key: "messages", href: `${base}/messages`, label: "Messagerie", icon: "messages", badge: unread },
      { key: "album", href: `${base}/album`, label: "Photos", icon: "album" },
      { key: "agenda", href: `${base}/agenda`, label: "Agenda", icon: "agenda" },
      { key: "documents", href: `${base}/documents`, label: "Documents", icon: "documents" },
      { key: "proches", href: `${base}/proches`, label: "Proches", icon: "proches" },
    ]
  : [];
const accountNav: NavItem[] = [
  ...(admin || !dossier ? [{ key: "dossiers" as const, href: "/compte", label: admin ? "Tous mes dossiers" : "Mes dossiers", icon: "folders" as const }] : []),
  { key: "compte", href: "/compte/mon-compte", label: "Mon compte", icon: "user" },
];

const tabs: NavItem[] = dossier
  ? [
      { key: "dashboard", href: base, label: "Accueil", icon: "home" },
      { key: "carnet", href: `${base}/carnet`, label: "Carnet", icon: "carnet" },
      { key: "messages", href: `${base}/messages`, label: "Messages", icon: "messages", badge: unread },
      { key: "album", href: `${base}/album`, label: "Photos", icon: "album" },
    ]
  : [
      { key: "dossiers", href: "/compte", label: "Dossiers", icon: "folders" },
      { key: "compte", href: "/compte/mon-compte", label: "Mon compte", icon: "user" },
    ];
const moreItems: NavItem[] = [...dossierNav.filter((n) => !tabs.some((t) => t.key === n.key)), ...accountNav.filter((n) => !tabs.some((t) => t.key === n.key))];
const moreActive = moreItems.some((n) => n.key === active);

const notifIcon: Record<NotificationItem["kind"], IconName> = {
  visite: "carnet",
  message: "messages",
  document: "documents",
  agenda: "agenda",
};
const notifTone: Record<NotificationItem["kind"], string> = {
  visite: "bg-rose-vieux/20 text-[#8f4f4f]",
  message: "bg-aquarelle-bleu/15 text-aquarelle-bleu",
  document: "bg-marine/10 text-marine",
  agenda: "bg-sauge/25 text-[#4f6b53]",
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#F6F1EA" />
    <link rel="icon" type="image/png" href={FAVICON_SRC} />
    <link rel="apple-touch-icon" href={APPLE_TOUCH_ICON_SRC} />
    <title>{pageTitle ?? `${title}${dossier ? ` — ${dossier.name}` : ""} — Espace familles`}</title>
  </head>
  <body class="espace min-h-screen bg-[#F6F1EA] font-sans text-[17px] text-marine antialiased">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:bg-marine focus:px-4 focus:py-2 focus:text-ivoire">
      Aller au contenu
    </a>

    <div class="mx-auto flex min-h-screen max-w-[1440px] gap-6 lg:p-5">
      <!-- Menu latéral (ordinateur) -->
      <aside
        class="sticky top-5 hidden h-[calc(100vh-2.5rem)] w-[17.5rem] shrink-0 flex-col overflow-y-auto rounded-[28px] bg-gradient-to-b from-[#DDE7DC] via-[#D5E1D4] to-[#C9D8C8] p-5 shadow-[0_18px_40px_rgba(29,53,87,0.10),inset_0_1px_0_rgba(255,255,255,0.7)] lg:flex"
        aria-label="Menu de l’espace familles"
      >
        <div class="flex flex-col items-center rounded-3xl bg-white/45 px-3 pb-5 pt-6 text-center shadow-[inset_0_1px_0_rgba(255,255,255,0.8)]">
          <span class="flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-[#F6DCCF] to-rose-vieux/60 font-hero text-2xl font-bold text-marine shadow-[0_10px_22px_rgba(200,141,141,0.35),inset_0_-4px_0_rgba(0,0,0,0.06)] ring-4 ring-white/80">
            {initials}
          </span>
          <p class="mt-3 font-display text-3xl leading-none text-marine">Bonjour {firstName}</p>
          {dossier && <p class="mt-2 text-sm font-semibold text-marine/70">{dossier.name}</p>}
        </div>

        <nav class="mt-5 flex-1">
          <ul class="space-y-1.5">
            {
              dossierNav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.key === active ? "page" : undefined}
                    class:list={[
                      "flex min-h-[48px] items-center gap-3 rounded-2xl px-4 text-base font-semibold transition",
                      item.key === active
                        ? "bg-cream text-marine shadow-[0_8px_18px_rgba(29,53,87,0.12),inset_0_-3px_0_rgba(29,53,87,0.06)]"
                        : "text-marine/80 hover:bg-white/50 hover:text-marine",
                    ]}
                  >
                    <Icon name={item.icon} class="h-6 w-6 shrink-0" />
                    <span class="flex-1">{item.label}</span>
                    {item.badge ? (
                      <span class="rounded-full bg-rose-vieux px-2 py-0.5 text-xs font-bold text-white" aria-label={`${item.badge} non lu${item.badge > 1 ? "s" : ""}`}>
                        {item.badge}
                      </span>
                    ) : null}
                  </a>
                </li>
              ))
            }
          </ul>
          {dossierNav.length > 0 && <hr class="my-4 border-marine/10" />}
          <ul class="space-y-1.5">
            {
              accountNav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.key === active ? "page" : undefined}
                    class:list={[
                      "flex min-h-[48px] items-center gap-3 rounded-2xl px-4 text-base font-semibold transition",
                      item.key === active
                        ? "bg-cream text-marine shadow-[0_8px_18px_rgba(29,53,87,0.12),inset_0_-3px_0_rgba(29,53,87,0.06)]"
                        : "text-marine/80 hover:bg-white/50 hover:text-marine",
                    ]}
                  >
                    <Icon name={item.icon} class="h-6 w-6 shrink-0" />
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="mt-5 space-y-1.5 border-t border-marine/10 pt-4">
          <a href="/" class="flex min-h-[44px] items-center gap-3 rounded-2xl px-4 text-base font-semibold text-marine/75 hover:bg-white/50 hover:text-marine">
            <Icon name="site" class="h-5 w-5" /> Retour au site
          </a>
          <button type="button" data-logout class="flex min-h-[44px] w-full items-center gap-3 rounded-2xl px-4 text-left text-base font-semibold text-marine/75 hover:bg-white/50 hover:text-marine">
            <Icon name="logout" class="h-5 w-5" /> Se déconnecter
          </button>
        </div>
      </aside>

      <div class="min-w-0 flex-1">
        <!-- Barre du haut : logo (mobile) ou titre (ordinateur), cloche, initiales -->
        <header class="sticky top-0 z-30 flex items-center gap-3 bg-[#F6F1EA]/90 px-4 py-3 backdrop-blur-md lg:static lg:bg-transparent lg:px-2 lg:pb-2 lg:pt-3 lg:backdrop-blur-none">
          <a href={dossier ? base : "/compte"} class="flex min-w-0 flex-1 items-center gap-3 lg:hidden">
            <img src={LOGO_SRC} alt="" width="44" height="44" class="h-11 w-11 shrink-0 rounded-full object-cover ring-2 ring-white shadow" />
            <span class="min-w-0">
              <span class="block font-display text-xl leading-none text-marine">Le Sourire de Jojo</span>
              <span class="block truncate text-sm font-semibold text-marine/65">{dossier ? dossier.name : "Espace familles"}</span>
            </span>
          </a>
          <div class="hidden min-w-0 flex-1 lg:block">
            {back && (
              <a href={back.href} class="mb-1 inline-flex min-h-[36px] items-center gap-1 text-base font-semibold text-marine/65 hover:text-marine">
                <Icon name="back" class="h-5 w-5" /> {back.label}
              </a>
            )}
            <h1 class="font-hero text-[2.15rem] font-semibold leading-tight text-marine">{title}</h1>
            {subtitle && <p class="mt-1 text-lg text-marine/70">{subtitle}</p>}
          </div>

          {
            dossier && (
              <div class="relative" data-bell data-seen-url={`/api/dossiers/${dossier.id}/seen`}>
                <button
                  type="button"
                  data-bell-toggle
                  aria-expanded="false"
                  aria-controls="bell-panel"
                  class="relative flex h-12 w-12 items-center justify-center rounded-full bg-white text-marine shadow-[0_8px_18px_rgba(29,53,87,0.12),inset_0_-3px_0_rgba(29,53,87,0.06)] hover:bg-cream"
                  aria-label={notifications.count > 0 ? `Nouveautés : ${notifications.count}` : "Nouveautés"}
                >
                  <Icon name="bell" class="h-6 w-6" />
                  {notifications.count > 0 && (
                    <span data-bell-badge class="absolute -right-1 -top-1 flex h-6 min-w-[1.5rem] items-center justify-center rounded-full bg-rose-vieux px-1.5 text-xs font-bold text-white ring-2 ring-[#F6F1EA]">
                      {notifications.count > 9 ? "9+" : notifications.count}
                    </span>
                  )}
                </button>
                <div
                  id="bell-panel"
                  hidden
                  class="fixed inset-x-3 top-[4.5rem] z-40 max-h-[70vh] overflow-y-auto rounded-3xl bg-white p-4 shadow-[0_24px_60px_rgba(29,53,87,0.22)] ring-1 ring-marine/10 lg:absolute lg:inset-x-auto lg:right-0 lg:top-14 lg:w-[24rem]"
                  role="dialog"
                  aria-label="Nouveautés depuis votre dernière visite"
                >
                  <p class="px-2 pb-2 font-hero text-lg font-semibold text-marine">Depuis votre dernière visite</p>
                  {notifications.items.length === 0 ? (
                    <p class="px-2 py-4 text-base text-marine/70">Rien de nouveau pour l’instant. 🌿</p>
                  ) : (
                    <ul class="space-y-1">
                      {notifications.items.map((n) => (
                        <li>
                          <a href={n.href} class="flex items-start gap-3 rounded-2xl p-2.5 hover:bg-cream">
                            <span class:list={["flex h-10 w-10 shrink-0 items-center justify-center rounded-xl", notifTone[n.kind]]}>
                              <Icon name={notifIcon[n.kind]} class="h-5 w-5" />
                            </span>
                            <span class="min-w-0">
                              <span class="block text-base font-semibold text-marine">{n.label}</span>
                              <span class="block text-sm text-marine/70">{n.detail}</span>
                              <span class="block text-xs text-marine/50">{fmt.stamp.format(n.date)}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            )
          }
          <a
            href="/compte/mon-compte"
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-sauge/70 to-[#6f8f73] font-hero text-base font-bold text-white shadow-[0_8px_18px_rgba(29,53,87,0.15),inset_0_-3px_0_rgba(0,0,0,0.08)]"
            aria-label="Mon compte"
          >
            {initials}
          </a>
        </header>

        <main id="contenu" class="px-4 pb-32 pt-2 lg:px-2 lg:pb-12">
          <div class:list={["lg:hidden", hideMobileTitle && "sr-only"]}>
            {back && (
              <a href={back.href} class="mb-1 inline-flex min-h-[40px] items-center gap-1 text-base font-semibold text-marine/65">
                <Icon name="back" class="h-5 w-5" /> {back.label}
              </a>
            )}
            <h1 class="font-hero text-[1.9rem] font-semibold leading-tight text-marine">{title}</h1>
            {subtitle && <p class="mt-1 text-lg text-marine/70">{subtitle}</p>}
          </div>
          <slot />
        </main>
      </div>
    </div>

    <!-- Barre d'onglets (mobile) -->
    <nav
      class="fixed inset-x-0 bottom-0 z-30 border-t border-marine/10 bg-white/95 px-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] pt-1.5 shadow-[0_-10px_30px_rgba(29,53,87,0.10)] backdrop-blur-md lg:hidden"
      aria-label="Navigation principale"
    >
      <ul class="mx-auto grid max-w-lg" style={`grid-template-columns: repeat(${tabs.length + 1}, minmax(0, 1fr));`}>
        {
          tabs.map((t) => (
            <li>
              <a
                href={t.href}
                aria-current={t.key === active ? "page" : undefined}
                class:list={[
                  "relative flex min-h-[60px] flex-col items-center justify-center gap-0.5 rounded-2xl text-[0.82rem] font-semibold",
                  t.key === active ? "text-marine" : "text-marine/60",
                ]}
              >
                <span class:list={["flex h-9 w-14 items-center justify-center rounded-full transition", t.key === active && "bg-sauge/30"]}>
                  <Icon name={t.icon} class="h-6 w-6" />
                </span>
                {t.label}
                {t.badge ? (
                  <span class="absolute right-[18%] top-0.5 flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-rose-vieux px-1 text-[0.7rem] font-bold text-white" aria-label={`${t.badge} non lu${t.badge > 1 ? "s" : ""}`}>
                    {t.badge}
                  </span>
                ) : null}
              </a>
            </li>
          ))
        }
        <li>
          <button
            type="button"
            data-more-open
            class:list={[
              "flex min-h-[60px] w-full flex-col items-center justify-center gap-0.5 rounded-2xl text-[0.82rem] font-semibold",
              moreActive ? "text-marine" : "text-marine/60",
            ]}
          >
            <span class:list={["flex h-9 w-14 items-center justify-center rounded-full", moreActive && "bg-sauge/30"]}>
              <Icon name="more" class="h-6 w-6" />
            </span>
            Plus
          </button>
        </li>
      </ul>
    </nav>

    <dialog id="more-sheet" class="m-0 mt-auto max-h-[85vh] w-full max-w-none rounded-t-[28px] bg-[#F6F1EA] p-0 text-marine backdrop:bg-marine/40 lg:hidden">
      <div class="px-4 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-3">
        <div class="mx-auto mb-3 h-1.5 w-12 rounded-full bg-marine/20" aria-hidden="true"></div>
        <div class="flex items-center justify-between">
          <p class="font-display text-3xl">Bonjour {firstName}</p>
          <button type="button" data-more-close class="flex h-12 w-12 items-center justify-center rounded-full bg-white shadow" aria-label="Fermer">
            <Icon name="close" class="h-6 w-6" />
          </button>
        </div>
        <ul class="mt-4 space-y-2">
          {
            moreItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.key === active ? "page" : undefined}
                  class:list={[
                    "flex min-h-[56px] items-center gap-3 rounded-2xl px-4 text-lg font-semibold",
                    item.key === active ? "bg-white shadow" : "bg-white/60",
                  ]}
                >
                  <Icon name={item.icon} class="h-6 w-6" /> {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/" class="flex min-h-[56px] items-center gap-3 rounded-2xl bg-white/60 px-4 text-lg font-semibold">
              <Icon name="site" class="h-6 w-6" /> Retour au site
            </a>
          </li>
          <li>
            <button type="button" data-logout class="flex min-h-[56px] w-full items-center gap-3 rounded-2xl bg-white/60 px-4 text-left text-lg font-semibold">
              <Icon name="logout" class="h-6 w-6" /> Se déconnecter
            </button>
          </li>
        </ul>
      </div>
    </dialog>

    <script>
      import { sendJson } from "@/scripts/espace-api";

      document.querySelectorAll<HTMLButtonElement>("[data-logout]").forEach((btn) =>
        btn.addEventListener("click", async () => {
          await sendJson("/api/auth/logout");
          window.location.href = "/compte/connexion";
        }),
      );

      const sheet = document.getElementById("more-sheet") as HTMLDialogElement | null;
      document.querySelector("[data-more-open]")?.addEventListener("click", () => sheet?.showModal());
      document.querySelector("[data-more-close]")?.addEventListener("click", () => sheet?.close());
      sheet?.addEventListener("click", (e) => {
        if (e.target === sheet) sheet.close();
      });

      // Cloche : ouvre la liste des nouveautés et la marque comme vue.
      const bell = document.querySelector<HTMLElement>("[data-bell]");
      const toggle = bell?.querySelector<HTMLButtonElement>("[data-bell-toggle]");
      const panel = document.getElementById("bell-panel");
      let marked = false;
      function setOpen(open: boolean) {
        if (!panel || !toggle) return;
        panel.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
        if (open && !marked && bell?.dataset.seenUrl) {
          marked = true;
          void sendJson(bell.dataset.seenUrl);
          bell.querySelector("[data-bell-badge]")?.remove();
        }
      }
      toggle?.addEventListener("click", (e) => {
        e.stopPropagation();
        setOpen(panel?.hidden ?? false);
      });
      document.addEventListener("click", (e) => {
        if (panel && !panel.hidden && !bell?.contains(e.target as Node)) setOpen(false);
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });
    </script>
  </body>
</html>
