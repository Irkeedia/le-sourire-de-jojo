---
import LogoMark from "@/components/LogoMark.astro";

const user = Astro.locals.user;

const links = [
  { href: "/", label: "Accueil", shortLabel: "Accueil", desktopLabel: "Accueil", icon: "home" },
  { href: "/services", label: "Nos services", shortLabel: "Services", desktopLabel: "Services", icon: "heart" },
  { href: "/offres", label: "Offres & forfaits", shortLabel: "Offres", desktopLabel: "Offres", icon: "tag" },
  { href: "/carnet", label: "Le carnet de sourires", shortLabel: "Carnet", desktopLabel: "Carnet", icon: "book" },
  {
    href: "/presentation",
    label: "Présentation rapide",
    shortLabel: "Présentation",
    desktopLabel: "Présentation",
    icon: "slides",
  },
  {
    href: "/partenaires",
    label: "Partenaires de confiance",
    shortLabel: "Partenaires",
    desktopLabel: "Partenaires",
    icon: "users",
  },
  {
    href: user ? "/compte" : "/compte/connexion",
    label: user ? "Mon compte" : "Connexion",
    shortLabel: user ? "Compte" : "Connexion",
    desktopLabel: user ? "Mon compte" : "Connexion",
    icon: "user",
  },
  {
    href: "/contact",
    label: "Contact & infos légales",
    shortLabel: "Contact",
    desktopLabel: "Contact",
    icon: "mail",
  },
  {
    href: "/legal",
    label: "Documents juridiques",
    shortLabel: "Juridique",
    desktopLabel: "Juridique",
    icon: "doc",
  },
] as const;

const secondaryLinks = [
  { href: "/a-propos#mon-histoire", label: "Mon histoire" },
  { href: "/plan-du-site", label: "Plan du site" },
];

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  const base = href.split("#")[0] ?? href;
  if (base === "/") return pathname === "/";
  if (base === "/compte" || base === "/compte/connexion") {
    return pathname === "/compte" || pathname.startsWith("/compte/");
  }
  if (base === "/legal") {
    return (
      pathname.startsWith("/legal") ||
      pathname === "/cgv" ||
      pathname.startsWith("/conditions-annulation") ||
      pathname.startsWith("/contrat") ||
      pathname.startsWith("/consentement") ||
      pathname.startsWith("/imprimer/")
    );
  }
  return pathname === base || pathname.startsWith(`${base}/`);
}
---

<a
  href="#contenu-principal"
  class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[200] focus:rounded-lg focus:bg-marine focus:px-4 focus:py-3 focus:text-ivoire focus:shadow-lg"
>
  Aller au contenu principal
</a>

<header
  class="sticky top-0 z-50 border-b border-marine/10 bg-cream pt-[env(safe-area-inset-top)] shadow-[0_8px_30px_rgba(29,53,87,0.06)]"
>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-marine/20 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto flex max-w-6xl items-center justify-between gap-3 px-[max(1rem,env(safe-area-inset-left))] py-2.5 sm:gap-4 sm:px-5 sm:py-3 lg:gap-6 lg:py-3.5">
    <a
      href="/"
      class="group flex min-w-0 flex-1 items-center gap-2.5 py-1 sm:gap-3 lg:flex-none"
      aria-label="Le Sourire de Jojo — Accueil"
    >
      <LogoMark size="sm" variant="header" alt="" class="hidden xs:inline-flex sm:inline-flex" />
      <span class="min-w-0">
        <span
          class="block truncate font-display text-[clamp(1.35rem,4.5vw,2.25rem)] font-semibold leading-tight text-marine transition group-hover:text-aquarelle-bleu lg:text-4xl"
        >
          Le Sourire de Jojo
        </span>
        <span class="mt-0.5 hidden text-[clamp(0.65rem,2vw,0.875rem)] leading-snug text-marine/65 sm:block">
          Rayon de soleil à domicile — Montauban &amp; alentours
        </span>
      </span>
    </a>

    <div class="hidden min-w-0 flex-1 items-center justify-end gap-3 lg:flex xl:gap-4">
      <nav aria-label="Navigation principale" class="min-w-0">
        <ul
          class="flex flex-nowrap items-center justify-end gap-0.5 rounded-2xl border border-marine/10 bg-white/45 p-1 shadow-[inset_0_1px_0_rgba(255,255,255,0.65)] backdrop-blur-sm"
        >
          {
            links.map((l) => {
              const active = isActive(l.href);
              const shown = l.desktopLabel ?? l.label;
              return (
                <li>
                  <a
                    href={l.href}
                    title={l.label}
                    class:list={[
                      "block whitespace-nowrap rounded-xl px-3 py-2 text-[0.8125rem] font-semibold leading-tight tracking-tight ring-1 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-marine xl:px-3.5",
                      active
                        ? "bg-marine text-ivoire shadow-md ring-marine/40"
                        : "text-marine/88 ring-transparent hover:bg-sauge/35 hover:text-marine hover:ring-marine/10",
                    ]}
                    aria-current={active ? "page" : undefined}
                  >
                    {shown}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>

    <button
      type="button"
      id="nav-menu-toggle"
      class="mobile-nav-toggle relative z-[60] flex h-11 w-11 shrink-0 touch-manipulation items-center justify-center rounded-full border border-marine/20 bg-white/90 text-marine shadow-sm transition hover:border-marine/40 hover:bg-marine/5 active:scale-[0.97] active:bg-marine/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-marine lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      aria-label="Ouvrir le menu de navigation"
    >
      <svg class="mobile-nav-toggle__icon h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          class="mobile-nav-toggle__bars"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        />
        <path
          class="mobile-nav-toggle__close hidden"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        />
      </svg>
    </button>
  </div>
</header>

<div
  id="mobile-nav-panel"
  class="mobile-nav fixed inset-0 z-[500] lg:hidden"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Menu de navigation"
  aria-hidden="true"
>
  <div id="nav-menu-backdrop" class="mobile-nav__backdrop absolute inset-0 touch-manipulation" role="presentation"></div>

  <div
    id="mobile-nav-sheet"
    class="mobile-nav__sheet relative z-10 ml-auto flex h-full max-h-[100dvh] w-full flex-col overflow-hidden bg-ivoire shadow-[-16px_0_48px_rgba(29,53,87,0.2)]"
  >
    <div class="mobile-nav__header relative flex shrink-0 items-center justify-between gap-3 border-b border-marine/10 bg-gradient-to-br from-sauge/25 via-ivoire to-rose-vieux/15 px-[max(1rem,env(safe-area-inset-left))] py-4 sm:px-5">
      <span class="pointer-events-none absolute -right-6 -top-8 h-24 w-24 rounded-full bg-aquarelle-jaune/25 blur-2xl" aria-hidden="true"></span>
      <div class="min-w-0">
        <p class="font-display text-[clamp(1.35rem,4vw,1.75rem)] text-marine">Menu</p>
        <p class="mt-0.5 truncate text-xs text-marine/60 sm:text-sm">Navigation &amp; accès rapides</p>
      </div>
      <button
        type="button"
        id="nav-menu-close"
        class="flex h-11 w-11 shrink-0 touch-manipulation items-center justify-center rounded-xl border border-marine/15 bg-white text-marine shadow-sm transition hover:bg-marine/5 active:scale-[0.97] active:bg-marine/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-marine"
        aria-label="Fermer le menu"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav
      class="mobile-nav__scroll min-h-0 flex-1 overflow-y-auto overscroll-contain px-[max(1rem,env(safe-area-inset-left))] py-4 sm:px-5 [-webkit-overflow-scrolling:touch]"
      aria-label="Navigation principale"
    >
      <ul class="mobile-nav__grid grid grid-cols-1 gap-2 xs:grid-cols-2 md:grid-cols-2 md:gap-2.5">
        {
          links.map((l) => {
            const active = isActive(l.href);
            return (
              <li class:list={[l.href === "/contact" && "xs:col-span-2 md:col-span-2"]}>
                <a
                  href={l.href}
                  data-mobile-nav-link
                  title={l.label}
                  class:list={[
                    "mobile-nav__link group flex min-h-[3.25rem] touch-manipulation items-center gap-3 rounded-2xl px-3.5 py-3 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-marine active:scale-[0.98] sm:min-h-[3.5rem] sm:px-4",
                    active
                      ? "bg-marine text-ivoire shadow-md"
                      : "border border-marine/10 bg-white/90 text-marine shadow-sm hover:border-marine/20 hover:bg-white",
                    l.href === "/contact" &&
                      !active &&
                      "border-marine/25 bg-gradient-to-r from-marine/8 to-sauge/15 font-semibold",
                  ]}
                  aria-current={active ? "page" : undefined}
                >
                  <span
                    class:list={[
                      "mobile-nav__icon flex h-9 w-9 shrink-0 items-center justify-center rounded-xl",
                      active ? "bg-white/15" : "bg-sauge/20 text-marine/85 group-hover:bg-sauge/30",
                    ]}
                    aria-hidden="true"
                  >
                    {
                      l.icon === "home" && (
                        <svg class="h-[1.125rem] w-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M3 10.5L12 3l9 7.5V20a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1v-9.5z" stroke-linejoin="round" />
                        </svg>
                      )
                    }
                    {
                      l.icon === "heart" && (
                        <svg class="h-[1.125rem] w-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M12 20s-7-4.5-9.5-9A5.5 5.5 0 0112 6a5.5 5.5 0 019.5 5c-2.5 4.5-9.5 9-9.5 9z" stroke-linejoin="round" />
                        </svg>
                      )
                    }
                    {
                      l.icon === "tag" && (
                        <svg class="h-[1.125rem] w-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M20 12l-8 8-9-9V3h8l9 9z" stroke-linejoin="round" /><circle cx="7.5" cy="7.5" r="1.5" fill="currentColor" />
                        </svg>
                      )
                    }
                    {
                      l.icon === "book" && (
                        <svg class="h-[1.125rem] w-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M5 4h9a3 3 0 013 3v14a2.5 2.5 0 00-2.5-2.5H5V4z" stroke-linejoin="round" />
                          <path d="M5 4v14h9.5A2.5 2.5 0 0017 15.5V7a3 3 0 00-3-3H5z" stroke-linejoin="round" />
                        </svg>
                      )
                    }
                    {
                      l.icon === "slides" && (
                        <svg class="h-[1.125rem] w-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="3" y="4" width="18" height="13" rx="1.5" /><path d="M8 20h8M12 17v3" stroke-linecap="round" />
                          <path d="M7 9h10M7 12h6" stroke-linecap="round" />
                        </svg>
                      )
                    }
                    {
                      l.icon === "users" && (
                        <svg class="h-[1.125rem] w-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M16 11a3 3 0 100-6 3 3 0 000 6zM8 13a3 3 0 100-6 3 3 0 000 6zM2 20a6 6 0 0112 0M14 20a5 5 0 0110 0" stroke-linecap="round" />
                        </svg>
                      )
                    }
                    {
                      l.icon === "user" && (
                        <svg class="h-[1.125rem] w-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="8" r="3.5" /><path d="M5 20a7 7 0 0114 0" stroke-linecap="round" />
                        </svg>
                      )
                    }
                    {
                      l.icon === "mail" && (
                        <svg class="h-[1.125rem] w-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" stroke-linejoin="round" />
                        </svg>
                      )
                    }
                    {
                      l.icon === "doc" && (
                        <svg class="h-[1.125rem] w-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M8 3h6l4 4v14H8V3z" stroke-linejoin="round" /><path d="M14 3v4h4M10 13h6M10 17h4" stroke-linecap="round" />
                        </svg>
                      )
                    }
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-[0.9375rem] font-semibold leading-tight sm:text-base">{l.shortLabel}</span>
                    <span
                      class:list={[
                        "mt-0.5 hidden truncate text-xs leading-snug sm:block",
                        active ? "text-ivoire/75" : "text-marine/55",
                      ]}
                    >
                      {l.label}
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="mt-6 border-t border-marine/10 pt-5">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-marine/55">Accès rapides</p>
        <div class="flex flex-wrap gap-2">
          {
            secondaryLinks.map((link) => (
              <a
                href={link.href}
                data-mobile-nav-link
                class="inline-flex min-h-[2.75rem] touch-manipulation items-center rounded-full border border-marine/15 bg-white px-4 py-2 text-sm font-medium text-marine/85 transition hover:border-marine/30 hover:text-marine active:scale-[0.98]"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <div
      class="mobile-nav__footer shrink-0 border-t border-marine/10 bg-white/80 px-[max(1rem,env(safe-area-inset-left))] py-4 backdrop-blur-sm sm:px-5"
      style="padding-bottom: max(1rem, env(safe-area-inset-bottom));"
    >
      <a
        href="/contact#formulaire"
        data-mobile-nav-link
        class="flex min-h-[3.25rem] w-full touch-manipulation items-center justify-center rounded-xl bg-marine px-4 py-3 text-center text-base font-semibold text-ivoire shadow-md transition hover:bg-marine/90 active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-marine"
      >
        Demander un contact
      </a>
    </div>
  </div>
</div>

<style>
  /* xs breakpoint (~360px) for tiny phones in 2-col grid */
  @media (min-width: 360px) {
    :global(.xs\:grid-cols-2) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    :global(.xs\:col-span-2) {
      grid-column: span 2 / span 2;
    }
    :global(.xs\:inline-flex) {
      display: inline-flex;
    }
  }

  .mobile-nav[hidden] {
    display: none !important;
  }

  .mobile-nav:not([hidden]) {
    display: block;
  }

  .mobile-nav__backdrop {
    background: rgba(29, 53, 87, 0.42);
    opacity: 0;
    transition: opacity 0.28s ease;
  }

  .mobile-nav.is-open .mobile-nav__backdrop {
    opacity: 1;
  }

  .mobile-nav__sheet {
    max-width: 100%;
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
    padding-top: env(safe-area-inset-top);
  }

  .mobile-nav.is-open .mobile-nav__sheet {
    transform: translateX(0);
  }

  @media (min-width: 480px) {
    .mobile-nav__sheet {
      max-width: min(100%, 22rem);
    }
  }

  @media (min-width: 640px) {
    .mobile-nav__sheet {
      max-width: min(100%, 26rem);
    }
  }

  @media (min-width: 768px) {
    .mobile-nav__sheet {
      max-width: min(100%, 32rem);
      border-top-left-radius: 1.25rem;
      border-bottom-left-radius: 1.25rem;
      margin-top: 0.75rem;
      margin-bottom: 0.75rem;
      max-height: calc(100dvh - 1.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav__backdrop,
    .mobile-nav__sheet {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    function ready(fn) {
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", fn);
      else fn();
    }

    ready(function () {
      var toggle = document.getElementById("nav-menu-toggle");
      var panel = document.getElementById("mobile-nav-panel");
      var backdrop = document.getElementById("nav-menu-backdrop");
      var closeBtn = document.getElementById("nav-menu-close");
      var iconBars = toggle && toggle.querySelector(".mobile-nav-toggle__bars");
      var iconClose = toggle && toggle.querySelector(".mobile-nav-toggle__close");
      if (!toggle || !panel || !backdrop || !closeBtn) return;

      var previousFocus = null;
      var focusableSelector =
        'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])';

      function isLargeViewport() {
        return window.matchMedia("(min-width: 1024px)").matches;
      }

      function getFocusables() {
        return Array.prototype.slice.call(panel.querySelectorAll(focusableSelector)).filter(function (el) {
          return el.offsetParent !== null || el === closeBtn;
        });
      }

      function unlockBodyScroll() {
        document.body.style.position = "";
        document.body.style.top = "";
        document.body.style.left = "";
        document.body.style.right = "";
        document.body.style.width = "";
        delete document.body.dataset.scrollLock;
        document.documentElement.style.overflow = "";
      }

      function setOpen(open) {
        if (isLargeViewport()) open = false;

        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        toggle.setAttribute(
          "aria-label",
          open ? "Fermer le menu de navigation" : "Ouvrir le menu de navigation",
        );

        if (open) {
          panel.removeAttribute("hidden");
          panel.removeAttribute("aria-hidden");
          requestAnimationFrame(function () {
            panel.classList.add("is-open");
          });

          var sy = window.scrollY || window.pageYOffset || 0;
          document.body.dataset.scrollLock = String(sy);
          document.body.style.position = "fixed";
          document.body.style.top = "-" + sy + "px";
          document.body.style.left = "0";
          document.body.style.right = "0";
          document.body.style.width = "100%";
          document.documentElement.style.overflow = "hidden";

          if (iconBars) iconBars.classList.add("hidden");
          if (iconClose) iconClose.classList.remove("hidden");

          previousFocus = document.activeElement;
          requestAnimationFrame(function () {
            closeBtn.focus();
          });
        } else {
          panel.classList.remove("is-open");
          panel.setAttribute("aria-hidden", "true");

          var savedScroll = document.body.dataset.scrollLock;
          unlockBodyScroll();

          if (iconBars) iconBars.classList.remove("hidden");
          if (iconClose) iconClose.classList.add("hidden");

          window.setTimeout(function () {
            if (!panel.classList.contains("is-open")) {
              panel.setAttribute("hidden", "");
            }
          }, 320);

          if (savedScroll !== undefined && savedScroll !== "") {
            var y = parseInt(savedScroll, 10);
            if (!isNaN(y)) window.scrollTo(0, y);
          }

          if (previousFocus && typeof previousFocus.focus === "function") {
            try {
              previousFocus.focus();
            } catch (e) {}
            previousFocus = null;
          }
        }
      }

      function close() {
        setOpen(false);
      }

      toggle.addEventListener(
        "click",
        function (e) {
          e.preventDefault();
          e.stopPropagation();
          var expanded = toggle.getAttribute("aria-expanded") === "true";
          setOpen(!expanded);
        },
        { passive: false },
      );

      closeBtn.addEventListener("click", function (e) {
        e.preventDefault();
        close();
      });

      backdrop.addEventListener(
        "click",
        function () {
          close();
        },
        { passive: true },
      );

      document.querySelectorAll("[data-mobile-nav-link]").forEach(function (link) {
        link.addEventListener("click", close);
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
          e.preventDefault();
          close();
          return;
        }

        if (e.key !== "Tab" || toggle.getAttribute("aria-expanded") !== "true") return;

        var focusables = getFocusables();
        if (!focusables.length) return;

        var first = focusables[0];
        var last = focusables[focusables.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });

      window.addEventListener(
        "resize",
        function () {
          if (isLargeViewport()) close();
        },
        { passive: true },
      );

      window.addEventListener("pageshow", unlockBodyScroll);
    });
  })();
</script>
