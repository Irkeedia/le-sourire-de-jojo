---
/** En-tête du site public : barre d'infos, logo, menu à 5 entrées, espace familles, appel à l'action. */
import { LOGO_SRC } from "@/lib/brand";
import { isDbConfigured } from "@/lib/db-config";

const user = Astro.locals.user;
/** L'espace familles n'apparaît qu'une fois la base de données branchée. */
const showFamilySpace = Boolean(user) || isDbConfigured();
const familyHref = user ? "/compte" : "/compte/connexion";
const familyLabel = user ? "Mon espace" : "Espace familles";

const links = [
  { href: "/", label: "Accueil", hint: "L’essentiel en un coup d’œil" },
  { href: "/services", label: "Services", hint: "Pôles d’activités, carnet de sourires" },
  { href: "/offres", label: "Tarifs & aides", hint: "Formules, simulateur, crédit d’impôt" },
  { href: "/a-propos", label: "À propos", hint: "Mon histoire, la zone, vos questions" },
  { href: "/contact", label: "Contact", hint: "Visite d’évaluation offerte" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(href + "/"));
---

<div class="topbar">
  <div class="wrap topbar__inner">
    <div class="topbar__group">
      <span class="topbar__news"><span class="dot" aria-hidden="true"></span>Ouverture le 2 janvier 2027</span>
      <span class="sep topbar__hide-sm" aria-hidden="true"></span>
      <span class="topbar__hide-sm">Corbarieu · Montauban · Tarn-et-Garonne (82)</span>
    </div>
    <div class="topbar__group topbar__hide-sm">
      <span>Service à la personne · crédit d’impôt sous conditions</span>
      <span class="sep" aria-hidden="true"></span>
      <a href="tel:+33666309622">06 66 30 96 22</a>
    </div>
  </div>
</div>

<header class="header">
  <div class="wrap header__inner">
    <a class="brand" href="/" aria-label="Le Sourire de Jojo, accueil">
      <span class="brand__mark"><img src={LOGO_SRC} alt="" width="46" height="46" /></span>
      <span class="brand__text">
        <span class="brand__name">Le Sourire de Jojo</span>
        <span class="brand__tag">Dame de compagnie à domicile</span>
      </span>
    </a>
    <nav class="nav" aria-label="Navigation principale">
      {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}</a>)}
    </nav>
    <div class="header__actions">
      {
        showFamilySpace && (
          <a class="header__account" href={familyHref}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>
            {familyLabel}
          </a>
        )
      }
      <a class="btn btn--primary btn--sm" href="/contact#formulaire">Visite offerte</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-mobile" aria-label="Ouvrir le menu" data-menu-btn>
        <span class="menu-btn__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="mnav" id="menu-mobile" data-mobile-nav hidden>
  <div class="mnav__scrim" data-menu-close></div>
  <nav class="mnav__sheet" aria-label="Menu">
    <ul class="mnav__list">
      {
        links.map((l, i) => (
          <li style={`--i: ${i}`}>
            <a class="mnav__link" href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>
              <span class="mnav__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="mnav__text">
                <span class="mnav__label">{l.label}</span>
                <span class="mnav__hint">{l.hint}</span>
              </span>
              <svg class="mnav__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mnav__actions" style={`--i: ${links.length}`}>
      <a class="btn btn--primary" href="/contact#formulaire">
        Visite offerte
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a class="btn btn--secondary" href="tel:+33666309622">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg>
        Appeler
      </a>
    </div>

    {
      showFamilySpace && (
        <a class="mnav__family" href={familyHref} style={`--i: ${links.length + 1}`}>
          <span class="mnav__family-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg></span>
          <span><strong>{familyLabel}</strong><span class="mnav__hint">Carnet, agenda et messages en ligne</span></span>
          <svg class="mnav__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </a>
      )
    }

    <p class="mnav__foot" style={`--i: ${links.length + 2}`}>
      <span class="dot" aria-hidden="true"></span>Ouverture le 2 janvier 2027 · Corbarieu, Montauban &amp; alentours
    </p>
  </nav>
</div>
