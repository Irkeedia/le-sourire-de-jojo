---
/**
 * Formulaire de contact simplifié : l'essentiel d'abord (qui, comment vous joindre,
 * votre besoin), les précisions facultatives repliées. Même API et mêmes champs
 * qu'avant (/api/contact) : rien ne change côté réception.
 */
import { PACK_IDS, PACK_LABELS, type PackId } from "@/lib/packs";
import { CRENEAU_LABELS, HORIZON_LABELS, ZONE_IDS, ZONE_LABELS } from "@/lib/contact-form-options";

interface Props {
  initialPack?: string;
  defaultSubject?: string;
}

const { initialPack = "", defaultSubject = "" } = Astro.props;
const safePack = PACK_IDS.includes(initialPack as PackId) ? (initialPack as PackId) : "";
const subjectValue =
  defaultSubject || (safePack ? `Demande — ${PACK_LABELS[safePack]}` : "Demande de visite d’évaluation");

const situations = [
  { id: "senior_autonome", label: "Senior autonome" },
  { id: "convalescence", label: "Convalescence" },
  { id: "parent_solo", label: "Parent solo" },
  { id: "autre_situation", label: "Autre" },
];
const creneaux = ["matin", "apres_midi", "flexible"] as const;
const horizons = ["semaine_courante", "deux_semaines", "souple"] as const;
---

<form id="contact-form" class="cform" novalidate>
  <input type="text" name="website" class="cform__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="hidden" name="subject" value={subjectValue} />
  <input type="hidden" name="pack" value={safePack} />

  <div class="cform__head">
    <img src="/images/mascotte/agenda.webp" alt="" width="72" height="72" loading="lazy" />
    <div>
      <h2 class="h3">Demande de visite offerte</h2>
      <p class="small muted">Une minute suffit. Céline vous rappelle pour convenir d’un moment.</p>
    </div>
  </div>

  {safePack && (
    <p class="cform__pack">
      Formule choisie : <strong>{PACK_LABELS[safePack]}</strong>
      <a href="/contact#formulaire" class="link small">changer</a>
    </p>
  )}

  <fieldset class="cform__group">
    <legend>C’est pour…</legend>
    <div class="pills">
      <label class="pill"><input type="radio" name="relation" value="personne_concernee" checked /><span>Moi</span></label>
      <label class="pill"><input type="radio" name="relation" value="proche_famille" /><span>Un proche</span></label>
    </div>
    <div class="pills">
      {situations.map((s) => (
        <label class="pill"><input type="radio" name="audience" value={s.id} /><span>{s.label}</span></label>
      ))}
    </div>
  </fieldset>

  <div class="field">
    <label for="cf-name">Nom et prénom</label>
    <input id="cf-name" name="name" class="input" type="text" autocomplete="name" required maxlength="120" />
    <p class="cform__err" data-error-for="name" hidden></p>
  </div>

  <div class="form__row">
    <div class="field">
      <label for="cf-phone">Téléphone</label>
      <input id="cf-phone" name="phone" class="input" type="tel" inputmode="tel" autocomplete="tel" maxlength="40" placeholder="06 12 34 56 78" />
      <p class="cform__err" data-error-for="phone" hidden></p>
    </div>
    <div class="field">
      <label for="cf-email">E-mail <span class="hint">(ou téléphone)</span></label>
      <input id="cf-email" name="email" class="input" type="email" inputmode="email" autocomplete="email" maxlength="254" />
      <p class="cform__err" data-error-for="email" hidden></p>
    </div>
  </div>

  <div class="field">
    <label for="cf-zone">Commune</label>
    <select id="cf-zone" name="zone" class="select">
      <option value="">Choisir…</option>
      {ZONE_IDS.map((id) => <option value={id}>{ZONE_LABELS[id]}</option>)}
    </select>
  </div>

  <div class="field">
    <label for="cf-message">Votre besoin en quelques mots</label>
    <textarea id="cf-message" name="message" class="textarea cform__msg" rows="3" maxlength="8000" required placeholder="Ex. : de la compagnie pour ma mère deux après-midi par semaine."></textarea>
    <p class="cform__err" data-error-for="message" hidden></p>
  </div>

  <details class="cform__more">
    <summary><span>Préciser davantage <span class="hint">(facultatif)</span></span></summary>
    <div class="cform__more-body">
      <fieldset class="cform__group">
        <legend>Moment préféré</legend>
        <div class="pills">
          {creneaux.map((c) => <label class="pill"><input type="radio" name="creneau" value={c} /><span>{CRENEAU_LABELS[c]}</span></label>)}
        </div>
      </fieldset>
      <fieldset class="cform__group">
        <legend>Pour quand ?</legend>
        <div class="pills">
          {horizons.map((h) => <label class="pill"><input type="radio" name="horizon" value={h} /><span>{HORIZON_LABELS[h]}</span></label>)}
        </div>
      </fieldset>
      <div class="field">
        <label for="cf-deglutition">Risque de fausse route, régime particulier</label>
        <textarea id="cf-deglutition" name="deglutition_risk_alert" class="textarea" rows="2" maxlength="2000"></textarea>
      </div>
      <div class="field">
        <label for="cf-medical-cert">Date du dernier certificat d’aptitude aux loisirs</label>
        <input id="cf-medical-cert" name="medical_cert_date" class="input" type="date" />
        <p class="cform__err" data-error-for="medical_cert_date" hidden></p>
      </div>
    </div>
  </details>

  <div class="cform__checks">
    <label class="consent">
      <input id="cf-legal-capacity" name="legal_capacity_status" type="checkbox" value="true" />
      <span>Je peux signer un contrat (pleine capacité juridique) ou j’agis comme représentant légal (tutelle, curatelle…). <small class="muted">Art. 1145 C. civ.</small></span>
    </label>
    <p class="cform__err" data-error-for="legal_capacity_status" hidden></p>
    <label class="consent">
      <input id="cf-emergency-protocol" name="emergency_protocol_acknowledged" type="checkbox" value="true" />
      <span>En cas d’urgence vitale, j’appelle d’abord les secours (15, 18, 112 ou 114). <small class="muted">Art. 223-6 C. pén.</small></span>
    </label>
    <p class="cform__err" data-error-for="emergency_protocol_acknowledged" hidden></p>
  </div>

  <button type="submit" class="btn btn--primary btn--lg cform__submit">
    Envoyer ma demande
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  </button>
  <p id="cf-status" class="cform__status" role="status" aria-live="polite"></p>
  <p class="xs muted">Vos données servent uniquement à vous répondre (RGPD). Pas de revente, pas de prospection.</p>
</form>

<div class="cform-done" id="contact-done" hidden>
  <img src="/images/mascotte/joie.webp" alt="" width="140" height="140" loading="lazy" />
  <h2 class="h3">Demande bien envoyée !</h2>
  <p class="muted">Merci. Céline vous recontacte très vite pour convenir de la visite d’évaluation offerte.</p>
  <a class="btn btn--secondary" href="/">Retour à l’accueil</a>
</div>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("cf-status");
  const done = document.getElementById("contact-done");

  const showErrors = (errors: Record<string, string[] | undefined>) => {
    form?.querySelectorAll<HTMLElement>("[data-error-for]").forEach((el) => {
      el.hidden = true;
      el.textContent = "";
    });
    let first: HTMLElement | null = null;
    for (const [key, msgs] of Object.entries(errors)) {
      const target = form?.querySelector<HTMLElement>(`[data-error-for="${key}"]`);
      if (target && msgs?.[0]) {
        target.hidden = false;
        target.textContent = msgs[0];
        first ??= target;
      }
    }
    if (first) {
      if (first.closest("details")) (first.closest("details") as HTMLDetailsElement).open = true;
      first.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status) return;
    const fd = new FormData(form);
    const get = (k: string) => String(fd.get(k) ?? "").trim();
    const btn = form.querySelector<HTMLButtonElement>(".cform__submit");

    // Vérifications immédiates, sans attendre le serveur
    const local: Record<string, string[]> = {};
    if (get("name").length < 2) local.name = ["Indiquez votre nom."];
    if (!get("phone") && !get("email")) local.phone = ["Un téléphone ou un e-mail, pour qu’on puisse vous répondre."];
    if (get("message").length < 3) local.message = ["Dites-nous en quelques mots ce dont vous avez besoin."];
    if (!(form.querySelector("#cf-legal-capacity") as HTMLInputElement).checked) local.legal_capacity_status = ["Case à cocher pour envoyer la demande."];
    if (!(form.querySelector("#cf-emergency-protocol") as HTMLInputElement).checked) local.emergency_protocol_acknowledged = ["Case à cocher pour envoyer la demande."];
    if (Object.keys(local).length) {
      showErrors(local);
      status.textContent = "";
      return;
    }

    const payload = {
      name: get("name"),
      email: get("email"),
      phone: get("phone"),
      audience: get("audience"),
      relation: get("relation"),
      zone: get("zone"),
      zone_detail: "",
      creneau: get("creneau"),
      horizon: get("horizon"),
      pack: get("pack"),
      subject: get("subject") || "Demande de visite d’évaluation",
      message: get("message"),
      website: get("website"),
      legal_capacity_status: true,
      emergency_protocol_acknowledged: true,
      medical_cert_date: get("medical_cert_date"),
      deglutition_risk_alert: get("deglutition_risk_alert"),
    };

    showErrors({});
    status.textContent = "Envoi en cours…";
    if (btn) btn.disabled = true;
    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (data.errors) showErrors(data.errors);
        status.textContent = data.error ?? "Une erreur est survenue. Vous pouvez aussi appeler le 06 66 30 96 22.";
        return;
      }
      status.textContent = "";
      form.hidden = true;
      if (done) {
        done.hidden = false;
        done.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    } catch {
      status.textContent = "Erreur réseau. Réessayez dans un instant ou appelez le 06 66 30 96 22.";
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
