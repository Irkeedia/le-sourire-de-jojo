---
import { LOGO_SRC } from "@/lib/brand";
import { isDbConfigured } from "@/lib/db-config";
const showFamilySpace = Boolean(Astro.locals.user) || isDbConfigured();
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__top">
    <div class="footer__brand">
      <a class="brand" href="/">
        <span class="brand__mark"><img src={LOGO_SRC} alt="" width="46" height="46" loading="lazy" /></span>
        <span class="brand__text"><span class="brand__name">Le Sourire de Jojo</span></span>
      </a>
      <p>Accompagnement social et bienveillant à domicile, au départ de Corbarieu. Présence, écoute &amp; sourires — sans soins médicaux.</p>
      <div class="footer__seals">
        <span>Service à la personne</span>
        <span>CESU préfinancés acceptés</span>
        <span>Avance immédiate URSSAF</span>
      </div>
    </div>
    <div>
      <h4>Le site</h4>
      <ul>
        <li><a href="/">Accueil</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/offres">Tarifs &amp; aides</a></li>
        <li><a href="/a-propos">À propos</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
    <div>
      <h4>Raccourcis</h4>
      <ul>
        <li><a href="/services#carnet">Le carnet de sourires</a></li>
        <li><a href="/offres#aides">Aides &amp; financement</a></li>
        <li><a href="/a-propos#partenaires">Partenaires de confiance</a></li>
        {showFamilySpace && <li><a href="/compte/connexion">Espace familles</a></li>}
      </ul>
    </div>
    <div>
      <h4>Informations légales</h4>
      <ul>
        <li><a href="/informations-legales#mentions">Mentions légales &amp; RGPD</a></li>
        <li><a href="/informations-legales#cgv">Conditions générales de vente</a></li>
        <li><a href="/informations-legales#annulation">Annulation &amp; résiliation</a></li>
        <li><a href="/informations-legales#consentement">Consentement</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer__bottom">
    <span>© {year} Le Sourire de Jojo — Céline Meunier Ben Neji, micro-entreprise · SIRET en cours d’attribution</span>
    <span>Site réalisé par Irkeedia Labs</span>
  </div>
</footer>
