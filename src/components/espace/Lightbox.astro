---
/**
 * Visionneuse plein écran : flèches précédente / suivante, glisser du doigt, touches du clavier.
 * Les boutons déclencheurs portent data-lightbox="nom-du-groupe" et data-src="/api/photos/…".
 */
---

<dialog
  id="lightbox"
  class="m-0 h-[100dvh] max-h-none w-screen max-w-none bg-marine p-0 text-ivoire backdrop:bg-marine"
  aria-label="Photo agrandie"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between px-4 py-3">
      <p id="lightbox-count" class="text-base font-medium" aria-live="polite"></p>
      <button
        type="button"
        id="lightbox-close"
        class="min-h-[48px] rounded-full bg-ivoire px-6 text-base font-semibold text-marine"
      >
        Fermer
      </button>
    </div>
    <div class="relative flex min-h-0 flex-1 items-center justify-center px-2" id="lightbox-stage">
      <img id="lightbox-img" alt="" class="max-h-full max-w-full rounded-lg object-contain" />
    </div>
    <div class="flex items-center justify-center gap-4 px-4 py-4">
      <button type="button" id="lightbox-prev" class="min-h-[56px] min-w-[8rem] rounded-full border-2 border-ivoire/40 px-5 text-base font-semibold hover:bg-ivoire/10">
        ← Précédente
      </button>
      <button type="button" id="lightbox-next" class="min-h-[56px] min-w-[8rem] rounded-full border-2 border-ivoire/40 px-5 text-base font-semibold hover:bg-ivoire/10">
        Suivante →
      </button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
  const img = document.getElementById("lightbox-img") as HTMLImageElement | null;
  const count = document.getElementById("lightbox-count");
  const prev = document.getElementById("lightbox-prev") as HTMLButtonElement | null;
  const next = document.getElementById("lightbox-next") as HTMLButtonElement | null;
  let items: HTMLElement[] = [];
  let index = 0;

  function show(i: number) {
    if (!img || !count || !prev || !next) return;
    index = (i + items.length) % items.length;
    const item = items[index];
    img.src = item.dataset.src ?? "";
    img.alt = item.dataset.alt ?? "Photo";
    count.textContent = items.length > 1 ? `Photo ${index + 1} sur ${items.length}` : "";
    prev.hidden = next.hidden = items.length < 2;
  }

  document.querySelectorAll<HTMLElement>("[data-lightbox]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const group = trigger.dataset.lightbox;
      items = Array.from(document.querySelectorAll<HTMLElement>(`[data-lightbox="${group}"]`));
      show(items.indexOf(trigger));
      dialog?.showModal();
    });
  });

  prev?.addEventListener("click", () => show(index - 1));
  next?.addEventListener("click", () => show(index + 1));
  document.getElementById("lightbox-close")?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") show(index - 1);
    if (e.key === "ArrowRight") show(index + 1);
  });
  dialog?.addEventListener("close", () => {
    if (img) img.src = "";
  });

  let startX = 0;
  const stage = document.getElementById("lightbox-stage");
  stage?.addEventListener("touchstart", (e) => (startX = e.touches[0].clientX), { passive: true });
  stage?.addEventListener(
    "touchend",
    (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50 && items.length > 1) show(index + (dx < 0 ? 1 : -1));
    },
    { passive: true },
  );
</script>
