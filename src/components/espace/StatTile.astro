---
import Icon from "@/components/espace/Icon.astro";
import type { IconName } from "@/lib/espace-types";

/** Tuile de statistique douce : pastille d'icône en léger relief, grand chiffre, phrase simple. */
interface Props {
  href: string;
  label: string;
  value: string;
  sub: string;
  icon: IconName;
  tone: "sauge" | "peche" | "jaune" | "bleu";
  /** Met la tuile en avant (ex. messages non lus). */
  alert?: boolean;
}
const { href, label, value, sub, icon, tone, alert = false } = Astro.props;
const tones = {
  sauge: { card: "bg-[#E4ECE2]", pill: "bg-[#8FA892]" },
  peche: { card: "bg-[#F7E1D7]", pill: "bg-[#D99A8C]" },
  jaune: { card: "bg-[#F8EDCF]", pill: "bg-[#E2B85A]" },
  bleu: { card: "bg-[#E1EAF1]", pill: "bg-[#6E98B5]" },
};
---

<a
  href={href}
  class:list={[
    "group flex min-h-[9.5rem] flex-col rounded-[26px] p-4 shadow-[0_12px_28px_rgba(29,53,87,0.08),inset_0_1px_0_rgba(255,255,255,0.8),inset_0_-4px_0_rgba(29,53,87,0.04)] transition hover:-translate-y-0.5 hover:shadow-[0_18px_36px_rgba(29,53,87,0.12)] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-marine sm:p-5",
    tones[tone].card,
    alert && "ring-2 ring-rose-vieux/60",
  ]}
>
  <span
    class:list={[
      "flex h-12 w-12 items-center justify-center rounded-2xl text-white shadow-[0_8px_16px_rgba(29,53,87,0.15),inset_0_2px_0_rgba(255,255,255,0.35),inset_0_-4px_0_rgba(0,0,0,0.12)]",
      tones[tone].pill,
    ]}
  >
    <Icon name={icon} class="h-6 w-6" />
  </span>
  <span class="mt-3 text-base font-semibold text-marine/80">{label}</span>
  <span class="font-hero text-[1.7rem] font-bold leading-tight text-marine sm:text-3xl">{value}</span>
  <span class="mt-auto pt-1 text-sm font-medium text-marine/70">{sub}</span>
</a>
