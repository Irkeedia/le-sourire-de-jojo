---
import Icon from "@/components/espace/Icon.astro";

/** Grande tuile cliquable du tableau de bord d'un dossier. */
interface Props {
  href: string;
  icon: "carnet" | "messages" | "album" | "agenda" | "documents" | "proches";
  title: string;
  /** Ligne d'information principale (ex. « Prochaine visite : jeudi 12 à 14 h »). */
  info: string;
  /** Ligne secondaire, plus discrète. */
  detail?: string;
  /** Pastille (ex. nombre de messages non lus). */
  badge?: number;
  badgeLabel?: string;
  tone: "rose" | "bleu" | "jaune" | "sauge" | "marine";
}
const { href, icon, title, info, detail, badge, badgeLabel, tone } = Astro.props;

const tones = {
  rose: "bg-rose-vieux/15 text-rose-vieux",
  bleu: "bg-aquarelle-bleu/15 text-aquarelle-bleu",
  jaune: "bg-aquarelle-jaune/25 text-[#a07a1f]",
  sauge: "bg-sauge/20 text-[#5d7a61]",
  marine: "bg-marine/10 text-marine",
};
---

<a
  href={href}
  class="group relative flex min-h-[7.5rem] items-start gap-4 rounded-3xl border border-marine/10 bg-white p-5 shadow-[0_10px_30px_rgba(29,53,87,0.07)] transition duration-200 hover:-translate-y-0.5 hover:border-marine/20 hover:shadow-[0_16px_40px_rgba(29,53,87,0.12)] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-marine sm:min-h-[12.5rem] sm:flex-col sm:p-6"
>
  <span class:list={["flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl", tones[tone]]}>
    <Icon name={icon} class="h-7 w-7" />
  </span>
  <span class="min-w-0 flex-1">
    <span class="flex items-center gap-2">
      <span class="font-hero text-xl font-semibold text-marine">{title}</span>
      {
        badge ? (
          <span
            class="inline-flex min-w-[1.6rem] items-center justify-center rounded-full bg-rose-vieux px-2 py-0.5 text-sm font-bold text-white"
            aria-label={badgeLabel ?? `${badge} nouveau${badge > 1 ? "x" : ""}`}
          >
            {badge}
          </span>
        ) : null
      }
    </span>
    <span class="mt-1.5 block text-base leading-snug text-marine/85">{info}</span>
    {detail && <span class="mt-1 block text-sm leading-snug text-marine/60">{detail}</span>}
    <slot />
  </span>
  <span class="mt-1 text-marine/35 transition group-hover:translate-x-0.5 group-hover:text-marine/70 sm:absolute sm:right-5 sm:top-6" aria-hidden="true">
    <Icon name="chevron" class="h-6 w-6" />
  </span>
</a>
