---
import type { IconName } from "@/lib/espace-types";

/** Icônes au trait de l'espace familles (24 × 24, couleur du texte). */
interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = "h-6 w-6" } = Astro.props;
const filled = name === "more";
---

<svg class={className} viewBox="0 0 24 24" fill={filled ? "currentColor" : "none"} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "carnet" && (<><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H18v15H6.5A1.5 1.5 0 0 0 5 19.5v-15Z" /><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H18v-3" /><path d="M11.5 8.2c.6-1 2.6-1 2.9.4.3 1.5-2.4 3.1-2.9 3.4-.5-.3-3.2-1.9-2.9-3.4.3-1.4 2.3-1.4 2.9-.4Z" /></>)}
  {name === "messages" && (<><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5v-8Z" /><path d="M8 9h8M8 12h5" /></>)}
  {name === "album" && (<><rect x="3" y="5" width="18" height="14" rx="2.5" /><circle cx="9" cy="10" r="1.7" /><path d="m4 17 5-4.5 3.5 3 3-2.5L20 17" /></>)}
  {name === "agenda" && (<><rect x="3.5" y="5" width="17" height="15" rx="2.5" /><path d="M3.5 9.5h17M8 3v4M16 3v4" /><path d="M8 13.5h3v3H8z" /></>)}
  {name === "documents" && (<><path d="M14 3H7.5A1.5 1.5 0 0 0 6 4.5v15A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V7l-4-4Z" /><path d="M14 3v4h4M9 12h6M9 15.5h6" /></>)}
  {name === "proches" && (<><circle cx="9" cy="8" r="3" /><path d="M3.5 19.5v-1a4.5 4.5 0 0 1 4.5-4.5h2a4.5 4.5 0 0 1 4.5 4.5v1" /><circle cx="17" cy="9.5" r="2.3" /><path d="M16.5 14h.5a3.5 3.5 0 0 1 3.5 3.5v1" /></>)}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "chevron" && <path d="m9 6 6 6-6 6" />}
  {name === "back" && <path d="m15 6-6 6 6 6" />}
  {name === "download" && (<><path d="M12 4v11M7.5 10.5 12 15l4.5-4.5" /><path d="M5 19h14" /></>)}
  {name === "trash" && (<><path d="M4.5 7h15M10 11v6M14 11v6" /><path d="M6.5 7l1 12.5A1.5 1.5 0 0 0 9 21h6a1.5 1.5 0 0 0 1.5-1.5L17.5 7M9.5 7V4.5h5V7" /></>)}
  {name === "heart" && <path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z" />}
  {name === "home" && (<><path d="M4 10.5 12 4l8 6.5" /><path d="M6 9v10.5h4.5V14h3v5.5H18V9" /></>)}
  {name === "user" && (<><circle cx="12" cy="8" r="3.5" /><path d="M5 20a7 7 0 0 1 14 0" /></>)}
  {name === "bell" && (<><path d="M6.5 16.5V11a5.5 5.5 0 0 1 11 0v5.5l1.5 1.5H5l1.5-1.5Z" /><path d="M10 20.5a2 2 0 0 0 4 0" /></>)}
  {name === "logout" && (<><path d="M14 4h4.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H14" /><path d="M10 16.5 5.5 12 10 7.5M5.5 12H15" /></>)}
  {name === "site" && (<><circle cx="12" cy="12" r="8.5" /><path d="M3.5 12h17M12 3.5c2.3 2.4 3.5 5.2 3.5 8.5s-1.2 6.1-3.5 8.5c-2.3-2.4-3.5-5.2-3.5-8.5S9.7 5.9 12 3.5Z" /></>)}
  {name === "more" && (<><circle cx="5.5" cy="12" r="1.4" /><circle cx="12" cy="12" r="1.4" /><circle cx="18.5" cy="12" r="1.4" /></>)}
  {name === "lock" && (<><rect x="5" y="10.5" width="14" height="10" rx="2.5" /><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5M12 14.5v2.5" /></>)}
  {name === "mail" && (<><rect x="3.5" y="5.5" width="17" height="13" rx="2.5" /><path d="m4.5 7 7.5 6 7.5-6" /></>)}
  {name === "eye" && (<><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" /><circle cx="12" cy="12" r="3" /></>)}
  {name === "eye-off" && (<><path d="M4 4l16 16" /><path d="M9.9 6A9.6 9.6 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a17 17 0 0 1-2.6 3.4M6.2 7.6A16.4 16.4 0 0 0 2.5 12S6 18.5 12 18.5a9.2 9.2 0 0 0 4.1-1" /><path d="M10 10a3 3 0 0 0 4 4" /></>)}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "sun" && (<><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" /></>)}
  {name === "key" && (<><circle cx="8" cy="15" r="4" /><path d="M11 12.5 19.5 4M16 7.5l2.5 2.5M14 9.5l2 2" /></>)}
  {name === "folders" && (<><path d="M3.5 8V6.5A1.5 1.5 0 0 1 5 5h4l2 2h8A1.5 1.5 0 0 1 20.5 8.5V18a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 18V8Z" /><path d="M3.5 10h17" /></>)}
</svg>
