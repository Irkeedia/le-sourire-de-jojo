---
/** Icônes au trait de l'espace familles (24 × 24, couleur du texte). */
interface Props {
  name: "carnet" | "messages" | "album" | "agenda" | "documents" | "proches" | "plus" | "chevron" | "back" | "download" | "trash" | "heart";
  class?: string;
}
const { name, class: className = "h-6 w-6" } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "carnet" && (<><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H18v15H6.5A1.5 1.5 0 0 0 5 19.5v-15Z" /><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H18v-3" /><path d="M11.5 8.2c.6-1 2.6-1 2.9.4.3 1.5-2.4 3.1-2.9 3.4-.5-.3-3.2-1.9-2.9-3.4.3-1.4 2.3-1.4 2.9-.4Z" /></>)}
  {name === "messages" && (<><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5v-8Z" /><path d="M8 9h8M8 12h5" /></>)}
  {name === "album" && (<><rect x="3" y="5" width="18" height="14" rx="2.5" /><circle cx="9" cy="10" r="1.7" /><path d="m4 17 5-4.5 3.5 3 3-2.5L20 17" /></>)}
  {name === "agenda" && (<><rect x="3.5" y="5" width="17" height="15" rx="2.5" /><path d="M3.5 9.5h17M8 3v4M16 3v4" /><path d="M8 13.5h3v3H8z" /></>)}
  {name === "documents" && (<><path d="M14 3H7.5A1.5 1.5 0 0 0 6 4.5v15A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V7l-4-4Z" /><path d="M14 3v4h4M9 12h6M9 15.5h6" /></>)}
  {name === "proches" && (<><circle cx="9" cy="8" r="3" /><path d="M3.5 19.5v-1a4.5 4.5 0 0 1 4.5-4.5h2a4.5 4.5 0 0 1 4.5 4.5v1" /><circle cx="17" cy="9.5" r="2.3" /><path d="M16.5 14h.5a3.5 3.5 0 0 1 3.5 3.5v1" /></>)}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "chevron" && <path d="m9 6 6 6-6 6" />}
  {name === "back" && <path d="m15 6-6 6 6 6" />}
  {name === "download" && (<><path d="M12 4v11M7.5 10.5 12 15l4.5-4.5" /><path d="M5 19h14" /></>)}
  {name === "trash" && (<><path d="M4.5 7h15M10 11v6M14 11v6" /><path d="M6.5 7l1 12.5A1.5 1.5 0 0 0 9 21h6a1.5 1.5 0 0 0 1.5-1.5L17.5 7M9.5 7V4.5h5V7" /></>)}
  {name === "heart" && <path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z" />}
</svg>
