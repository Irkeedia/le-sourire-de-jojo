---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MonRole from "@/components/MonRole.astro";
import { COMMUNES_ZONE } from "@/lib/catalogue";
import { absoluteUrl, buildFaqPage, HOME_FAQ, resolveSiteUrl } from "@/lib/seo";
import {
  FORFAIT_MENSUEL,
  PACK_DECOUVERTE,
  TARIF_HORAIRE_BRUT_EUR as H,
  TARIF_HORAIRE_NET_EUR as HN,
  tarifNetApresCredit as net,
} from "@/lib/tarif";

const title = "Le Sourire de Jojo — Dame de compagnie à domicile, Corbarieu et Montauban";
const description =
  "Accompagnement social et bienveillant à domicile par Céline Meunier Ben Neji : prévention du quotidien et préservation de l’autonomie pour les seniors autonomes, personnes temporairement immobilisées, parents solos. Corbarieu, Montauban et alentours (Tarn-et-Garonne).";
const HM = FORFAIT_MENSUEL.brutEur / FORFAIT_MENSUEL.heures;

const siteUrl = resolveSiteUrl(Astro.site?.href, Astro.url.origin);
const homeUrl = absoluteUrl("/", siteUrl);
---

<BaseLayout title={title} description={description} jsonLd={buildFaqPage(HOME_FAQ, homeUrl)}>
    <!-- ============ HERO ============ -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero__grid">
        <div class="hero__copy reveal">
          <span class="eyebrow">Dame de compagnie moderne · Corbarieu &amp; alentours</span>
          <h1 class="hero__title" id="hero-title">Présence, écoute <em>&amp;&nbsp;sourires</em>, chez vous.</h1>
          <p class="lead">
            Céline Meunier Ben Neji accompagne à domicile les seniors autonomes, les personnes temporairement immobilisées
            et les parents solos. Lien social, sorties, répit : le matériel est apporté, sans soins médicaux.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/contact#formulaire">
              Demander la visite offerte
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a class="btn btn--secondary" href="/offres">Tarifs &amp; aides</a>
          </div>
          <ul class="hero__trust">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg>Visite d’évaluation offerte</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>Service à la personne déclaré</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18"/></svg>Matériel apporté sur place</li>
          </ul>
        </div>

        <div class="hero__media reveal">
          <img class="hero__flower" src="/images/fleurs/3.webp" alt="" aria-hidden="true" />
          <div class="hero__photo">
            <img src="/images/personne-agee-1600.webp" srcset="/images/personne-agee-800.webp 800w, /images/personne-agee-1600.webp 1600w" sizes="(max-width: 900px) 100vw, 560px" alt="Céline et une dame âgée remplissent ensemble le carnet de sourires, en riant." width="1600" height="1981" fetchpriority="high" />
          </div>
          <div class="float-card float-card--status">
            <span class="float-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5M9 8h5"/></svg></span>
            <span><strong class="small" style="display:block">Carnet de sourires</strong><span class="xs muted">Rempli à chaque visite</span></span>
          </div>
          <div class="float-card float-card--price">
            <div class="price">
              <span class="price__label">Tarif horaire</span>
              <span class="price__main"><span class="price__amount">{H}&nbsp;€</span><span class="price__unit">TTC / heure</span></span>
              <p class="price__note">Soit <strong>{HN} € / h</strong> après crédit d’impôt de 50&nbsp;%, sous conditions*.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CHIFFRES ============ -->
    <section class="section--tight" aria-label="L’essentiel en chiffres">
      <div class="wrap">
        <div class="kpis reveal">
          <div class="kpi"><span class="kpi__value">1<small>h</small></span><span class="kpi__label">Durée minimale d’une visite</span></div>
          <div class="kpi"><span class="kpi__value">45<small>min</small></span><span class="kpi__label">Visite d’évaluation offerte, à domicile</span></div>
          <div class="kpi"><span class="kpi__value">8</span><span class="kpi__label">Communes desservies sans frais de trajet</span></div>
          <div class="kpi"><span class="kpi__value">3</span><span class="kpi__label">Pôles d’activités, à composer librement</span></div>
        </div>
      </div>
    </section>

    <!-- ============ 01 PUBLICS ============ -->
    <section class="section" style="padding-top: clamp(32px, 4vw, 56px)" aria-labelledby="publics-title">
      <div class="wrap">
        <div class="section-head section-head--row">
          <div class="stack">
            <span class="eyebrow"><span class="eyebrow__num">01</span>Pour qui</span>
            <h2 class="h2" id="publics-title">Un accompagnement <em>pour chaque âge</em> de la vie</h2>
          </div>
          <p class="lead" style="max-width: 44ch">Avec la même exigence partout : écouter avant d’agir, respecter le silence comme la parole, construire la confiance pas à pas.</p>
        </div>
        <div class="grid grid-3">
          <a class="card reveal" href="/services#compagnie">
            <span class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21.5l8.8-8.8a5 5 0 0 0 0-7.1z"/></svg></span>
            <h3 class="h3">Seniors autonomes</h3>
            <p class="muted">Préserver l’autonomie et rompre la solitude sans forcer la conversation : lecture, récits de vie, jeux, sorties courtes. Une prévention du quotidien, tout en douceur.</p>
            <div class="card__foot"><span class="badge badge--rose">À partir de 1 h</span><span class="card__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
          </a>
          <a class="card reveal" href="/services#compagnie">
            <span class="card__icon card__icon--bleu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18v-6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v6M3 15h18M6 9V6"/><circle cx="8.5" cy="12" r="0.5"/></svg></span>
            <h3 class="h3">Personnes temporairement immobilisées</h3>
            <p class="muted">Enfants, adolescents ou adultes au repos forcé : du jeu, du sens et des objectifs atteignables, sans nier la fatigue.</p>
            <div class="card__foot"><span class="badge badge--bleu">Convalescence</span><span class="card__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
          </a>
          <a class="card reveal" href="/services#repit">
            <span class="card__icon card__icon--sauge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="6" r="2.6"/><path d="M4.5 21v-6.5a4.5 4.5 0 0 1 9 0V21"/><circle cx="17.5" cy="10" r="2"/><path d="M15 21v-4a2.5 2.5 0 0 1 5 0v4"/></svg></span>
            <h3 class="h3">Parents solos</h3>
            <p class="muted">Un relais ponctuel face à la fatigue : garde d’enfants de plus de 3 ans, en journée hors week-end, sorties et démarches.</p>
            <div class="card__foot"><span class="badge">Enfants de + de 3 ans</span><span class="card__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
          </a>
        </div>
        <MonRole compact />
      </div>
    </section>

    <!-- ============ 02 SERVICES ============ -->
    <section class="section section--white rule-y" aria-labelledby="services-title">
      <div class="wrap">
        <div class="section-head section-head--row">
          <div class="stack">
            <span class="eyebrow"><span class="eyebrow__num">02</span>Nos prestations</span>
            <h2 class="h2" id="services-title">Trois pôles d’activités, <em>une seule présence</em></h2>
          </div>
          <a class="link" href="/services">Toutes les activités <span aria-hidden="true">→</span></a>
        </div>
        <div class="grid grid-3">
          <article class="pole reveal">
            <div class="pole__img"><img src="/images/personne-agee-800.webp" alt="Moment de lecture et d’échange avec une personne âgée." loading="lazy" style="object-position: center 35%" /><span class="badge">À partir de 1 h</span></div>
            <div class="pole__body">
              <h3 class="h3">Compagnie &amp; lien social</h3>
              <p class="muted small">Rompre l’isolement et stimuler les capacités cognitives : un temps d’échange convivial, à la maison, sans jamais mettre en échec.</p>
              <ul class="pole__list"><li>Lecture à voix haute</li><li>Récits de vie</li><li>Jeux de société</li><li>Atelier mémoire</li><li>Ateliers créatifs</li></ul>
            </div>
          </article>
          <article class="pole reveal">
            <div class="pole__img"><img src="/images/balade.webp" alt="Promenade en plein air, à son rythme." loading="lazy" /><span class="badge">À partir de 2 h</span></div>
            <div class="pole__body">
              <h3 class="h3">Mobilité &amp; vie sociale</h3>
              <p class="muted small">Des sorties à thème qui commencent à la maison et se prolongent dehors : prendre l’air, stimuler les capacités motrices, garder ses repères.</p>
              <ul class="pole__list"><li>Pages &amp; paysages</li><li>Papotes &amp; panier</li><li>Sortie rétro</li><li>Écoute &amp; escorte</li></ul>
            </div>
          </article>
          <article class="pole reveal">
            <div class="pole__img"><img src="/images/enfant.webp" alt="Enfant souriante lors d’une activité partagée à domicile." loading="lazy" /><span class="badge">À partir de 1 h</span></div>
            <div class="pole__body">
              <h3 class="h3">Répit &amp; vie pratique</h3>
              <p class="muted small">Permettre au parent solo ou au proche aidant de souffler, et aider dans les petites tâches du quotidien qui pèsent.</p>
              <ul class="pole__list"><li>Relais de l’aidant</li><li>Tri du courrier</li><li>Papiers du quotidien</li><li>Démarches sur tablette</li></ul>
            </div>
          </article>
        </div>

        <div class="materials reveal">
          <div class="materials__intro">
            <span class="badge badge--jaune"><span class="dot"></span>La dame de compagnie moderne</span>
            <h3 class="h2" style="font-size: var(--fs-xl)">Je viens avec le matériel nécessaire</h3>
            <p class="muted small">Des activités multi-compétences (mémoire, langage, motricité fine, équilibre) et rien à prévoir chez vous : tout est convenu à l’avance avec vous et la famille, selon les envies et les capacités du moment.</p>
          </div>
          <div class="materials__item"><span class="materials__num">A</span><strong class="h4">Déambulateur Georgette</strong><span class="small muted">Baptisé en hommage à mes grands-parents (95 et 96 ans).</span></div>
          <div class="materials__item"><span class="materials__num">B</span><strong class="h4">Jeux de société</strong><span class="small muted">Cartes, énigmes, jeux calmes à partager.</span></div>
          <div class="materials__item"><span class="materials__num">C</span><strong class="h4">Perles &amp; créativité</strong><span class="small muted">Bracelets, collages, activités manuelles légères.</span></div>
        </div>
      </div>
    </section>

    <!-- ============ 03 MÉTHODE ============ -->
    <section class="section" aria-labelledby="methode-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><span class="eyebrow__num">03</span>Comment ça se passe</span>
          <h2 class="h2" id="methode-title">Quatre étapes, <em>sans engagement</em> au départ</h2>
          <p class="lead">La qualité d’un accompagnement se joue dans les détails : ton de voix, ponctualité, discrétion.</p>
        </div>
        <ol class="steps reveal">
          <li class="step"><span class="step__num">1</span><span class="step__tag">Par téléphone ou formulaire</span><h3 class="h3">Premier échange</h3><p class="muted small">Vos attentes, vos contraintes, vos envies, sans promesse irréaliste.</p></li>
          <li class="step"><span class="step__num">2</span><span class="step__tag">Offerte · environ 45 min</span><h3 class="h3">Visite d’évaluation</h3><p class="muted small">À domicile, avec la famille si vous le souhaitez, pour cadrer les besoins et le rythme.</p></li>
          <li class="step"><span class="step__num">3</span><span class="step__tag">Devis &amp; contrat signé en ligne</span><h3 class="h3">Des visites à votre rythme</h3><p class="muted small">Pas de « coaching » culpabilisant : un silence partagé, c’est aussi du lien.</p></li>
          <li class="step"><span class="step__num">4</span><span class="step__tag">Carnet &amp; espace familles</span><h3 class="h3">Suivi et ajustement</h3><p class="muted small">Le carnet relie les séances ; on ajuste selon la fatigue, les envies, la saison.</p></li>
        </ol>
      </div>
    </section>

    <!-- ============ 04 CARNET ============ -->
    <section class="section section--sauge rule-y" id="carnet" aria-labelledby="carnet-title" style="scroll-margin-top: 80px">
      <div class="wrap split">
        <div class="carnet-visual reveal">
          <img class="carnet-visual__book" src="/images/carnet.webp" alt="Le carnet de sourires, couverture fleurie à l’aquarelle." loading="lazy" />
          <div class="app-card" aria-hidden="true">
            <div class="app-card__bar"><span>Espace familles · Mardi</span><span class="app-card__dots"><i></i><i></i><i></i></span></div>
            <div class="app-card__body">
              <div class="entry"><span class="entry__av">CM</span><div><div class="entry__meta">Céline · 14:30 – 16:30</div><div class="entry__text">Balade jusqu’au marché, puis lecture du journal. Beaucoup de souvenirs d’école aujourd’hui.</div><div class="mood"><span>☀ Bonne journée</span><span>Sortie</span></div></div></div>
              <div class="entry"><span class="entry__av entry__av--s">SL</span><div><div class="entry__meta">Sophie (fille) · 18:02</div><div class="entry__text">Merci ! Elle m’en a parlé au téléphone 😊</div></div></div>
            </div>
          </div>
        </div>
        <div class="stack reveal">
          <span class="eyebrow"><span class="eyebrow__num">04</span>Notre outil phare</span>
          <h2 class="h2" id="carnet-title">Le carnet de sourires, <em>sur papier et en ligne</em></h2>
          <p class="lead">Un journal de liaison et de souvenirs entre les séances, pour que personne ne se sente « hors boucle ». Pas un dossier médical : une histoire à plusieurs voix.</p>
          <ul class="feature-list" style="margin-top: 28px">
            <li><span class="feature-list__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></span><div><h3 class="h4">Rempli à chaque visite</h3><p class="small muted">Préférences, petits faits marquants, photos collées, objectifs atteints.</p></div></li>
            <li><span class="feature-list__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span><div><h3 class="h4">Espace familles sécurisé</h3><p class="small muted">Un compte personnel par famille pour suivre les visites à distance.</p></div></li>
            <li><span class="feature-list__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/></svg></span><div><h3 class="h4">Confidentialité</h3><p class="small muted">Ce qui se dit à la maison reste à la maison. Données traitées dans le cadre du RGPD.</p></div></li>
          </ul>
          <a class="link" href="/services#carnet" style="margin-top: 20px">Découvrir le carnet <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- ============ 05 TARIFS ============ -->
    <section class="section" aria-labelledby="tarifs-title">
      <div class="wrap">
        <div class="section-head section-head--row">
          <div class="stack">
            <span class="eyebrow"><span class="eyebrow__num">05</span>Tarifs</span>
            <h2 class="h2" id="tarifs-title">Des tarifs <em>clairs</em>, déplacements compris</h2>
          </div>
          <a class="link" href="/offres">Grille complète &amp; simulateur <span aria-hidden="true">→</span></a>
        </div>
        <div class="plans plans--3">
          <article class="plan reveal">
            <div class="stack"><h3 class="h3">Pack découverte</h3><p class="muted small">Faire connaissance avant un engagement plus long.</p></div>
            <div class="price"><span class="price__label">{PACK_DECOUVERTE.heures} heures</span><span class="price__main"><span class="price__amount">{PACK_DECOUVERTE.brutEur}&nbsp;€</span><span class="price__unit">TTC</span></span><p class="price__note">Soit <strong>{net(PACK_DECOUVERTE.brutEur)} €</strong> après crédit d’impôt, sous conditions*.</p></div>
            <ul class="checklist"><li>À répartir selon vos disponibilités</li><li>Sans engagement sur la suite</li></ul>
            <a class="btn btn--secondary" href="/contact?pack=decouverte#formulaire">Choisir ce pack</a>
          </article>
          <article class="plan plan--featured reveal">
            <span class="plan__ribbon">Recommandé</span>
            <div class="stack"><h3 class="h3">Forfait mensuel</h3><p class="muted small">Des créneaux réguliers pour ancrer le lien dans le temps.</p></div>
            <div class="price"><span class="price__label">{FORFAIT_MENSUEL.heures} heures / mois</span><span class="price__main"><span class="price__amount">{FORFAIT_MENSUEL.brutEur}&nbsp;€</span><span class="price__unit">TTC / mois</span></span><p class="price__note">Soit <strong>{net(FORFAIT_MENSUEL.brutEur)} € / mois</strong> après crédit d’impôt, sous conditions*.</p></div>
            <ul class="checklist"><li>{HM} € TTC de l’heure au lieu de {H} €</li><li>Planning prévisible, volume ajustable</li></ul>
            <a class="btn btn--light" href="/contact?pack=mensuel#formulaire">Choisir ce forfait</a>
          </article>
          <article class="plan reveal">
            <div class="stack"><h3 class="h3">Accompagnement ponctuel</h3><p class="muted small">À la demande, selon vos besoins du moment.</p></div>
            <div class="price"><span class="price__label">À l’heure</span><span class="price__main"><span class="price__amount">{H}&nbsp;€</span><span class="price__unit">TTC / heure</span></span><p class="price__note">Soit <strong>{HN} € / h</strong> après crédit d’impôt, sous conditions*.</p></div>
            <ul class="checklist"><li>Sortie, lecture, démarche, jeu</li><li>En complément des aidants</li></ul>
            <a class="btn btn--secondary" href="/contact?pack=ponctuel#formulaire">Demander un créneau</a>
          </article>
        </div>
        <p class="footnote" style="margin-top: 20px">* Crédit d’impôt de 50 % des sommes versées pour un service à la personne (art. 199 sexdecies du CGI), dans la limite des plafonds en vigueur, payé par la personne aidée et hors espèces. Possibilité d’Avance immédiate via l’URSSAF. La rédaction d’une biographie n’y ouvre pas droit.</p>
      </div>
    </section>

    <!-- ============ 06 HISTOIRE ============ -->
    <section class="section section--marine" id="histoire" aria-labelledby="histoire-title" style="scroll-margin-top: 80px">
      <div class="wrap story">
        <div class="story__media reveal">
          <div class="story__photo"><img src="/images/carnet2.webp" alt="Carnet de sourires posé sur une table, entouré de fleurs." loading="lazy" /></div>
          <div class="story__sign"><span class="xs" style="color: var(--ink-3); display:block">Fondatrice</span><span class="script">Céline</span></div>
        </div>
        <div class="stack reveal">
          <span class="eyebrow"><span class="eyebrow__num">06</span>Mon histoire</span>
          <h2 class="h2" id="histoire-title">Faire de nos boiteries <em>une danse</em></h2>
          <p class="lead">Tout a commencé avec ma maman, et un livre tombé au bon moment : <cite>Faire de nos boiteries une danse</cite>, de Reza Moghaddassi. Une invitation à ralentir, à écouter, à croire que les petits gestes comptent autant que les grands discours.</p>
          <p class="lead">Jojo, c’est le surnom qui rassemble le sourire, la légèreté et la dignité. Je propose à votre foyer la même douceur : à votre rythme, dans le respect de votre histoire.</p>
          <figure class="quote" style="margin-top: 32px">
            <blockquote>« Dans l’aise ou dans la gêne, dans la maladie ou la santé… Tiens-toi droit et souris. »</blockquote>
            <figcaption>Lanza del Vasto</figcaption>
          </figure>
          <a class="btn btn--ghost-light" href="/a-propos" style="margin-top: 16px">Lire mon histoire</a>
        </div>
      </div>
    </section>

    <!-- ============ 07 MOMENTS ============ -->
    <section class="section section--white" aria-labelledby="moments-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><span class="eyebrow__num">07</span>Moments</span>
          <h2 class="h2" id="moments-title">Des sourires <em>qui restent</em></h2>
        </div>
        <div class="gallery reveal">
          <figure><img src="/images/galerie/photo-5.webp" alt="Femme souriante avec des lunettes roses, un moment de joie et de complicité." loading="lazy" style="transform: scale(1.55); object-position: center 45%" /><figcaption>Joie &amp; présence</figcaption></figure>
          <figure><img src="/images/galerie/photo-4.webp" alt="Accompagnement en pleine nature, dans un jardin fleuri." loading="lazy" style="object-position: 70% center" /><figcaption>Nature &amp; douceur</figcaption></figure>
          <figure><img src="/images/galerie/photo-3.webp" alt="Personne âgée en extérieur, accompagnée avec bienveillance." loading="lazy" style="transform: scale(1.3); transform-origin: center 20%" /><figcaption>Dehors, à son rythme</figcaption></figure>
