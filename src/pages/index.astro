        </div>
      </div>
    </section>

    <!-- ============ 09 FAQ ============ -->
    <section class="section" aria-labelledby="faq-title">
      <div class="wrap split split--5-7" style="align-items: start">
        <div class="section-head section-head--sticky" style="--sticky-top: 120px">
          <span class="eyebrow"><span class="eyebrow__num">09</span>Questions fréquentes</span>
          <h2 class="h2" id="faq-title">Vous vous <em>demandez</em> peut-être…</h2>
          <p class="muted"><a class="link" href="/a-propos#faq">Toutes les questions</a> · <a class="link" href="/contact#formulaire">Écrivez-nous</a></p>
