---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { POLES, type PoleId } from "@/lib/catalogue";
import { FORFAITS_ACTIVITES } from "@/lib/tarif";

const title = "Nos services — Le Sourire de Jojo";
const description =
  "Compagnie et lien social, mobilité et vie sociale, répit et vie pratique : des activités multi-compétences pour la prévention du quotidien et la préservation de l’autonomie, autour de Corbarieu et Montauban.";

const LIBELLES: Record<PoleId, string> = {
  compagnie: "Compagnie & lien social",
  mobilite: "Mobilité & vie sociale (sorties)",
  repit: "Répit & vie pratique",
};
function prixPole(id: PoleId): string {
  const prix = FORFAITS_ACTIVITES.filter((f) => f.label === LIBELLES[id])
    .map((f) => (f.heures === 1 ? `${f.brutEur} € TTC l’heure` : `${f.brutEur} € TTC les ${f.duree}`))
    .join(", ");
  return id === "repit" ? `${prix} · garde d’enfants de plus de 3 ans, en journée hors week-end` : prix;
}
---

<BaseLayout title={title} description={description} breadcrumb={[{ href: "/", label: "Accueil" }, { label: "Services" }]}>
    <section class="page-hero" aria-labelledby="page-title">
      <img class="page-hero__flower" src="/images/fleurs/3.webp" alt="" aria-hidden="true" />
      <div class="wrap">
        <nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><span aria-current="page">Services</span></nav>
        <div class="split split--7-5" style="align-items: end">
          <div class="stack">
            <span class="eyebrow">Nos prestations</span>
            <h1 class="display" id="page-title">Trois pôles d’activités, <em>à composer</em> selon vos envies</h1>
          </div>
          <p class="lead">Des activités multi-compétences pour stimuler les capacités cognitives et motrices et préserver l’autonomie. Chaque visite se construit avec vous, selon la forme du jour. Matériel apporté, sans soins médicaux.</p>
        </div>
      </div>
    </section>

    <nav class="subnav" aria-label="Pôles d’activités">
      <div class="wrap">
        <ul>
          <li><a href="#compagnie" class="is-active">Compagnie &amp; lien social</a></li>
          <li><a href="#mobilite">Mobilité &amp; vie sociale</a></li>
          <li><a href="#repit">Répit &amp; vie pratique</a></li>
          <li><a href="#deroule">Comment ça se passe</a></li>
          <li><a href="#carnet">Carnet de sourires</a></li>
          <li><a href="#cadre">Le cadre</a></li>
        </ul>
      </div>
    </nav>

    <div class="wrap">
      {POLES.map((pole, i) => (
        <section class="pole-detail" id={pole.id} aria-labelledby={`p-${pole.id}`}>
          <div class="pole-detail__media reveal">
            <img src={pole.image} alt={pole.imageAlt} loading={i === 0 ? "eager" : "lazy"} style="object-position: center 30%" />
            <div class="notice notice--sauge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
              <span><strong>{pole.dureeMin}</strong> · {prixPole(pole.id)}</span>
            </div>
          </div>
          <div class="stack reveal">
            <span class="eyebrow"><span class="eyebrow__num">{String(i + 1).padStart(2, "0")}</span>Pôle</span>
            <h2 class="h2" id={`p-${pole.id}`}>{pole.titre}</h2>
            <p class="lead">{pole.accroche}</p>
            <ul class="activities" style="margin-top: 28px">
              {pole.activites.map((a) => (
                <li><strong>{a.nom}</strong>{a.detail && <span>{a.detail}</span>}</li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>

    <section class="section section--white rule-y" id="deroule" aria-labelledby="deroule-title" style="scroll-margin-top: 150px">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Comment ça se passe</span>
          <h2 class="h2" id="deroule-title">Quatre étapes, <em>sans engagement</em> au départ</h2>
        </div>
        <ol class="steps reveal">
          <li class="step"><span class="step__num">1</span><span class="step__tag">Par téléphone ou formulaire</span><h3 class="h3">Premier échange</h3><p class="muted small">Vos attentes, vos contraintes, vos envies, sans promesse irréaliste.</p></li>
          <li class="step"><span class="step__num">2</span><span class="step__tag">Offerte · environ 45 min</span><h3 class="h3">Visite d’évaluation</h3><p class="muted small">À domicile, avec la famille si vous le souhaitez, pour cadrer les besoins et le rythme.</p></li>
          <li class="step"><span class="step__num">3</span><span class="step__tag">Devis &amp; contrat signé en ligne</span><h3 class="h3">Des visites à votre rythme</h3><p class="muted small">Pas de « coaching » culpabilisant : un silence partagé, c’est aussi du lien.</p></li>
          <li class="step"><span class="step__num">4</span><span class="step__tag">Carnet &amp; espace familles</span><h3 class="h3">Suivi et ajustement</h3><p class="muted small">Le carnet relie les séances ; on ajuste selon la fatigue, les envies, la saison.</p></li>
        </ol>
      </div>
    </section>

    <section class="section section--sauge" id="carnet" aria-labelledby="carnet-title" style="scroll-margin-top: 150px">
      <div class="wrap">
        <div class="split" style="align-items: start">
          <div class="stack reveal">
            <span class="eyebrow">Notre outil phare</span>
            <h2 class="h2" id="carnet-title">Le carnet de sourires</h2>
            <p class="lead">Un journal de liaison et un livre de souvenirs à la fois. Il trace une mémoire partagée pour la famille, et redonne de la continuité à la personne accompagnée lorsque les journées se ressemblent.</p>
            <div class="grid grid-2" style="margin-top: 24px">
              <div class="card"><h3 class="h4">Préférences &amp; habitudes</h3><p class="small muted">Chansons, goûts, rythme du jour, ce qui apaise ou stimule.</p></div>
              <div class="card"><h3 class="h4">Souvenirs &amp; photos</h3><p class="small muted">Pages écrites, images collées, petits dessins ou citations.</p></div>
              <div class="card"><h3 class="h4">Messages pour la famille</h3><p class="small muted">Un compte-rendu doux de la séance pour les proches absents.</p></div>
              <div class="card"><h3 class="h4">Continuité</h3><p class="small muted">Objectifs atteints, promesses pour la prochaine fois.</p></div>
            </div>
            <div class="notice" style="margin-top: 8px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span><strong>Aussi en ligne :</strong> chaque famille a un compte personnel sécurisé pour relire et ajouter des entrées entre les séances. <a class="link" href="/compte/connexion">Espace familles →</a></span></div>
          </div>
          <div class="grid grid-2 reveal" style="align-items: start">
            <figure style="margin:0"><img src="/images/carnet.webp" alt="Carnet de Sourires fermé, reliure fleurie et ruban rose." style="border-radius: var(--r-lg); box-shadow: var(--shadow-2)" loading="lazy" /><figcaption class="xs muted" style="margin-top: 8px">Fermé : reliure &amp; identité</figcaption></figure>
            <figure style="margin:48px 0 0"><img src="/images/carnet2.webp" alt="Carnet de Sourires ouvert sur la page de titre et une page lignée." style="border-radius: var(--r-lg); box-shadow: var(--shadow-2)" loading="lazy" /><figcaption class="xs muted" style="margin-top: 8px">Ouvert : pages à remplir</figcaption></figure>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--ivoire rule-y" id="cadre" aria-labelledby="cadre-title" style="scroll-margin-top: 150px">
      <div class="wrap split" style="align-items: start">
        <div class="stack">
          <span class="eyebrow">Un cadre clair</span>
          <h2 class="h2" id="cadre-title">Ce que nous faisons, <em>et ce que nous ne faisons pas</em></h2>
          <p class="lead">Le Sourire de Jojo est une activité de service à la personne déclarée. Pour votre sécurité, le cadre est précis.</p>
        </div>
        <div class="grid grid-2">
          <div class="card">
            <span class="badge"><span class="dot"></span>Oui</span>
            <ul class="checklist small"><li>Compagnie, lecture, jeux, sorties</li><li>Seniors autonomes</li><li>Personnes temporairement immobilisées</li><li>Garde ponctuelle d’enfants de + de 3 ans</li><li>Petites démarches du quotidien</li></ul>
          </div>
          <div class="card">
            <span class="badge badge--rose"><span class="dot"></span>Non</span>
            <ul class="checklist checklist--no small"><li>Soins, nursing, actes médicaux</li><li>Personnes âgées dépendantes (bénéficiaires de l’APA)</li><li>Garde d’enfants de moins de 3 ans</li></ul>
            <p class="xs muted">Nous orientons alors vers les professionnels compétents.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="cta reveal">
          <img class="cta__flower" src="/images/fleurs/3.webp" alt="" aria-hidden="true" />
          <div class="stack" style="position: relative">
            <span class="eyebrow" style="color: var(--jaune)">Composer votre accompagnement</span>
            <h2 class="h2">On en parle lors de la <em style="color: var(--jaune)">visite offerte</em> ?</h2>
          </div>
          <div class="cta__contact">
            <a class="btn btn--light" href="/contact#formulaire">Prendre rendez-vous</a>
            <a class="link" style="color: var(--ivoire)" href="/offres">Voir les tarifs →</a>
          </div>
        </div>
      </div>
    </section>
</BaseLayout>
