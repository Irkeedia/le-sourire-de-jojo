---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildServiceList, resolveSiteUrl } from "@/lib/seo";
import { EXCLUSIONS, INCLUS, POLES } from "@/lib/catalogue";
import { TARIF_HORAIRE_BRUT_EUR } from "@/lib/tarif";

const title = "Nos services — Le Sourire de Jojo";
const description =
  "Dame de compagnie à domicile : compagnie et lien social, sorties à thème, répit des parents solos et des aidants, aide aux papiers et au numérique. Corbarieu, Montauban et alentours (Tarn-et-Garonne).";

const siteUrl = resolveSiteUrl(Astro.site?.href, Astro.url.origin);

const publics = [
  "Les seniors autonomes",
  "Les adultes empêchés pour un temps (convalescence, immobilisation)",
  "Les enfants de plus de 3 ans",
  "Les parents solos et les proches aidants qui ont besoin de souffler",
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumb={[{ href: "/", label: "Accueil" }, { label: "Nos services" }]}
  jsonLd={buildServiceList(siteUrl)}
>
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
    <h1 class="font-display text-4xl text-marine md:text-5xl">Nos services</h1>
    <p class="mt-6 max-w-3xl text-lg text-marine/90">
      <strong class="text-marine">La dame de compagnie moderne</strong> : de la présence, des activités et des sorties, organisées
      en trois pôles. Chaque accompagnement se compose avec vous, à partir de {TARIF_HORAIRE_BRUT_EUR}&nbsp;€ TTC de l’heure.
    </p>

    <section class="mt-10 rounded-2xl border border-marine/15 bg-white/90 p-6 shadow-sm md:p-8" aria-labelledby="public-title">
      <h2 id="public-title" class="font-display text-2xl text-marine">Pour qui ?</h2>
      <ul class="mt-4 grid gap-2 text-marine/90 sm:grid-cols-2">
        {publics.map((p) => (
          <li class="flex gap-2">
            <span class="text-rose-vieux" aria-hidden="true">✿</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </section>

    <ul class="mt-12 space-y-10">
      {
        POLES.map((pole, i) => (
          <li id={pole.id} class="scroll-mt-28 flex flex-col gap-6 rounded-2xl border border-marine/15 bg-white/90 p-6 shadow-sm md:flex-row md:items-start md:gap-10 md:p-8">
            <figure class="w-full shrink-0 overflow-hidden rounded-2xl border border-marine/15 bg-marine/5 shadow-sm md:w-64">
              <img
                src={pole.image}
                alt={pole.imageAlt}
                width={400}
                height={300}
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
                class="aspect-[4/3] h-auto w-full object-cover"
              />
            </figure>
            <div class="flex-1">
              <p class="text-xs font-semibold uppercase tracking-wide text-marine/60">Pôle {i + 1} · {pole.dureeMin}</p>
              <h2 class="mt-1 font-display text-2xl text-marine md:text-3xl">{pole.titre}</h2>
              <p class="mt-3 leading-relaxed text-marine/90">{pole.accroche}</p>
              <ul class="mt-5 grid gap-x-6 gap-y-2 text-marine/90 sm:grid-cols-2">
                {pole.activites.map((a) => (
                  <li class="flex gap-2">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-rose-vieux" aria-hidden="true" />
                    <span>
                      <strong class="font-semibold text-marine">{a.nom}</strong>
                      {a.detail && <span class="text-marine/80"> : {a.detail}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>

    <section class="mt-12 grid gap-6 md:grid-cols-2" aria-label="Ce qui est compris, ce qui ne l’est pas">
      <div class="rounded-2xl border border-marine/15 bg-sauge/15 p-6 md:p-8">
        <h2 class="font-display text-2xl text-marine">Toujours compris</h2>
        <ul class="mt-4 space-y-2 text-marine/90">
          {INCLUS.map((item) => (
            <li class="flex gap-2">
              <span class="text-rose-vieux" aria-hidden="true">✿</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-sm text-marine/75">Un extrait de casier judiciaire vierge peut être présenté aux familles sur demande.</p>
      </div>
      <div class="rounded-2xl border border-marine/15 bg-white/90 p-6 md:p-8">
        <h2 class="font-display text-2xl text-marine">Ce que je ne fais pas</h2>
        <ul class="mt-4 space-y-2 text-marine/90">
          {EXCLUSIONS.map((item) => (
            <li class="flex gap-2">
              <span class="text-marine/50" aria-hidden="true">–</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-sm text-marine/75">Pour ces besoins, j’oriente vers les professionnels de santé et les services d’aide à domicile.</p>
      </div>
    </section>

    <p class="mt-10">
      <a
        href="/offres"
        class="inline-flex items-center justify-center rounded-full bg-marine px-6 py-3 font-semibold text-ivoire shadow transition hover:bg-marine/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-marine"
        >Voir les tarifs et les forfaits</a
      >
    </p>

    <section class="mt-16 max-w-3xl rounded-2xl border border-marine/15 bg-sauge/15 p-6 md:p-8" aria-labelledby="materiel-title">
      <h2 id="materiel-title" class="font-display text-2xl text-marine">Matériel &amp; logistique</h2>
      <p class="mt-4 text-marine/90 leading-relaxed">
        J’apporte le matériel nécessaire à l’accompagnement lorsque nous l’avons convenu ensemble — pour que vous n’ayez pas
        tout à prévoir chez vous :
      </p>
      <ul class="mt-4 space-y-2 text-marine/90 leading-relaxed">
        <li class="flex gap-2">
          <span class="text-rose-vieux" aria-hidden="true">✿</span>
          <span>
            <strong class="text-marine">Déambulateur Georgette</strong>, ainsi baptisé en hommage à mes grands-parents de 95
            et 96 ans.
          </span>
        </li>
        <li class="flex gap-2">
          <span class="text-rose-vieux" aria-hidden="true">✿</span>
          <span><strong class="text-marine">Jeux de société</strong>, cartes, énigmes et activités calmes.</span>
        </li>
        <li class="flex gap-2">
          <span class="text-rose-vieux" aria-hidden="true">✿</span>
          <span><strong class="text-marine">Perles</strong> et petit matériel créatif (bracelets, collages, etc.).</span>
        </li>
      </ul>
      <p class="mt-4 text-marine/90 leading-relaxed">
        Nous précisons toujours <strong class="text-marine">qui apporte quoi</strong> à l’avance : utilisation de votre propre
        matériel ou apport du mien. Objectif : éviter toute ambiguïté et sécuriser le déroulement de la séance.
      </p>
    </section>
  </div>
</BaseLayout>
