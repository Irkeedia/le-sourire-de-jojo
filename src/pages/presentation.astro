---
import SlideLayout from "@/layouts/SlideLayout.astro";
import { LOGO_SRC } from "@/lib/brand";
import {
  PRESENTATION_PPTX_HREF,
  presentationSlides as slides,
} from "@/lib/presentation-slides";
import {
  PRESENTATION_PDF_FILENAME,
  PRESENTATION_PDF_HREF,
} from "@/lib/presentation-pdf-export";

const title = "Présentation — Le Sourire de Jojo";
const description =
  "Présentation Le Sourire de JoJo — dame de compagnie moderne à Montauban et Corbarieu. 10 slides à partager ou imprimer en PDF.";
---

<SlideLayout title={title} description={description}>
  <div class="deck" id="slide-deck" data-total={slides.length}>
    <header class="deck__chrome">
      <a href="/" class="deck__exit" title="Quitter la présentation">← Site</a>
      <span class="deck__counter" id="slide-counter" aria-live="polite">1 / {slides.length}</span>
      <div class="deck__chrome-actions">
        <div class="deck__export">
          <button
            type="button"
            class="deck__export-toggle"
            id="slide-export-toggle"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="slide-export-menu"
          >
            Partager / Export
          </button>
          <div class="deck__export-menu" id="slide-export-menu" role="menu" hidden>
            <a
              href={PRESENTATION_PDF_HREF}
              class="deck__export-item deck__export-item--primary deck__export-item--link"
              role="menuitem"
              download={PRESENTATION_PDF_FILENAME}
            >
              Télécharger PDF (10 slides)
            </a>
            <a href={PRESENTATION_PPTX_HREF} class="deck__export-item deck__export-item--link" role="menuitem" download>
              Télécharger PowerPoint (PPTX)
            </a>
            <button type="button" class="deck__export-item" id="slide-share" role="menuitem">
              Partager la présentation
            </button>
            <button type="button" class="deck__export-item" id="slide-copy-link" role="menuitem">
              Copier le lien
            </button>
            <button type="button" class="deck__export-item" id="slide-print" role="menuitem">
              Imprimer…
            </button>
          </div>
        </div>
        <a
          href={PRESENTATION_PDF_HREF}
          class="deck__dl deck__dl--compact"
          download={PRESENTATION_PDF_FILENAME}
          title="Télécharger la présentation en PDF"
        >
          PDF
        </a>
        <a href={PRESENTATION_PPTX_HREF} class="deck__dl deck__dl--compact" download title="Télécharger le PowerPoint original">
          PPTX
        </a>
        <button type="button" class="deck__fs" id="slide-fullscreen" aria-label="Plein écran">⛶</button>
      </div>
    </header>

    <p class="deck__toast" id="slide-toast" role="status" aria-live="polite" hidden></p>

    <div class="deck__stage" id="slide-stage">
      {
        slides.map((slide, index) => (
          <section
            class:list={["slide", index === 0 && "is-active"]}
            data-slide={index}
            data-kind={slide.kind}
            aria-hidden={index === 0 ? "false" : "true"}
            aria-label={`Diapositive ${index + 1} sur ${slides.length}`}
          >
            {slide.kind === "hero" && (
              <div class:list={["slide__inner", "slide__inner--hero", slide.image && "slide__inner--hero-photo"]}>
                {slide.image ? (
                  <img
                    src={slide.image.src}
                    alt={slide.image.alt}
                    class="slide__hero-bg"
                    style={`object-fit: ${slide.image.fit ?? "cover"}; object-position: ${slide.image.position ?? "center center"};`}
                    loading="eager"
                    decoding="async"
                  />
                ) : (
                  <img src={LOGO_SRC} alt="" class="slide__logo" width="160" height="160" />
                )}
                <div class="slide__hero-content">
                  <h1 class="slide__hero-title">{slide.title}</h1>
                  <p class="slide__hero-sub">{slide.subtitle}</p>
                  {slide.tagline && <p class="slide__hero-tag">{slide.tagline}</p>}
                </div>
              </div>
            )}

            {slide.kind === "bullets" && (
              <div class:list={["slide__inner", slide.accent && `slide__inner--${slide.accent}`]}>
                <p class="slide__kicker">Diapositive {index + 1}</p>
                <h2 class="slide__title">{slide.title}</h2>
                {slide.intro && <p class="slide__intro">{slide.intro}</p>}
                <ul class="slide__list">
                  {slide.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}

            {slide.kind === "split" && (
              <div class="slide__inner slide__inner--split">
                <div class="slide__split-text">
                  <p class="slide__kicker">Diapositive {index + 1}</p>
                  <h2 class="slide__title">{slide.title}</h2>
                  <p class="slide__intro">{slide.text}</p>
                </div>
                <div class:list={["slide__media", slide.image.fit === "contain" && "slide__media--contain"]}>
                  <img
                    src={slide.image.src}
                    alt={slide.image.alt}
                    loading="lazy"
                    decoding="async"
                    style={`object-fit: ${slide.image.fit ?? "cover"}; object-position: ${slide.image.position ?? "center center"};`}
                  />
                </div>
              </div>
            )}

            {slide.kind === "mosaic" && (
              <div class:list={["slide__inner", "slide__inner--mosaic", slide.accent && `slide__inner--${slide.accent}`]}>
                <div class="slide__mosaic-head">
                  <p class="slide__kicker">Diapositive {index + 1}</p>
                  <h2 class="slide__title">{slide.title}</h2>
                  {slide.intro && <p class="slide__intro">{slide.intro}</p>}
                </div>
                <ul class="slide__mosaic-grid">
                  {slide.tiles.map((tile) => (
                    <li class="slide__mosaic-tile">
                      <div class:list={["slide__media", "slide__media--tile", tile.image.fit === "contain" && "slide__media--contain"]}>
                        <img
                          src={tile.image.src}
                          alt={tile.image.alt}
                          loading="lazy"
                          decoding="async"
                          style={`object-fit: ${tile.image.fit ?? "cover"}; object-position: ${tile.image.position ?? "center center"};`}
                        />
                      </div>
                      <h3 class="slide__mosaic-title">{tile.title}</h3>
                      <p class="slide__mosaic-text">{tile.text}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {slide.kind === "compare" && (
              <div class:list={["slide__inner", "slide__inner--compare", slide.accent && `slide__inner--${slide.accent}`]}>
                <header class="slide__compare-head">
                  <p class="slide__kicker">Diapositive {index + 1}</p>
                  <h2 class="slide__title slide__title--center">{slide.title}</h2>
                  {slide.headline && <p class="slide__compare-headline">{slide.headline}</p>}
                  {slide.intro && <p class="slide__compare-intro">{slide.intro}</p>}
                </header>

                <div class="slide__compare-table" role="table" aria-label="Comparaison des services">
                  <div class="slide__compare-table-head" role="row">
                    <div class="slide__compare-table-th slide__compare-table-th--before" role="columnheader">
                      {slide.leftTitle}
                    </div>
                    <div class="slide__compare-table-th slide__compare-table-th--after" role="columnheader">
                      {slide.rightTitle}
                    </div>
                  </div>
                  {slide.leftItems.map((left, rowIndex) => (
                    <div class="slide__compare-table-row" role="row">
                      <div class="slide__compare-table-cell slide__compare-table-cell--before" role="cell">
                        <span class="slide__compare-mark slide__compare-mark--before" aria-hidden="true">✕</span>
                        <span>{left}</span>
                      </div>
                      <div class="slide__compare-table-cell slide__compare-table-cell--after" role="cell">
                        <span class="slide__compare-mark slide__compare-mark--after" aria-hidden="true">✓</span>
                        <span>{slide.rightItems[rowIndex]}</span>
                      </div>
                    </div>
                  ))}
                </div>

                {slide.footer && <p class="slide__compare-footer">{slide.footer}</p>}
              </div>
            )}

            {slide.kind === "table" && (
              <div class="slide__inner slide__inner--table">
                <p class="slide__kicker">Diapositive {index + 1}</p>
                <h2 class="slide__title">{slide.title}</h2>
                {slide.intro && <p class="slide__intro">{slide.intro}</p>}
                <div class="slide__table-wrap">
                  <table class="slide__table">
                    <thead>
                      <tr>
                        {slide.headers.map((h) => (
                          <th scope="col">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {slide.rows.map((row) => (
                        <tr>
                          {row.map((cell) => (
                            <td>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {slide.note && <p class="slide__table-note">{slide.note}</p>}
              </div>
            )}

            {slide.kind === "contact" && (
              <div class="slide__inner slide__inner--split slide__inner--contact">
                <div class="slide__split-text slide__contact-copy">
                  <p class="slide__kicker">Diapositive {index + 1}</p>
                  <h2 class="slide__title">{slide.title}</h2>
                  <p class="slide__intro">{slide.text}</p>
                  <ul class="slide__contact-list">
                    <li>
                      <span class="slide__contact-label">Téléphone</span>
                      <a href={`tel:${slide.phone.replace(/\s/g, "")}`} class="slide__contact-value">{slide.phone}</a>
                    </li>
                    <li>
                      <span class="slide__contact-label">Site web</span>
                      <a href={slide.siteHref} class="slide__contact-value">{slide.siteLabel}</a>
                    </li>
                    <li>
                      <span class="slide__contact-label">Zone</span>
                      <span class="slide__contact-value">{slide.location}</span>
                    </li>
                  </ul>
                  <div class="slide__cta-row slide__cta-row--left">
                    <a href="/contact#formulaire" class="slide__btn slide__btn--primary">Nous contacter</a>
                    <a href="/offres" class="slide__btn slide__btn--ghost">Voir les offres</a>
                  </div>
                </div>
                {slide.image && (
                  <div class:list={["slide__media", slide.image.fit === "contain" && "slide__media--contain"]}>
                    <img
                      src={slide.image.src}
                      alt={slide.image.alt}
                      loading="lazy"
                      decoding="async"
                      style={`object-fit: ${slide.image.fit ?? "cover"}; object-position: ${slide.image.position ?? "center center"};`}
                    />
                  </div>
                )}
              </div>
            )}
          </section>
        ))
      }
    </div>

    <nav class="deck__nav" aria-label="Navigation des diapositives">
      <button type="button" class="deck__arrow" id="slide-prev" aria-label="Diapositive précédente" disabled>
        ‹
      </button>
      <div class="deck__dots" id="slide-dots" role="tablist" aria-label="Aller à une diapositive">
        {
          slides.map((_, index) => (
            <button
              type="button"
              class:list={["deck__dot", index === 0 && "is-active"]}
              data-goto={index}
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-label={`Diapositive ${index + 1}`}
            />
          ))
        }
      </div>
      <button type="button" class="deck__arrow" id="slide-next" aria-label="Diapositive suivante">
        ›
      </button>
    </nav>

    <p class="deck__hint" id="slide-hint">← → ou glisser · Espace · Échap pour quitter</p>
  </div>

  <style>
    .deck {
      position: relative;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      padding:
        max(0.5rem, env(safe-area-inset-top))
        max(0.75rem, env(safe-area-inset-right))
        max(0.5rem, env(safe-area-inset-bottom))
        max(0.75rem, env(safe-area-inset-left));
    }

    .deck__chrome {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.25rem 0.25rem 0.5rem;
      z-index: 20;
    }

    .deck__exit,
    .deck__fs,
    .deck__dl,
    .deck__export-toggle {
      font-size: 0.8125rem;
      font-weight: 600;
      color: #1d3557;
      background: rgba(255, 255, 255, 0.85);
      border: 1px solid rgba(29, 53, 87, 0.12);
      border-radius: 9999px;
      padding: 0.45rem 0.85rem;
      transition: background 0.2s;
    }

    .deck__export {
      position: relative;
    }

    .deck__export-toggle[aria-expanded="true"] {
      background: #fff;
      border-color: rgba(29, 53, 87, 0.25);
    }

    .deck__export-menu {
      position: absolute;
      top: calc(100% + 0.35rem);
      right: 0;
      z-index: 40;
      min-width: 15.5rem;
      padding: 0.35rem;
      border-radius: 0.85rem;
      border: 1px solid rgba(29, 53, 87, 0.12);
      background: rgba(255, 255, 255, 0.98);
      box-shadow: 0 16px 40px -20px rgba(29, 53, 87, 0.45);
    }

    .deck__export-item {
      display: block;
      width: 100%;
      text-align: left;
      padding: 0.55rem 0.75rem;
      border-radius: 0.55rem;
      font-size: 0.8125rem;
      font-weight: 600;
      color: #1d3557;
      background: transparent;
      border: none;
      transition: background 0.15s;
    }

    .deck__export-item:hover,
    .deck__export-item:focus-visible {
      background: rgba(143, 168, 146, 0.2);
      outline: none;
    }

    .deck__export-item--link {
      text-decoration: none;
    }

    .deck__export-item--primary {
      color: #1d3557;
      background: rgba(143, 168, 146, 0.15);
    }

    .deck__export-item--primary:hover,
    .deck__export-item--primary:focus-visible {
      background: rgba(143, 168, 146, 0.28);
    }

    .deck__export-item:disabled {
      opacity: 0.55;
      cursor: wait;
    }

    .deck__toast {
      position: fixed;
      left: 50%;
      bottom: max(5rem, calc(env(safe-area-inset-bottom) + 4.5rem));
      z-index: 50;
      transform: translateX(-50%) translateY(0.5rem);
      opacity: 0;
      pointer-events: none;
      padding: 0.55rem 1rem;
      border-radius: 9999px;
      background: rgba(29, 53, 87, 0.92);
      color: #f5f3e7;
      font-size: 0.8125rem;
      font-weight: 600;
      transition: opacity 0.2s, transform 0.2s;
    }

    .deck__toast.is-visible {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    @media (max-width: 640px) {
      .deck__export-toggle {
        padding: 0.45rem 0.65rem;
        font-size: 0.75rem;
      }

      .deck__dl--compact {
        display: none;
      }
    }

    @media (min-width: 641px) {
      .deck__export-menu .deck__export-item--link:nth-of-type(1) {
        display: none;
      }
    }

    .deck__chrome-actions {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .deck__dl {
      text-decoration: none;
    }

    .deck__dl:hover {
      background: #fff;
    }

    .deck__fs {
      width: 2.25rem;
      height: 2.25rem;
      padding: 0;
      display: grid;
      place-items: center;
      border-radius: 0.65rem;
    }

    .deck__exit:hover,
    .deck__fs:hover,
    .deck__export-toggle:hover {
      background: #fff;
    }

    .deck__counter {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(29, 53, 87, 0.55);
    }

    .deck__stage {
      position: relative;
      flex: 1;
      min-height: 0;
    }

    .slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      visibility: hidden;
      transform: translateX(2rem) scale(0.98);
      transition:
        opacity 0.38s ease,
        transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0.38s;
      pointer-events: none;
    }

    .slide.is-active {
      opacity: 1;
      visibility: visible;
      transform: translateX(0) scale(1);
      pointer-events: auto;
      z-index: 1;
    }

    .slide.is-leaving {
      transform: translateX(-2rem) scale(0.98);
      opacity: 0;
    }

    .slide__inner {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-radius: 1.25rem;
      border: 1px solid rgba(29, 53, 87, 0.1);
      background: linear-gradient(145deg, #ffffff 0%, #f9f8f5 45%, #f5f3e7 100%);
      box-shadow: 0 20px 50px -28px rgba(29, 53, 87, 0.35);
      padding: clamp(1.25rem, 4vw, 2.5rem);
      overflow: auto;
    }

    .slide__inner--hero {
      align-items: center;
      text-align: center;
      background: linear-gradient(160deg, #ffffff 0%, rgba(143, 168, 146, 0.18) 50%, rgba(200, 141, 141, 0.12) 100%);
    }

    .slide__inner--hero-photo {
      position: relative;
      padding: 0;
      overflow: hidden;
      justify-content: flex-end;
    }

    .slide__hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .slide__hero-content {
      position: relative;
      z-index: 1;
      margin-top: auto;
      width: 100%;
      padding: clamp(1.25rem, 4vw, 2rem);
      background: linear-gradient(to top, rgba(29, 53, 87, 0.88) 0%, rgba(29, 53, 87, 0.55) 55%, transparent 100%);
      color: #f5f3e7;
      text-align: left;
    }

    .slide__inner--hero-photo .slide__hero-title,
    .slide__inner--hero-photo .slide__hero-sub {
      color: #f5f3e7;
    }

    .slide__inner--hero-photo .slide__hero-tag {
      color: rgba(245, 243, 231, 0.88);
    }

    .slide__inner--rose {
      background: linear-gradient(145deg, #fff 0%, rgba(200, 141, 141, 0.12) 100%);
    }
    .slide__inner--sauge {
      background: linear-gradient(145deg, #fff 0%, rgba(143, 168, 146, 0.18) 100%);
    }
    .slide__inner--bleu {
      background: linear-gradient(145deg, #fff 0%, rgba(69, 123, 157, 0.12) 100%);
    }
    .slide__inner--jaune {
      background: linear-gradient(145deg, #fff 0%, rgba(233, 196, 106, 0.2) 100%);
    }

    .slide__inner--split {
      display: grid;
      gap: 1.25rem;
      align-items: stretch;
      min-height: 0;
    }

    @media (min-width: 768px) {
      .slide__inner--split {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(1.5rem, 3vw, 2.5rem);
      }
    }

    .slide__split-text {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-width: 0;
      min-height: 0;
    }

    .slide__media {
      overflow: hidden;
      border-radius: 1rem;
      border: 1px solid rgba(29, 53, 87, 0.1);
      line-height: 0;
      min-height: clamp(14rem, 40vh, 24rem);
      display: flex;
      align-items: stretch;
      justify-content: center;
    }

    @media (min-width: 768px) {
      .slide__media {
        min-height: 0;
        height: 100%;
        max-height: none;
      }
    }

    .slide__media img {
      width: 100%;
      height: 100%;
      min-height: inherit;
      display: block;
    }

    .slide__media--contain {
      background: rgba(255, 255, 255, 0.65);
    }

    .slide__media--tile {
      min-height: clamp(8.5rem, 20vh, 12rem);
      aspect-ratio: 4 / 3;
    }

    @media (min-width: 640px) {
      .slide__media--tile {
        min-height: 0;
        flex: 1;
      }
    }

    .slide__inner--mosaic {
      justify-content: flex-start;
      gap: clamp(0.75rem, 2vw, 1.25rem);
      overflow: auto;
    }

    .slide__mosaic-head {
      flex-shrink: 0;
    }

    .slide__mosaic-grid {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.85rem;
      flex: 1;
      min-height: 0;
    }

    @media (min-width: 640px) {
      .slide__mosaic-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(0.85rem, 2vw, 1.25rem);
        align-items: stretch;
      }
    }

    .slide__mosaic-tile {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      min-width: 0;
      height: 100%;
    }

    .slide__mosaic-title {
      font-family: "Playfair Display", Georgia, serif;
      font-size: clamp(0.9rem, 2.2vw, 1rem);
      font-weight: 700;
      color: #1d3557;
      line-height: 1.25;
    }

    .slide__mosaic-text {
      font-size: clamp(0.72rem, 1.8vw, 0.82rem);
      line-height: 1.4;
      color: rgba(29, 53, 87, 0.78);
    }

    .slide__inner--contact .slide__contact-list {
      max-width: none;
    }

    .slide__inner--contact .slide__contact-list li {
      text-align: left;
    }

    .slide__cta-row--left {
      justify-content: flex-start;
    }

    .slide__inner--compare {
      justify-content: center;
      gap: clamp(0.85rem, 2vw, 1.35rem);
      overflow: auto;
    }

    .slide__compare-head {
      flex-shrink: 0;
      text-align: center;
    }

    .slide__title--center {
      text-align: center;
    }

    .slide__compare-headline {
      margin: 0.75rem auto 0;
      max-width: 40rem;
      padding: clamp(0.85rem, 2vw, 1.1rem) clamp(1rem, 3vw, 1.5rem);
      border-radius: 1rem;
      background: rgba(29, 53, 87, 0.06);
      border-left: 4px solid #8fa892;
      font-family: "Playfair Display", Georgia, serif;
      font-size: clamp(0.95rem, 2.4vw, 1.15rem);
      font-weight: 700;
      font-style: italic;
      line-height: 1.45;
      color: #1d3557;
      text-align: left;
    }

    .slide__compare-intro {
      margin: 0.65rem auto 0;
      max-width: 36rem;
      font-size: clamp(0.85rem, 2vw, 0.98rem);
      line-height: 1.5;
      color: rgba(29, 53, 87, 0.72);
      text-align: center;
    }

    .slide__compare-table {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      border-radius: 1rem;
      border: 1px solid rgba(29, 53, 87, 0.12);
      overflow: hidden;
      background: rgba(255, 255, 255, 0.65);
    }

    .slide__compare-table-head,
    .slide__compare-table-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .slide__compare-table-th {
      padding: clamp(0.55rem, 1.4vw, 0.75rem) clamp(0.65rem, 1.8vw, 1rem);
      font-size: clamp(0.62rem, 1.5vw, 0.72rem);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      text-align: center;
    }

    .slide__compare-table-th--before {
      background: rgba(200, 141, 141, 0.2);
      color: #a86b6b;
      border-right: 1px solid rgba(29, 53, 87, 0.08);
    }

    .slide__compare-table-th--after {
      background: rgba(143, 168, 146, 0.28);
      color: #5a7a5e;
    }

    .slide__compare-table-row {
      flex: 1;
      border-top: 1px solid rgba(29, 53, 87, 0.08);
    }

    .slide__compare-table-row:nth-child(even) .slide__compare-table-cell--before {
      background: rgba(200, 141, 141, 0.06);
    }

    .slide__compare-table-row:nth-child(even) .slide__compare-table-cell--after {
      background: rgba(143, 168, 146, 0.08);
    }

    .slide__compare-table-cell {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      padding: clamp(0.5rem, 1.3vw, 0.7rem) clamp(0.65rem, 1.8vw, 1rem);
      font-size: clamp(0.72rem, 1.7vw, 0.84rem);
      line-height: 1.38;
      color: rgba(29, 53, 87, 0.92);
    }

    .slide__compare-table-cell--before {
      border-right: 1px solid rgba(29, 53, 87, 0.08);
    }

    .slide__compare-mark {
      flex-shrink: 0;
      width: 1.35rem;
      height: 1.35rem;
      border-radius: 9999px;
      display: grid;
      place-items: center;
      font-size: 0.65rem;
      font-weight: 800;
    }

    .slide__compare-mark--before {
      background: rgba(200, 141, 141, 0.25);
      color: #c88d8d;
