    @media (max-width: 560px) {
      .slide__compare-table-head {
        display: none;
      }

      .slide__compare-table-row {
        grid-template-columns: 1fr;
      }

      .slide__compare-table-cell--before {
        border-right: none;
        border-bottom: 1px dashed rgba(200, 141, 141, 0.35);
        background: rgba(200, 141, 141, 0.08);
      }

      .slide__compare-table-cell--after {
