    }

    .slide__list {
      margin-top: 1.25rem;
      display: grid;
      gap: 0.65rem;
      list-style: none;
      padding: 0;
      max-width: 42rem;
    }

    .slide__list li {
      position: relative;
      padding-left: 1.35rem;
      font-size: clamp(0.9rem, 2.6vw, 1.05rem);
      line-height: 1.45;
      color: rgba(29, 53, 87, 0.88);
    }

    .slide__list li::before {
      content: "✿";
      position: absolute;
      left: 0;
      color: #c88d8d;
      font-size: 0.85em;
    }

    .slide__list--compact {
      margin-top: 1rem;
