    }

    .slide__inner--contact {
      background: linear-gradient(160deg, rgba(200, 141, 141, 0.12) 0%, #fff 55%, rgba(143, 168, 146, 0.1) 100%);
    }

    .slide__logo {
      width: clamp(5rem, 18vw, 8.5rem);
