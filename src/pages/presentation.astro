---
import SlideLayout from "@/layouts/SlideLayout.astro";
import { LOGO_SRC } from "@/lib/brand";
import {
  PRESENTATION_PPTX_HREF,
  presentationSlides as slides,
} from "@/lib/presentation-slides";

const title = "Présentation — Le Sourire de Jojo";
---

<SlideLayout title={title}>
  <div class="deck" id="slide-deck" data-total={slides.length}>
    <header class="deck__chrome">
      <a href="/" class="deck__exit" title="Quitter la présentation">← Site</a>
      <span class="deck__counter" id="slide-counter" aria-live="polite">1 / {slides.length}</span>
      <div class="deck__chrome-actions">
        <a href={PRESENTATION_PPTX_HREF} class="deck__dl" download title="Télécharger le PowerPoint original">PPTX</a>
        <button type="button" class="deck__fs" id="slide-fullscreen" aria-label="Plein écran">⛶</button>
      </div>
    </header>

    <div class="deck__stage" id="slide-stage">
      {
        slides.map((slide, index) => (
          <section
            class:list={["slide", index === 0 && "is-active"]}
            data-slide={index}
            data-kind={slide.kind}
            aria-hidden={index === 0 ? "false" : "true"}
            aria-label={`Diapositive ${index + 1} sur ${slides.length}`}
          >
            {slide.kind === "hero" && (
              <div class:list={["slide__inner", "slide__inner--hero", slide.image && "slide__inner--hero-photo"]}>
                {slide.image ? (
                  <img src={slide.image} alt={slide.imageAlt ?? ""} class="slide__hero-bg" loading="eager" decoding="async" />
                ) : (
                  <img src={LOGO_SRC} alt="" class="slide__logo" width="160" height="160" />
                )}
                <div class="slide__hero-content">
                  <h1 class="slide__hero-title">{slide.title}</h1>
                  <p class="slide__hero-sub">{slide.subtitle}</p>
                  {slide.tagline && <p class="slide__hero-tag">{slide.tagline}</p>}
                </div>
              </div>
            )}

            {slide.kind === "bullets" && (
              <div
                class:list={[
                  "slide__inner",
                  slide.accent && `slide__inner--${slide.accent}`,
                  slide.image && "slide__inner--bullets-photo",
                ]}
              >
                <div class="slide__bullets-main">
                  <p class="slide__kicker">Diapositive {index + 1}</p>
                  <h2 class="slide__title">{slide.title}</h2>
                  {slide.intro && <p class="slide__intro">{slide.intro}</p>}
                  <ul class="slide__list">
                    {slide.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                {slide.image && (
                  <div class="slide__bullets-media">
                    <img src={slide.image} alt={slide.imageAlt ?? ""} loading="lazy" decoding="async" />
                  </div>
                )}
              </div>
            )}

            {slide.kind === "split" && (
              <div class="slide__inner slide__inner--split">
                <div class="slide__split-text">
                  <p class="slide__kicker">Diapositive {index + 1}</p>
                  <h2 class="slide__title">{slide.title}</h2>
                  <p class="slide__intro">{slide.text}</p>
                </div>
                <div class="slide__split-media">
                  <img src={slide.image} alt={slide.imageAlt} loading="lazy" decoding="async" />
                </div>
              </div>
            )}

            {slide.kind === "compare" && (
              <div class="slide__inner slide__inner--compare">
                <p class="slide__kicker">Diapositive {index + 1}</p>
                <h2 class="slide__title">{slide.title}</h2>
                <div class="slide__compare-grid">
                  <div class="slide__compare-col slide__compare-col--before">
                    <h3>{slide.leftTitle}</h3>
                    <ul>
                      {slide.leftItems.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                  <div class="slide__compare-col slide__compare-col--after">
                    <h3>{slide.rightTitle}</h3>
                    <ul>
                      {slide.rightItems.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                </div>
                {slide.footer && <p class="slide__compare-footer">{slide.footer}</p>}
              </div>
            )}

            {slide.kind === "table" && (
              <div class="slide__inner slide__inner--table">
                <p class="slide__kicker">Diapositive {index + 1}</p>
                <h2 class="slide__title">{slide.title}</h2>
                {slide.intro && <p class="slide__intro">{slide.intro}</p>}
                <div class="slide__table-wrap">
                  <table class="slide__table">
                    <thead>
                      <tr>
                        {slide.headers.map((h) => (
                          <th scope="col">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {slide.rows.map((row) => (
                        <tr>
                          {row.map((cell) => (
                            <td>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {slide.note && <p class="slide__table-note">{slide.note}</p>}
              </div>
            )}

            {slide.kind === "contact" && (
              <div class="slide__inner slide__inner--cta">
                <h2 class="slide__title">{slide.title}</h2>
                <p class="slide__intro">{slide.text}</p>
                <ul class="slide__contact-list">
                  <li>
                    <span class="slide__contact-label">Téléphone</span>
                    <a href={`tel:${slide.phone.replace(/\s/g, "")}`} class="slide__contact-value">{slide.phone}</a>
                  </li>
                  <li>
                    <span class="slide__contact-label">Site web</span>
                    <a href={slide.siteHref} class="slide__contact-value">{slide.siteLabel}</a>
                  </li>
                  <li>
                    <span class="slide__contact-label">Zone</span>
                    <span class="slide__contact-value">{slide.location}</span>
                  </li>
                </ul>
                <div class="slide__cta-row">
                  <a href="/contact#formulaire" class="slide__btn slide__btn--primary">Nous contacter</a>
                  <a href="/offres" class="slide__btn slide__btn--ghost">Voir les offres</a>
                </div>
              </div>
            )}
          </section>
        ))
      }
    </div>

    <nav class="deck__nav" aria-label="Navigation des diapositives">
      <button type="button" class="deck__arrow" id="slide-prev" aria-label="Diapositive précédente" disabled>
        ‹
      </button>
      <div class="deck__dots" id="slide-dots" role="tablist" aria-label="Aller à une diapositive">
        {
          slides.map((_, index) => (
            <button
              type="button"
              class:list={["deck__dot", index === 0 && "is-active"]}
              data-goto={index}
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-label={`Diapositive ${index + 1}`}
            />
          ))
        }
      </div>
      <button type="button" class="deck__arrow" id="slide-next" aria-label="Diapositive suivante">
        ›
      </button>
    </nav>

    <p class="deck__hint" id="slide-hint">← → ou glisser · Espace · Échap pour quitter</p>
  </div>

  <style>
    .deck {
      position: relative;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      padding:
        max(0.5rem, env(safe-area-inset-top))
        max(0.75rem, env(safe-area-inset-right))
        max(0.5rem, env(safe-area-inset-bottom))
        max(0.75rem, env(safe-area-inset-left));
    }

    .deck__chrome {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.25rem 0.25rem 0.5rem;
      z-index: 20;
    }

    .deck__exit,
    .deck__fs,
    .deck__dl {
      font-size: 0.8125rem;
      font-weight: 600;
      color: #1d3557;
      background: rgba(255, 255, 255, 0.85);
      border: 1px solid rgba(29, 53, 87, 0.12);
      border-radius: 9999px;
      padding: 0.45rem 0.85rem;
      transition: background 0.2s;
    }

    .deck__chrome-actions {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .deck__dl {
      text-decoration: none;
    }

    .deck__dl:hover {
      background: #fff;
    }

    .deck__fs {
      width: 2.25rem;
      height: 2.25rem;
      padding: 0;
      display: grid;
      place-items: center;
      border-radius: 0.65rem;
    }

    .deck__exit:hover,
    .deck__fs:hover {
      background: #fff;
    }

    .deck__counter {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(29, 53, 87, 0.55);
    }

    .deck__stage {
      position: relative;
      flex: 1;
      min-height: 0;
    }

    .slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      visibility: hidden;
      transform: translateX(2rem) scale(0.98);
      transition:
        opacity 0.38s ease,
        transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0.38s;
      pointer-events: none;
    }

    .slide.is-active {
      opacity: 1;
      visibility: visible;
      transform: translateX(0) scale(1);
      pointer-events: auto;
      z-index: 1;
    }

    .slide.is-leaving {
      transform: translateX(-2rem) scale(0.98);
      opacity: 0;
    }

    .slide__inner {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-radius: 1.25rem;
      border: 1px solid rgba(29, 53, 87, 0.1);
      background: linear-gradient(145deg, #ffffff 0%, #f9f8f5 45%, #f5f3e7 100%);
      box-shadow: 0 20px 50px -28px rgba(29, 53, 87, 0.35);
      padding: clamp(1.25rem, 4vw, 2.5rem);
      overflow: auto;
    }

    .slide__inner--hero {
      align-items: center;
      text-align: center;
      background: linear-gradient(160deg, #ffffff 0%, rgba(143, 168, 146, 0.18) 50%, rgba(200, 141, 141, 0.12) 100%);
    }

    .slide__inner--hero-photo {
      position: relative;
      padding: 0;
      overflow: hidden;
      justify-content: flex-end;
    }

    .slide__hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .slide__hero-content {
      position: relative;
      z-index: 1;
      margin-top: auto;
      width: 100%;
      padding: clamp(1.25rem, 4vw, 2rem);
      background: linear-gradient(to top, rgba(29, 53, 87, 0.88) 0%, rgba(29, 53, 87, 0.55) 55%, transparent 100%);
      color: #f5f3e7;
      text-align: left;
    }

    .slide__inner--hero-photo .slide__hero-title,
    .slide__inner--hero-photo .slide__hero-sub {
      color: #f5f3e7;
    }

    .slide__inner--hero-photo .slide__hero-tag {
      color: rgba(245, 243, 231, 0.88);
    }

    .slide__inner--rose {
      background: linear-gradient(145deg, #fff 0%, rgba(200, 141, 141, 0.12) 100%);
    }
    .slide__inner--sauge {
      background: linear-gradient(145deg, #fff 0%, rgba(143, 168, 146, 0.18) 100%);
    }
    .slide__inner--bleu {
      background: linear-gradient(145deg, #fff 0%, rgba(69, 123, 157, 0.12) 100%);
    }
    .slide__inner--jaune {
      background: linear-gradient(145deg, #fff 0%, rgba(233, 196, 106, 0.2) 100%);
    }

    .slide__inner--split {
      display: grid;
      gap: 1.25rem;
      align-items: center;
    }

    .slide__inner--bullets-photo {
      display: grid;
      gap: 1.25rem;
      align-items: center;
    }

    @media (min-width: 768px) {
      .slide__inner--split,
      .slide__inner--bullets-photo {
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
      }
    }

    .slide__bullets-media {
      overflow: hidden;
      border-radius: 1rem;
      border: 1px solid rgba(29, 53, 87, 0.1);
      line-height: 0;
      max-height: min(38vh, 18rem);
    }

    .slide__bullets-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .slide__inner--compare {
      justify-content: flex-start;
    }

    .slide__compare-grid {
      margin-top: 1rem;
      display: grid;
      gap: 0.75rem;
    }

    @media (min-width: 640px) {
      .slide__compare-grid {
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }
    }

    .slide__compare-col {
      border-radius: 1rem;
      padding: 0.85rem 1rem;
      border: 1px solid rgba(29, 53, 87, 0.1);
    }

    .slide__compare-col h3 {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 0.5rem;
    }

    .slide__compare-col ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.45rem;
    }

    .slide__compare-col li {
      font-size: 0.78rem;
      line-height: 1.4;
      color: rgba(29, 53, 87, 0.88);
      padding-left: 0.9rem;
      position: relative;
    }

    .slide__compare-col li::before {
      content: "•";
      position: absolute;
      left: 0;
    }

    .slide__compare-col--before {
      background: rgba(200, 141, 141, 0.1);
    }

    .slide__compare-col--after {
      background: rgba(143, 168, 146, 0.18);
    }

    .slide__compare-col--before h3 {
      color: #c88d8d;
    }

    .slide__compare-col--after h3 {
      color: #457b9d;
    }

    .slide__compare-footer {
      margin-top: 0.85rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: rgba(29, 53, 87, 0.82);
      line-height: 1.45;
    }

    .slide__inner--table {
      justify-content: flex-start;
    }

    .slide__table-wrap {
      margin-top: 0.85rem;
      overflow: auto;
      border-radius: 0.85rem;
      border: 1px solid rgba(29, 53, 87, 0.12);
      -webkit-overflow-scrolling: touch;
    }

    .slide__table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.72rem;
      min-width: 20rem;
    }

    @media (min-width: 640px) {
      .slide__table {
        font-size: 0.8rem;
      }
    }

    .slide__table th,
    .slide__table td {
      padding: 0.45rem 0.55rem;
      text-align: left;
      border-bottom: 1px solid rgba(29, 53, 87, 0.08);
    }

    .slide__table th {
      background: rgba(29, 53, 87, 0.08);
      font-weight: 700;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .slide__table tbody tr:nth-child(even) {
      background: rgba(255, 255, 255, 0.55);
    }

    .slide__table-note {
      margin-top: 0.65rem;
      font-size: 0.72rem;
      color: rgba(29, 53, 87, 0.65);
      line-height: 1.4;
    }

    .slide__contact-list {
      margin-top: 1.25rem;
      list-style: none;
      padding: 0;
      display: grid;
      gap: 0.75rem;
      width: 100%;
      max-width: 22rem;
    }

    .slide__contact-list li {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      text-align: center;
    }

    .slide__contact-label {
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: rgba(29, 53, 87, 0.5);
    }

    .slide__contact-value {
      font-size: 1.05rem;
      font-weight: 600;
      color: #1d3557;
      text-decoration: none;
    }

    a.slide__contact-value:hover {
      color: #457b9d;
      text-decoration: underline;
    }

    .slide__inner--cta {
      align-items: center;
      text-align: center;
      background: linear-gradient(160deg, rgba(200, 141, 141, 0.15) 0%, #fff 55%, rgba(143, 168, 146, 0.12) 100%);
    }

    .slide__logo {
      width: clamp(5rem, 18vw, 8.5rem);
      height: auto;
      margin-bottom: 1rem;
      filter: drop-shadow(0 8px 20px rgba(29, 53, 87, 0.12));
    }

    .slide__hero-title {
      font-family: "Dancing Script", cursive;
      font-size: clamp(2.5rem, 9vw, 4.5rem);
      line-height: 1.05;
      color: #1d3557;
    }

    .slide__hero-sub {
      margin-top: 0.5rem;
      font-family: "Playfair Display", Georgia, serif;
      font-size: clamp(1.15rem, 3.5vw, 1.75rem);
      color: rgba(29, 53, 87, 0.88);
    }

    .slide__hero-tag {
      margin-top: 1.25rem;
      max-width: 36rem;
      font-size: clamp(0.9rem, 2.5vw, 1.05rem);
      line-height: 1.55;
      color: rgba(29, 53, 87, 0.72);
    }

    .slide__kicker {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(29, 53, 87, 0.45);
      margin-bottom: 0.65rem;
    }

    .slide__title {
      font-family: "Dancing Script", cursive;
      font-size: clamp(1.85rem, 6vw, 3rem);
      line-height: 1.1;
      color: #1d3557;
    }

    .slide__intro {
      margin-top: 0.85rem;
      max-width: 40rem;
      font-size: clamp(0.95rem, 2.8vw, 1.1rem);
      line-height: 1.55;
      color: rgba(29, 53, 87, 0.82);
    }

    .slide__list {
      margin-top: 1.25rem;
      display: grid;
      gap: 0.65rem;
      list-style: none;
      padding: 0;
      max-width: 42rem;
    }

    .slide__list li {
      position: relative;
      padding-left: 1.35rem;
      font-size: clamp(0.9rem, 2.6vw, 1.05rem);
      line-height: 1.45;
      color: rgba(29, 53, 87, 0.88);
    }

    .slide__list li::before {
      content: "✿";
      position: absolute;
      left: 0;
      color: #c88d8d;
      font-size: 0.85em;
    }

    .slide__list--compact {
      margin-top: 1rem;
      justify-items: center;
    }

    .slide__split-media {
      overflow: hidden;
      border-radius: 1rem;
      border: 1px solid rgba(29, 53, 87, 0.1);
      line-height: 0;
      max-height: min(42vh, 22rem);
    }

    .slide__split-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .slide__cta-row {
      margin-top: 1.75rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      justify-content: center;
    }

    .slide__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      padding: 0.65rem 1.35rem;
      border-radius: 0.85rem;
      font-weight: 700;
      font-size: 0.95rem;
      transition: transform 0.15s, background 0.2s;
    }

    .slide__btn:active {
      transform: scale(0.98);
    }

    .slide__btn--primary {
      background: #1d3557;
      color: #f5f3e7;
      box-shadow: 0 8px 24px -8px rgba(29, 53, 87, 0.5);
    }

    .slide__btn--primary:hover {
      background: rgba(29, 53, 87, 0.9);
    }

    .slide__btn--ghost {
      border: 2px solid #1d3557;
      color: #1d3557;
      background: rgba(255, 255, 255, 0.9);
    }

    .deck__nav {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding: 0.65rem 0 0.25rem;
      z-index: 20;
    }

    .deck__arrow {
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 9999px;
      border: 1px solid rgba(29, 53, 87, 0.15);
      background: rgba(255, 255, 255, 0.92);
      color: #1d3557;
      font-size: 1.75rem;
      line-height: 1;
      display: grid;
      place-items: center;
      transition: opacity 0.2s, background 0.2s;
    }

    .deck__arrow:hover:not(:disabled) {
      background: #fff;
    }

    .deck__arrow:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .deck__dots {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.35rem;
      max-width: min(100%, 16rem);
    }

    .deck__dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 9999px;
      background: rgba(29, 53, 87, 0.2);
      border: none;
      padding: 0;
      transition: transform 0.2s, background 0.2s;
    }

    .deck__dot.is-active {
      background: #1d3557;
      transform: scale(1.25);
    }

    .deck__hint {
      text-align: center;
      font-size: 0.65rem;
      color: rgba(29, 53, 87, 0.45);
      padding-bottom: 0.15rem;
    }

    @media (max-width: 640px) {
      .deck__hint {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .slide {
        transition: none;
        transform: none;
      }
    }
  </style>

  <script>
    (function () {
      const deck = document.getElementById("slide-deck");
      const stage = document.getElementById("slide-stage");
      if (!deck || !stage) return;

      const slides = Array.from(stage.querySelectorAll<HTMLElement>("[data-slide]"));
      const total = slides.length;
      const counter = document.getElementById("slide-counter");
      const prevBtn = document.getElementById("slide-prev") as HTMLButtonElement | null;
      const nextBtn = document.getElementById("slide-next") as HTMLButtonElement | null;
      const dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".deck__dot"));
      const fsBtn = document.getElementById("slide-fullscreen");

      let current = 0;
      let touchStartX = 0;
      let touchStartY = 0;

      function parseHash(): number {
        const m = window.location.hash.match(/^#slide-(\d+)$/);
        if (!m) return 0;
        const n = parseInt(m[1]!, 10) - 1;
        return Number.isFinite(n) ? Math.max(0, Math.min(n, total - 1)) : 0;
      }

      function updateUI() {
        slides.forEach((slide, i) => {
          const active = i === current;
          slide.classList.toggle("is-active", active);
          slide.setAttribute("aria-hidden", active ? "false" : "true");
        });

        dots.forEach((dot, i) => {
          const active = i === current;
          dot.classList.toggle("is-active", active);
          dot.setAttribute("aria-selected", active ? "true" : "false");
        });

        if (counter) counter.textContent = `${current + 1} / ${total}`;
        if (prevBtn) prevBtn.disabled = current === 0;
        if (nextBtn) nextBtn.disabled = current === total - 1;

        history.replaceState(null, "", `#slide-${current + 1}`);
      }

      function goTo(index: number) {
        const next = Math.max(0, Math.min(index, total - 1));
        if (next === current) return;

        const leaving = slides[current];
        leaving?.classList.add("is-leaving");
        window.setTimeout(() => leaving?.classList.remove("is-leaving"), 380);

        current = next;
        updateUI();
      }

      prevBtn?.addEventListener("click", () => goTo(current - 1));
      nextBtn?.addEventListener("click", () => goTo(current + 1));

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const idx = parseInt(dot.dataset.goto ?? "0", 10);
          goTo(idx);
        });
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === " " || e.key === "PageDown") {
          e.preventDefault();
          goTo(current + 1);
        } else if (e.key === "ArrowLeft" || e.key === "PageUp") {
          e.preventDefault();
          goTo(current - 1);
        } else if (e.key === "Home") {
          e.preventDefault();
          goTo(0);
        } else if (e.key === "End") {
          e.preventDefault();
          goTo(total - 1);
        } else if (e.key === "Escape") {
          window.location.href = "/";
        }
      });

      stage.addEventListener(
        "touchstart",
        (e) => {
          const t = e.changedTouches[0];
          if (!t) return;
          touchStartX = t.clientX;
          touchStartY = t.clientY;
        },
        { passive: true },
      );

      stage.addEventListener(
        "touchend",
        (e) => {
          const t = e.changedTouches[0];
          if (!t) return;
          const dx = t.clientX - touchStartX;
          const dy = t.clientY - touchStartY;
          if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy)) return;
          if (dx < 0) goTo(current + 1);
          else goTo(current - 1);
        },
        { passive: true },
      );

      fsBtn?.addEventListener("click", async () => {
        try {
          if (!document.fullscreenElement) await deck.requestFullscreen();
          else await document.exitFullscreen();
        } catch {
          /* ignore */
        }
      });

      window.addEventListener("hashchange", () => {
        goTo(parseHash());
      });

      current = parseHash();
      updateUI();
    })();
  </script>
</SlideLayout>
