---
import BaseLayout from "@/layouts/BaseLayout.astro";

const user = Astro.locals.user!;
const title = `Mon carnet en ligne — ${user.name}`;

let entries: { id: string; title: string; content: string; createdAt: Date }[] = [];
try {
  const { connectDb } = await import("@/lib/db");
  const { CarnetEntry } = await import("@/models/CarnetEntry");
  await connectDb();
  const rows = await CarnetEntry.find({ userId: user.id }).sort({ createdAt: -1 }).limit(30).lean();
  entries = rows.map((e) => ({
    id: String(e._id),
    title: e.title,
    content: e.content,
    createdAt: e.createdAt as Date,
  }));
} catch {
  entries = [];
}

function formatDate(d: Date) {
  return new Intl.DateTimeFormat("fr-FR", { dateStyle: "long" }).format(d);
}
---

<BaseLayout
  title={title}
  description="Carnet de sourires en ligne — espace famille."
  breadcrumb={[
    { href: "/", label: "Accueil" },
    { href: "/compte", label: "Mon compte" },
    { label: "Carnet en ligne" },
  ]}
>
  <div class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16" data-reveal-skip>
    <h1 class="font-display text-4xl text-marine">Mon carnet en ligne</h1>
    <p class="mt-4 text-marine/85 leading-relaxed">
      Entrées privées liées à votre compte famille. Seules les personnes connectées à ce compte y ont accès.
    </p>

    <form id="carnet-form" class="mt-10 space-y-4 rounded-2xl border border-marine/15 bg-white/90 p-6 shadow-sm">
      <h2 class="font-display text-xl text-marine">Ajouter un sourire</h2>
      <div>
        <label for="carnet-title" class="block text-sm font-medium text-marine">Titre</label>
        <input
          id="carnet-title"
          name="title"
          type="text"
          required
          maxlength="200"
          placeholder="Ex. : Belle après-midi jeux de société"
          class="mt-1 w-full rounded-lg border border-marine/25 bg-ivoire px-3 py-2 text-marine focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30"
        />
      </div>
      <div>
        <label for="carnet-content" class="block text-sm font-medium text-marine">Contenu</label>
        <textarea
          id="carnet-content"
          name="content"
          required
          rows="5"
          maxlength="8000"
          placeholder="Souvenir, préférence, message pour la famille…"
          class="mt-1 w-full rounded-lg border border-marine/25 bg-ivoire px-3 py-2 text-marine focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30"
        ></textarea>
      </div>
      <button type="submit" class="rounded-xl bg-marine px-6 py-3 font-semibold text-ivoire shadow hover:bg-marine/90">
        Enregistrer
      </button>
      <p id="carnet-status" class="text-sm text-marine/80" role="status"></p>
    </form>

    <section class="mt-14" aria-labelledby="entries-title">
      <h2 id="entries-title" class="font-display text-2xl text-marine">Vos entrées</h2>
      {
        entries.length === 0 ? (
          <p class="mt-6 rounded-2xl border border-dashed border-marine/25 bg-cream/60 p-6 text-marine/75">
            Aucune entrée pour l’instant. Ajoutez le premier sourire ci-dessus.
          </p>
        ) : (
          <ul id="entries-list" class="mt-6 space-y-4">
            {entries.map((entry) => (
              <li class="rounded-2xl border border-marine/15 bg-white/95 p-6 shadow-sm">
                <p class="text-xs font-semibold uppercase tracking-wide text-marine/55">{formatDate(entry.createdAt)}</p>
                <h3 class="mt-2 font-display text-xl text-marine">{entry.title}</h3>
                <p class="mt-3 whitespace-pre-wrap text-marine/85 leading-relaxed">{entry.content}</p>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <p class="mt-10">
      <a href="/compte" class="font-medium text-aquarelle-bleu underline underline-offset-2 hover:text-marine">
        ← Retour à mon compte
      </a>
    </p>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById("carnet-form") as HTMLFormElement | null;
  const status = document.getElementById("carnet-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !status) return;
    status.textContent = "Enregistrement…";
    const fd = new FormData(form);
    try {
      const res = await fetch("/api/carnet/entries", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          title: String(fd.get("title") ?? ""),
          content: String(fd.get("content") ?? ""),
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        status.textContent = data.error ?? "Enregistrement impossible.";
        return;
      }
      status.textContent = "Entrée enregistrée.";
      window.location.reload();
    } catch {
      status.textContent = "Erreur réseau.";
    }
  });
</script>
