---
import AuthLayout from "@/layouts/AuthLayout.astro";
import AuthField from "@/components/espace/AuthField.astro";
import { isDbConfigured } from "@/lib/db-config";
import { findValidInvitation } from "@/lib/family-space";

const dbReady = isDbConfigured();
const invitationToken = Astro.url.searchParams.get("invitation") ?? "";
const invitation = dbReady && invitationToken ? await findValidInvitation(invitationToken) : null;
const rawNext = Astro.url.searchParams.get("next") ?? "";
// Seulement des chemins internes (jamais « //autre-site »).
const next = /^\/(?!\/)/.test(rawNext) ? rawNext : "/compte";
const reset = Astro.url.searchParams.has("motdepasse");
---

<AuthLayout title="Connexion — Espace familles" heading="Bon retour !" intro="Espace familles du Sourire de Jojo">
  {
    invitation && (
      <p class="mt-5 rounded-2xl bg-sauge/20 p-4 text-center text-base text-marine">
        Vous êtes invité·e au dossier de <strong>{invitation.dossierName}</strong>. Connectez-vous : l’accès sera ajouté
        automatiquement.
      </p>
    )
  }
  {reset && <p class="mt-5 rounded-2xl bg-sauge/20 p-4 text-center text-base text-marine">Mot de passe changé. Vous pouvez vous connecter.</p>}
  {
    !dbReady && (
      <p class="mt-5 rounded-2xl bg-rose-vieux/15 p-4 text-center text-base text-marine">
        L’espace familles n’est pas encore ouvert. Il le sera très bientôt !
      </p>
    )
  }

  <form id="login-form" data-invitation={invitationToken} data-next={next} class="mt-6 space-y-4" novalidate>
    <AuthField id="login-email" name="email" type="email" label="Votre e-mail" icon="mail" autocomplete="email" placeholder="prenom@exemple.fr" />
    <AuthField id="login-password" name="password" type="password" label="Mot de passe" icon="lock" autocomplete="current-password" />
    <p class="text-right">
      <a href="/compte/mot-de-passe-oublie" class="inline-flex min-h-[44px] items-center text-base font-semibold text-aquarelle-bleu underline-offset-4 hover:underline">
        Mot de passe oublié ?
      </a>
    </p>
    <button
      type="submit"
      disabled={!dbReady}
      class="h-14 w-full rounded-full bg-gradient-to-r from-marine via-[#2B4A72] to-[#3E6A8F] text-lg font-bold text-white shadow-[0_14px_28px_rgba(29,53,87,0.3),inset_0_1px_0_rgba(255,255,255,0.2)] transition hover:brightness-110 disabled:opacity-60"
    >
      Se connecter
    </button>
    <p data-status class="min-h-[1.5rem] text-center text-base text-marine/80" role="status" aria-live="polite"></p>
  </form>

  <div class="mt-4 border-t border-marine/10 pt-5 text-center text-base text-marine/75">
    <p>Pas encore de compte ? Il se crée avec le lien d’invitation envoyé par Céline.</p>
    {
      invitation && (
        <a href={`/compte/inscription?invitation=${encodeURIComponent(invitationToken)}`} class="mt-2 inline-flex min-h-[44px] items-center font-semibold text-aquarelle-bleu underline underline-offset-4">
          Créer mon compte avec cette invitation
        </a>
      )
    }
  </div>
</AuthLayout>

<script>
  import { wireAuthForm } from "@/scripts/auth-forms";

  wireAuthForm({
    formId: "login-form",
    endpoint: "/api/auth/login",
    pending: "Connexion…",
    fallbackError: "Connexion impossible.",
    body: (fd, form) => ({
      email: String(fd.get("email") ?? ""),
      password: String(fd.get("password") ?? ""),
      invitation: form.dataset.invitation || undefined,
    }),
    onSuccess: (_r, form) => {
      window.location.href = form.dataset.invitation ? "/compte" : form.dataset.next || "/compte";
    },
  });
</script>
