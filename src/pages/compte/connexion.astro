---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { isDbConfigured } from "@/lib/db-config";

const title = "Connexion — Mon compte";
const description = "Espace famille — connexion au carnet de sourires en ligne.";
const dbReady = isDbConfigured();
---

<BaseLayout
  title={title}
  description={description}
  breadcrumb={[{ href: "/", label: "Accueil" }, { href: "/compte", label: "Mon compte" }, { label: "Connexion" }]}
>
  <div class="mx-auto max-w-md px-4 py-12 md:px-6 md:py-16" data-reveal-skip>
    <h1 class="font-display text-4xl text-marine">Connexion</h1>
    <p class="mt-4 text-marine/85 leading-relaxed">
      Accédez à votre espace famille et au carnet de sourires en ligne.
    </p>

    {
      !dbReady && (
        <div class="mt-8 rounded-2xl border border-rose-vieux/30 bg-rose-vieux/10 p-5 text-sm text-marine/85">
          Les comptes ne sont pas encore activés sur ce serveur (base de données à configurer). Contactez l’administratrice du
          site.
        </div>
      )
    }

    <form id="login-form" class="mt-8 space-y-5 rounded-2xl border border-marine/15 bg-white/90 p-6 shadow-sm" novalidate>
      <div>
        <label for="login-email" class="block text-sm font-medium text-marine">E-mail</label>
        <input
          id="login-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="mt-1 w-full rounded-lg border border-marine/25 bg-ivoire px-3 py-2 text-marine focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30"
        />
        <p class="mt-1 hidden text-sm text-red-800" data-error-for="email"></p>
      </div>
      <div>
        <label for="login-password" class="block text-sm font-medium text-marine">Mot de passe</label>
        <input
          id="login-password"
          name="password"
          type="password"
          required
          autocomplete="current-password"
          class="mt-1 w-full rounded-lg border border-marine/25 bg-ivoire px-3 py-2 text-marine focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30"
        />
        <p class="mt-1 hidden text-sm text-red-800" data-error-for="password"></p>
      </div>
      <button
        type="submit"
        class="w-full rounded-xl bg-marine px-6 py-3 font-semibold text-ivoire shadow hover:bg-marine/90 disabled:opacity-60"
        disabled={!dbReady}
      >
        Se connecter
      </button>
      <p id="login-status" class="text-sm text-marine/80" role="status"></p>
    </form>

    <p class="mt-8 text-center text-sm text-marine/75">
      Pas encore de compte ?
      <a href="/compte/inscription" class="font-medium text-aquarelle-bleu underline underline-offset-2 hover:text-marine">
        Créer un compte
      </a>
    </p>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement | null;
  const status = document.getElementById("login-status");

  function showErrors(errors: Record<string, string[] | undefined>) {
    document.querySelectorAll("[data-error-for]").forEach((el) => {
      el.classList.add("hidden");
      (el as HTMLElement).textContent = "";
    });
    for (const [key, msgs] of Object.entries(errors)) {
      const target = document.querySelector(`[data-error-for="${key}"]`);
      if (target && msgs?.[0]) {
        target.classList.remove("hidden");
        target.textContent = msgs[0];
      }
    }
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !status) return;
    status.textContent = "Connexion…";
    const fd = new FormData(form);
    try {
      const res = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: String(fd.get("email") ?? ""),
          password: String(fd.get("password") ?? ""),
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (data.errors) showErrors(data.errors);
        status.textContent = data.error ?? "Erreur de connexion.";
        return;
      }
      window.location.href = "/compte";
    } catch {
      status.textContent = "Erreur réseau.";
    }
  });
</script>
