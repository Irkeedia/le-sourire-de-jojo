---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { canAccessDossier, isAdmin, listPosts, MAX_PHOTOS_PER_POST } from "@/lib/family-space";
import { isDbConfigured } from "@/lib/db-config";
import { Dossier } from "@/models/Dossier";
import { Membership } from "@/models/Membership";
import { User } from "@/models/User";

const user = Astro.locals.user!;
const id = Astro.params.id ?? "";

// Cloisonnement : sans accès, on renvoie vers l'accueil de l'espace sans rien révéler.
if (!isDbConfigured() || !(await canAccessDossier(user, id))) {
  return Astro.redirect("/compte");
}

const admin = isAdmin(user);
const dossier = await Dossier.findById(id).lean();
const posts = await listPosts(id);

let members: { id: string; name: string; email: string }[] = [];
if (admin) {
  const links = await Membership.find({ dossierId: id }).lean();
  const users = await User.find({ _id: { $in: links.map((m) => m.userId) } }).sort({ name: 1 }).lean();
  members = users.map((u) => ({ id: String(u._id), name: u.name, email: u.email }));
}

const tz = "Europe/Paris";
const fmtDay = new Intl.DateTimeFormat("fr-FR", { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: tz });
const fmtStamp = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", hour: "2-digit", minute: "2-digit", timeZone: tz });
const today = new Intl.DateTimeFormat("en-CA", { timeZone: tz }).format(new Date());

const inputClass =
  "w-full rounded-xl border border-marine/25 bg-ivoire px-4 py-3 text-base text-marine focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30";
const primaryBtn =
  "min-h-[48px] rounded-xl bg-marine px-6 font-semibold text-ivoire shadow hover:bg-marine/90 disabled:opacity-60";
---

<BaseLayout
  title={`${dossier!.name} — Espace familles`}
  description="Dossier privé — Espace familles Le Sourire de Jojo."
  breadcrumb={[{ href: "/", label: "Accueil" }, { href: "/compte", label: "Espace familles" }, { label: dossier!.name }]}
  noindex
>
  <div
    class="mx-auto max-w-3xl px-4 py-10 md:px-6 md:py-14"
    data-reveal-skip
    data-dossier-root
    data-dossier-id={id}
    data-max-photos={MAX_PHOTOS_PER_POST}
  >
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-marine/55">Espace familles</p>
    <h1 class="mt-2 font-display text-4xl text-marine md:text-5xl">{dossier!.name}</h1>
    <p class="mt-3 text-marine/80">
      Ce dossier est privé : seuls Céline et les proches invités peuvent le voir.
    </p>

    {
      admin ? (
        <form id="visit-form" class="mt-8 space-y-5 rounded-2xl border border-marine/15 bg-white/95 p-5 shadow-sm md:p-6" novalidate>
          <h2 class="font-display text-2xl text-marine">Nouvelle visite</h2>
          <div>
            <label for="visit-date" class="block text-sm font-medium text-marine">Date de la visite</label>
            <input id="visit-date" name="visitDate" type="date" value={today} max={today} class:list={[inputClass, "mt-1"]} />
          </div>
          <div>
            <label for="visit-text" class="block text-sm font-medium text-marine">Votre mot pour la famille</label>
            <textarea
              id="visit-text"
              name="text"
              rows="5"
              maxlength="4000"
              placeholder="Ex. : Belle après-midi ! Nous avons fait une partie de cartes puis une petite promenade au soleil."
              class:list={[inputClass, "mt-1"]}
            />
          </div>
          <div>
            <label for="visit-photos" class="block text-sm font-medium text-marine">
              Photos et pages du carnet de sourires
            </label>
            <input
              id="visit-photos"
              name="photos"
              type="file"
              accept="image/*"
              multiple
              class="mt-1 block w-full text-sm text-marine file:mr-4 file:min-h-[44px] file:rounded-xl file:border-0 file:bg-sauge/30 file:px-4 file:font-semibold file:text-marine"
            />
            <p class="mt-1 text-xs text-marine/65">
              Jusqu’à {MAX_PHOTOS_PER_POST} photos. Elles sont allégées automatiquement et leur localisation est effacée.
            </p>
            <ul id="visit-previews" class="mt-3 grid grid-cols-4 gap-2 sm:grid-cols-6" aria-label="Photos choisies"></ul>
          </div>
          <button type="submit" class={primaryBtn}>Publier la visite</button>
          <p id="visit-status" class="text-sm text-marine/80" role="status"></p>
        </form>
      ) : (
        <form id="message-form" class="mt-8 space-y-4 rounded-2xl border border-marine/15 bg-white/95 p-5 shadow-sm md:p-6" novalidate>
          <h2 class="font-display text-2xl text-marine">Écrire à Céline</h2>
          <label for="message-text" class="sr-only">Votre message</label>
          <textarea
            id="message-text"
            name="text"
            rows="4"
            maxlength="4000"
            placeholder="Une question, une nouvelle, une envie pour la prochaine visite…"
            class={inputClass}
          />
          <p class="text-xs text-marine/65">Votre message sera visible par Céline et par les autres proches de ce dossier.</p>
          <button type="submit" class={primaryBtn}>Envoyer</button>
          <p id="message-status" class="text-sm text-marine/80" role="status"></p>
        </form>
      )
    }

    <h2 class="mt-12 font-display text-3xl text-marine">Le fil des nouvelles</h2>
    {
      posts.length === 0 ? (
        <p class="mt-4 rounded-2xl border border-dashed border-marine/25 bg-cream/80 p-6 text-marine/80">
          Rien pour l’instant. Les comptes-rendus de visite apparaîtront ici.
        </p>
      ) : (
        <ol class="mt-6 space-y-6">
          {posts.map((p) => (
            <li class:list={[
              "rounded-2xl border p-5 shadow-sm md:p-6",
              p.kind === "visite" ? "border-marine/15 bg-white/95" : "border-sauge/40 bg-sauge/10",
            ]}>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-display text-xl text-marine">
                  {p.kind === "visite"
                    ? `Visite du ${fmtDay.format(p.visitDate ?? p.createdAt)}`
                    : `Message de ${p.authorName}`}
                </h3>
                <p class="text-xs text-marine/60">{fmtStamp.format(p.createdAt)}</p>
              </div>
              {p.text && <p class="mt-3 whitespace-pre-line text-base leading-relaxed text-marine/90">{p.text}</p>}
              {p.photoIds.length > 0 && (
                <ul class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3">
                  {p.photoIds.map((photoId, i) => (
                    <li>
                      <button
                        type="button"
                        class="block w-full overflow-hidden rounded-xl ring-1 ring-marine/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-marine"
                        data-photo-open={`/api/photos/${photoId}`}
                        aria-label={`Agrandir la photo ${i + 1}`}
                      >
                        <img
                          src={`/api/photos/${photoId}`}
                          alt={`Photo ${i + 1} de la visite`}
                          loading="lazy"
                          decoding="async"
                          class="aspect-square w-full object-cover"
                        />
                      </button>
                    </li>
                  ))}
                </ul>
              )}
              {(admin || p.authorId === user.id) && (
                <button
                  type="button"
                  class="mt-4 text-sm font-medium text-marine/60 underline underline-offset-2 hover:text-marine"
                  data-delete-post={p.id}
                >
                  Supprimer
                </button>
              )}
            </li>
          ))}
        </ol>
      )
    }

    {
      admin && (
        <section class="mt-14 space-y-6 rounded-2xl border border-marine/15 bg-cream/80 p-5 md:p-6" aria-labelledby="proches-title">
          <h2 id="proches-title" class="font-display text-2xl text-marine">Les proches qui ont accès</h2>
          {members.length === 0 ? (
            <p class="text-marine/75">Personne pour l’instant. Invitez un proche ci-dessous.</p>
          ) : (
            <ul class="divide-y divide-marine/10 rounded-xl bg-white/90">
              {members.map((m) => (
                <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
                  <span>
                    <span class="font-medium text-marine">{m.name}</span>
                    <span class="block text-sm text-marine/65">{m.email}</span>
                  </span>
                  <button
                    type="button"
                    class="min-h-[40px] rounded-lg border border-marine/20 px-3 text-sm font-medium text-marine hover:bg-marine/5"
                    data-remove-member={m.id}
                    data-member-name={m.name}
                  >
                    Retirer l’accès
                  </button>
                </li>
              ))}
            </ul>
          )}

          <form id="invite-form" class="space-y-3" novalidate>
            <h3 class="font-display text-xl text-marine">Inviter un proche</h3>
            <label for="invite-label" class="block text-sm font-medium text-marine">Qui invitez-vous ?</label>
            <input id="invite-label" name="label" type="text" maxlength="120" placeholder="Ex. : son fils Paul" class={inputClass} />
            <button type="submit" class={primaryBtn}>Créer le lien d’invitation</button>
            <p id="invite-status" class="text-sm text-marine/80" role="status"></p>
            <div id="invite-result" class="hidden space-y-3 rounded-xl bg-white p-4 ring-1 ring-marine/15">
              <p class="text-sm text-marine/85">
                Envoyez ce lien au proche (SMS, WhatsApp ou e-mail). Il sert <strong>une seule fois</strong> et reste valable
                14 jours.
              </p>
              <input id="invite-link" type="text" readonly class:list={[inputClass, "text-sm"]} />
              <div class="flex flex-wrap gap-3">
                <button type="button" id="invite-copy" class={primaryBtn}>Copier le lien</button>
                <button
                  type="button"
                  id="invite-share"
                  class="hidden min-h-[48px] rounded-xl border-2 border-marine/20 px-6 font-semibold text-marine hover:bg-marine/5"
                >
                  Partager…
                </button>
              </div>
            </div>
          </form>
        </section>
      )
    }

    <p class="mt-12">
      <a href="/compte" class="font-medium text-aquarelle-bleu underline underline-offset-2 hover:text-marine">← Retour à l’espace familles</a>
    </p>
  </div>

  <dialog id="photo-dialog" class="m-auto max-h-[92vh] w-[min(96vw,64rem)] rounded-2xl bg-marine p-2 backdrop:bg-marine/80">
    <img id="photo-dialog-img" alt="Photo agrandie" class="max-h-[80vh] w-full rounded-xl object-contain" />
    <form method="dialog" class="mt-2 text-center">
      <button class="min-h-[48px] rounded-xl bg-ivoire px-8 font-semibold text-marine">Fermer</button>
    </form>
  </dialog>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-dossier-root]");
  const dossierId = root?.dataset.dossierId ?? "";
  const maxPhotos = Number(root?.dataset.maxPhotos ?? "12");

  /**
   * Toujours un corps JSON, même pour une suppression : sans « Content-Type », la protection
   * d'Astro (checkOrigin) exige une origine identique au port près et peut refuser à tort.
   */
  async function postJson(url: string, body: unknown, method = "POST") {
    const res = await fetch(url, {
      method,
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body ?? {}),
    }).catch(() => null);
    const data = res ? await res.json().catch(() => ({})) : {};
    return { ok: Boolean(res?.ok), data };
  }

  function firstError(data: { error?: string; errors?: Record<string, string[]> }, fallback: string) {
    return data.error ?? Object.values(data.errors ?? {})[0]?.[0] ?? fallback;
  }

  /* ----- Agrandir une photo ----- */
  const dialog = document.getElementById("photo-dialog") as HTMLDialogElement | null;
  const dialogImg = document.getElementById("photo-dialog-img") as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>("[data-photo-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!dialog || !dialogImg) return;
      dialogImg.src = btn.dataset.photoOpen ?? "";
      dialog.showModal();
    });
  });
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });

  /* ----- Supprimer une publication ----- */
  document.querySelectorAll<HTMLButtonElement>("[data-delete-post]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm("Supprimer définitivement cette publication et ses photos ?")) return;
      const { ok, data } = await postJson(`/api/posts/${btn.dataset.deletePost}`, undefined, "DELETE");
      if (ok) window.location.reload();
      else alert(firstError(data, "Suppression impossible."));
    });
  });

  /* ----- Message d'un proche ----- */
  const messageForm = document.getElementById("message-form") as HTMLFormElement | null;
  messageForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const status = document.getElementById("message-status")!;
    const text = String(new FormData(messageForm).get("text") ?? "").trim();
    if (!text) {
      status.textContent = "Écrivez d’abord votre message.";
      return;
    }
    status.textContent = "Envoi…";
    const { ok, data } = await postJson(`/api/dossiers/${dossierId}/posts`, { text });
    if (ok) window.location.reload();
    else status.textContent = firstError(data, "Envoi impossible.");
  });

  /* ----- Nouvelle visite (Céline) ----- */
  const visitForm = document.getElementById("visit-form") as HTMLFormElement | null;
  const photoInput = document.getElementById("visit-photos") as HTMLInputElement | null;
  const previews = document.getElementById("visit-previews");

  photoInput?.addEventListener("change", () => {
    if (!previews || !photoInput.files) return;
    previews.replaceChildren();
    Array.from(photoInput.files)
      .slice(0, maxPhotos)
      .forEach((file) => {
        const li = document.createElement("li");
        const img = document.createElement("img");
        img.src = URL.createObjectURL(file);
        img.alt = "";
        img.className = "aspect-square w-full rounded-lg object-cover ring-1 ring-marine/10";
        li.appendChild(img);
        previews.appendChild(li);
      });
  });

  /** Réduit la photo dans le navigateur (1600 px, JPEG) : envoi rapide et sous la limite du serveur. */
  async function shrink(file: File): Promise<Blob> {
    const bitmap = await createImageBitmap(file);
    const scale = Math.min(1, 1600 / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement("canvas");
    canvas.width = Math.round(bitmap.width * scale);
    canvas.height = Math.round(bitmap.height * scale);
    canvas.getContext("2d")!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close();
    const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, "image/jpeg", 0.85));
    if (!blob) throw new Error("conversion");
    return blob;
  }

  visitForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const status = document.getElementById("visit-status")!;
    const submit = visitForm.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const fd = new FormData(visitForm);
    const text = String(fd.get("text") ?? "").trim();
    const visitDate = String(fd.get("visitDate") ?? "");
    const files = Array.from(photoInput?.files ?? []);

    if (files.length > maxPhotos) {
      status.textContent = `${maxPhotos} photos maximum par visite.`;
      return;
    }
    if (!text && files.length === 0) {
      status.textContent = "Écrivez un mot ou ajoutez au moins une photo.";
      return;
    }

    submit.disabled = true;
    const photoIds: string[] = [];
    try {
      for (const [i, file] of files.entries()) {
        status.textContent = `Envoi de la photo ${i + 1} sur ${files.length}…`;
        let blob: Blob;
        try {
          blob = await shrink(file);
        } catch {
          throw new Error(`La photo « ${file.name} » n’a pas pu être lue (format non pris en charge).`);
        }
        const res = await fetch(`/api/dossiers/${dossierId}/photos`, {
          method: "POST",
          headers: { "Content-Type": "image/jpeg" },
          body: blob,
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(firstError(data, `La photo ${i + 1} n’a pas pu être envoyée.`));
        photoIds.push(data.id);
      }
      status.textContent = "Publication…";
      const { ok, data } = await postJson(`/api/dossiers/${dossierId}/posts`, {
        text,
        photoIds,
        visitDate: visitDate || undefined,
      });
      if (!ok) throw new Error(firstError(data, "Publication impossible."));
      window.location.reload();
    } catch (err) {
      status.textContent = err instanceof Error ? err.message : "Publication impossible.";
      submit.disabled = false;
    }
  });

  /* ----- Proches (Céline) ----- */
  document.querySelectorAll<HTMLButtonElement>("[data-remove-member]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm(`Retirer l’accès de ${btn.dataset.memberName} à ce dossier ?`)) return;
      const { ok, data } = await postJson(
        `/api/dossiers/${dossierId}/members/${btn.dataset.removeMember}`,
        undefined,
        "DELETE",
      );
      if (ok) window.location.reload();
      else alert(firstError(data, "Retrait impossible."));
    });
  });

  const inviteForm = document.getElementById("invite-form") as HTMLFormElement | null;
  inviteForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const status = document.getElementById("invite-status")!;
    const label = String(new FormData(inviteForm).get("label") ?? "").trim();
    if (label.length < 2) {
      status.textContent = "Indiquez qui vous invitez (ex. : son fils Paul).";
      return;
    }
    status.textContent = "Création du lien…";
    const { ok, data } = await postJson(`/api/dossiers/${dossierId}/invitations`, { label });
    if (!ok) {
      status.textContent = firstError(data, "Création impossible.");
      return;
    }
    status.textContent = `Lien créé pour ${label}.`;
    const result = document.getElementById("invite-result")!;
    const linkInput = document.getElementById("invite-link") as HTMLInputElement;
    linkInput.value = data.link;
    result.classList.remove("hidden");
    const share = document.getElementById("invite-share")!;
    if (navigator.share) share.classList.remove("hidden");
  });

  document.getElementById("invite-copy")?.addEventListener("click", async () => {
    const linkInput = document.getElementById("invite-link") as HTMLInputElement;
    const status = document.getElementById("invite-status")!;
    try {
      await navigator.clipboard.writeText(linkInput.value);
      status.textContent = "Lien copié : il ne reste plus qu’à le coller dans un SMS ou un e-mail.";
    } catch {
      linkInput.select();
      status.textContent = "Sélectionnez le lien et copiez-le.";
    }
  });

  document.getElementById("invite-share")?.addEventListener("click", async () => {
    const linkInput = document.getElementById("invite-link") as HTMLInputElement;
    await navigator
      .share({
        title: "Le Sourire de Jojo — Espace familles",
        text: "Voici votre invitation à l’espace familles du Sourire de Jojo :",
        url: linkInput.value,
      })
      .catch(() => {});
  });
</script>
