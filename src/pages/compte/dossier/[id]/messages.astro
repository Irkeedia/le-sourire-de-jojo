---
import DossierShell from "@/components/espace/DossierShell.astro";
import { cap, fmt, frTime, listMessages, markMessagesRead, PARIS_TZ } from "@/lib/dossier-data";
import { loadDossierPage } from "@/lib/dossier-page";

const ctx = await loadDossierPage(Astro);
if (ctx instanceof Response) return ctx;
const { user, admin, dossier } = ctx;
const messages = await listMessages(dossier.id);
// Ouvrir la conversation = tout est lu (la pastille de la tuile disparaît).
await markMessagesRead(user.id, dossier.id);

const dayKey = new Intl.DateTimeFormat("en-CA", { timeZone: PARIS_TZ });
const groups: { label: string; items: typeof messages }[] = [];
for (const m of messages) {
  const label = fmt.dayYear.format(m.createdAt);
  const last = groups.at(-1);
  if (last && dayKey.format(last.items[0].createdAt) === dayKey.format(m.createdAt)) last.items.push(m);
  else groups.push({ label, items: [m] });
}
---

<DossierShell dossier={dossier} active="messages" section={admin ? "Messagerie" : "Écrire à Céline"}>
  <p slot="intro" class="mt-3 flex items-start gap-2 rounded-2xl bg-aquarelle-bleu/10 px-4 py-3 text-base leading-relaxed text-marine/85">
    <span aria-hidden="true">👀</span>
    <span>Ces messages sont visibles par <strong>Céline</strong> et par <strong>tous les proches</strong> de ce dossier.</span>
  </p>

  <section class="mt-6 rounded-3xl border border-marine/10 bg-white/80 p-3 shadow-[0_10px_30px_rgba(29,53,87,0.07)] sm:p-6" aria-label="Conversation">
    {
      messages.length === 0 ? (
        <p class="p-6 text-center text-lg text-marine/70">
          Aucun message pour l’instant. {admin ? "Écrivez le premier à la famille !" : "Écrivez le premier à Céline !"}
        </p>
      ) : (
        <ol id="conversation" class="max-h-[60vh] space-y-2 overflow-y-auto overscroll-contain px-1 py-2">
          {groups.map((g) => (
            <li>
              <p class="my-3 text-center text-sm font-semibold text-marine/55">{cap(g.label)}</p>
              <ol class="space-y-3">
                {g.items.map((m) => {
                  const mine = m.authorId === user.id;
                  return (
                    <li class:list={["flex", mine ? "justify-end" : "justify-start"]}>
                      <div
                        class:list={[
                          "max-w-[85%] rounded-3xl px-4 py-3 sm:max-w-[70%]",
                          mine ? "rounded-br-lg bg-marine text-ivoire" : "rounded-bl-lg border border-marine/10 bg-cream text-marine",
                        ]}
                      >
                        {!mine && (
                          <p class="text-sm font-bold">
                            {m.authorName}
                            {m.authorRole === "admin" && <span class="font-normal text-marine/60"> · Le Sourire de Jojo</span>}
                          </p>
                        )}
                        <p class="whitespace-pre-line text-base leading-relaxed">{m.text}</p>
                        <p class:list={["mt-1 flex items-center justify-end gap-3 text-xs", mine ? "text-ivoire/70" : "text-marine/55"]}>
                          {(mine || admin) && (
                            <button
                              type="button"
                              data-delete-message
                              data-id={m.id}
                              class="underline underline-offset-2 hover:no-underline"
                            >
                              Supprimer
                            </button>
                          )}
                          <span>{frTime(m.createdAt)}</span>
                        </p>
                      </div>
                    </li>
                  );
                })}
              </ol>
            </li>
          ))}
        </ol>
      )
    }

    <form id="message-form" data-dossier-id={dossier.id} class="mt-4 border-t border-marine/10 pt-4" novalidate>
      <label for="message-text" class="block text-base font-semibold text-marine">
        {admin ? "Votre message à la famille" : "Votre message à Céline"}
      </label>
      <textarea
        id="message-text"
        name="text"
        rows="3"
        maxlength="4000"
        placeholder={admin ? "Ex. : Je passerai jeudi vers 14 h." : "Une question, une nouvelle, une envie pour la prochaine visite…"}
        class="mt-2 w-full rounded-2xl border border-marine/25 bg-ivoire px-4 py-3 text-lg text-marine focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30"
      ></textarea>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button type="submit" class="min-h-[56px] rounded-2xl bg-marine px-8 text-lg font-semibold text-ivoire shadow hover:bg-marine/90 disabled:opacity-60">
          Envoyer
        </button>
        <p id="message-status" class="text-base text-marine/80" role="status" aria-live="polite"></p>
      </div>
    </form>
  </section>
</DossierShell>

<script>
  import { firstError, sendJson, wireDeleteButtons } from "@/scripts/espace-api";

  const conversation = document.getElementById("conversation");
  if (conversation) conversation.scrollTop = conversation.scrollHeight;

  const form = document.getElementById("message-form") as HTMLFormElement | null;
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const status = document.getElementById("message-status")!;
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const text = String(new FormData(form).get("text") ?? "").trim();
    if (!text) {
      status.textContent = "Écrivez d’abord votre message.";
      return;
    }
    submit.disabled = true;
    status.textContent = "Envoi…";
    const { ok, data } = await sendJson(`/api/dossiers/${form.dataset.dossierId}/messages`, { text });
    if (ok) window.location.reload();
    else {
      submit.disabled = false;
      status.textContent = firstError(data, "Envoi impossible.");
    }
  });

  wireDeleteButtons("[data-delete-message]", (id) => `/api/messages/${id}`, "Supprimer ce message ?");
</script>
