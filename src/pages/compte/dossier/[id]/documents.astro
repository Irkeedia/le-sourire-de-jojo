---
import DossierShell from "@/components/espace/DossierShell.astro";
import Icon from "@/components/espace/Icon.astro";
import { DOCUMENT_CATEGORIES, fmt, frSize, listDocuments, MAX_DOCUMENT_BYTES, type DocumentCategory } from "@/lib/dossier-data";
import { loadDossierPage } from "@/lib/dossier-page";

const ctx = await loadDossierPage(Astro);
if (ctx instanceof Response) return ctx;
const { admin, dossier } = ctx;
const docs = await listDocuments(dossier.id);
const categories = Object.entries(DOCUMENT_CATEGORIES) as [DocumentCategory, string][];
const grouped = categories
  .map(([key, label]) => ({ key, label, items: docs.filter((d) => d.category === key) }))
  .filter((g) => g.items.length > 0);
const inputClass =
  "mt-1 w-full rounded-xl border border-marine/25 bg-ivoire px-4 py-3 text-lg text-marine focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30";
---

<DossierShell dossier={dossier} section="Documents">
  <p slot="intro" class="mt-3 max-w-2xl text-lg leading-relaxed text-marine/80">
    Contrat, devis, factures et attestation fiscale annuelle, à consulter ou télécharger à tout moment.
  </p>

  {
    docs.length === 0 ? (
      <p class="mt-8 rounded-3xl border border-dashed border-marine/25 bg-white/70 p-8 text-center text-lg text-marine/75">
        Aucun document pour l’instant.
      </p>
    ) : (
      <div class="mt-8 space-y-8">
        {grouped.map((g) => (
          <section aria-labelledby={`cat-${g.key}`}>
            <h2 id={`cat-${g.key}`} class="font-display text-3xl text-marine">{g.label}</h2>
            <ul class="mt-3 space-y-3">
              {g.items.map((d) => (
                <li class="flex flex-col gap-3 rounded-3xl border border-marine/10 bg-white p-4 shadow-[0_8px_24px_rgba(29,53,87,0.06)] sm:flex-row sm:items-center sm:p-5">
                  <span class="flex min-w-0 flex-1 items-center gap-4">
                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-marine/10 text-sm font-bold text-marine">
                      {d.contentType === "application/pdf" ? "PDF" : "IMG"}
                    </span>
                    <span class="min-w-0">
                      <span class="block break-words font-hero text-lg font-semibold text-marine">{d.title}</span>
                      <span class="block text-sm text-marine/60">Déposé le {fmt.short.format(d.uploadedAt)} · {frSize(d.length)}</span>
                    </span>
                  </span>
                  <span class="flex flex-wrap gap-2">
                    <a
                      href={`/api/documents/${d.id}`}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex min-h-[48px] items-center rounded-xl border-2 border-marine/15 px-4 text-base font-semibold text-marine hover:border-marine/30"
                    >
                      Ouvrir
                    </a>
                    <a
                      href={`/api/documents/${d.id}?telecharger`}
                      class="inline-flex min-h-[48px] items-center gap-1.5 rounded-xl bg-marine px-4 text-base font-semibold text-ivoire hover:bg-marine/90"
                    >
                      <Icon name="download" class="h-5 w-5" /> Télécharger
                    </a>
                    {admin && (
                      <button
                        type="button"
                        data-delete-document
                        data-id={d.id}
                        data-confirm={`Supprimer « ${d.title} » ?`}
                        class="inline-flex min-h-[48px] items-center rounded-xl px-3 text-marine/60 hover:text-marine"
                        aria-label={`Supprimer ${d.title}`}
                      >
                        <Icon name="trash" class="h-5 w-5" />
                      </button>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )
  }

  {
    admin && (
      <form
        id="document-form"
        data-dossier-id={dossier.id}
        data-max-bytes={MAX_DOCUMENT_BYTES}
        class="mt-10 space-y-5 rounded-3xl border border-marine/10 bg-white p-5 shadow-[0_10px_30px_rgba(29,53,87,0.07)] sm:p-8"
        novalidate
      >
        <h2 class="font-display text-3xl text-marine">Déposer un document</h2>
        <p class="rounded-2xl bg-rose-vieux/10 px-4 py-3 text-sm leading-relaxed text-marine/80">
          Rappel : pas de données de santé ici (ordonnances, comptes-rendus médicaux…). Cet espace n’est pas un hébergement
          agréé pour les données de santé. Seuls les documents administratifs ont leur place.
        </p>
        <div>
          <label for="doc-file" class="block text-base font-semibold text-marine">Fichier (PDF ou photo, 4 Mo maximum)</label>
          <input
            id="doc-file"
            name="file"
            type="file"
            accept="application/pdf,image/jpeg,image/png,image/webp"
            class="mt-2 block w-full text-base text-marine file:mr-4 file:min-h-[48px] file:rounded-xl file:border-0 file:bg-sauge/30 file:px-4 file:font-semibold file:text-marine"
          />
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="doc-title" class="block text-base font-semibold text-marine">Titre</label>
            <input id="doc-title" name="title" type="text" maxlength="120" placeholder="Ex. : Facture d’octobre 2026" class={inputClass} />
          </div>
          <div>
            <label for="doc-category" class="block text-base font-semibold text-marine">Rubrique</label>
            <select id="doc-category" name="category" class={inputClass}>
              {categories.map(([key, label]) => <option value={key}>{label}</option>)}
            </select>
          </div>
        </div>
        <button type="submit" class="min-h-[56px] rounded-2xl bg-marine px-8 text-lg font-semibold text-ivoire shadow hover:bg-marine/90 disabled:opacity-60">
          Déposer le document
        </button>
        <p id="document-status" class="text-base text-marine/80" role="status" aria-live="polite"></p>
      </form>
    )
  }
</DossierShell>

<script>
  import { firstError, wireDeleteButtons } from "@/scripts/espace-api";

  const form = document.getElementById("document-form") as HTMLFormElement | null;
  const fileInput = document.getElementById("doc-file") as HTMLInputElement | null;
  const titleInput = document.getElementById("doc-title") as HTMLInputElement | null;

  // Titre proposé à partir du nom du fichier.
  fileInput?.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    if (file && titleInput && !titleInput.value) titleInput.value = file.name.replace(/\.[^.]+$/, "").replace(/[_-]+/g, " ");
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const status = document.getElementById("document-status")!;
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const file = fileInput?.files?.[0];
    const title = titleInput?.value.trim() ?? "";
    const category = (document.getElementById("doc-category") as HTMLSelectElement).value;
    if (!file) {
      status.textContent = "Choisissez d’abord un fichier.";
      return;
    }
    if (file.size > Number(form.dataset.maxBytes)) {
      status.textContent = "Ce fichier dépasse 4 Mo. Pour une photo, réduisez-la ; pour un PDF, compressez-le.";
      return;
    }
    if (title.length < 2) {
      status.textContent = "Donnez un titre au document.";
      return;
    }
    submit.disabled = true;
    status.textContent = "Envoi…";
    const res = await fetch(`/api/dossiers/${form.dataset.dossierId}/documents`, {
      method: "POST",
      headers: {
        "Content-Type": file.type || "application/octet-stream",
        "X-Document-Title": encodeURIComponent(title),
        "X-Document-Category": category,
      },
      body: file,
    }).catch(() => null);
    const data = res ? await res.json().catch(() => ({})) : { error: "Pas de connexion internet." };
    if (res?.ok) window.location.reload();
    else {
      submit.disabled = false;
      status.textContent = firstError(data, "Dépôt impossible.");
    }
  });

  wireDeleteButtons("[data-delete-document]", (id) => `/api/documents/${id}`, "Supprimer ce document ?");
</script>
