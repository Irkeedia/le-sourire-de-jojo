---
import AuthLayout from "@/layouts/AuthLayout.astro";
import AuthField from "@/components/espace/AuthField.astro";
import { isDbConfigured } from "@/lib/db-config";
import { findValidInvitation } from "@/lib/family-space";

const dbReady = isDbConfigured();
const invitationToken = Astro.url.searchParams.get("invitation") ?? "";
const invitation = dbReady && invitationToken ? await findValidInvitation(invitationToken) : null;
const invitationInvalid = Boolean(invitationToken) && !invitation;
---

<AuthLayout
  title="Créer mon compte — Espace familles"
  heading="Bienvenue !"
  intro={invitation ? undefined : "Un compte se crée avec le lien d’invitation envoyé par Céline."}
>
  {
    invitation && (
      <p class="mt-4 rounded-2xl bg-gradient-to-r from-[#F7E1D7] to-[#E4ECE2] p-4 text-center text-lg leading-relaxed text-marine">
        Céline vous invite à suivre les nouvelles de <strong>{invitation.dossierName}</strong>.
      </p>
    )
  }
  {
    invitationInvalid && (
      <p class="mt-4 rounded-2xl bg-rose-vieux/15 p-4 text-center text-base text-marine" role="alert">
        Ce lien d’invitation n’est plus valable : il a déjà servi ou il a expiré (14 jours). Demandez-en un nouveau à Céline.
      </p>
    )
  }
  {
    !dbReady && (
      <p class="mt-4 rounded-2xl bg-rose-vieux/15 p-4 text-center text-base text-marine">L’espace familles n’est pas encore ouvert. Il le sera très bientôt !</p>
    )
  }

  <form id="register-form" data-invitation={invitation ? invitationToken : ""} class="mt-6 space-y-4" novalidate>
    <AuthField id="reg-name" name="name" label="Votre prénom et nom" icon="user" autocomplete="name" placeholder="Paul Durand" />
    <AuthField id="reg-email" name="email" type="email" label="Votre e-mail" icon="mail" autocomplete="email" placeholder="prenom@exemple.fr" />
    <AuthField
      id="reg-password"
      name="password"
      type="password"
      label="Choisissez un mot de passe"
      icon="lock"
      autocomplete="new-password"
      hint="8 caractères minimum, avec au moins une lettre et un chiffre."
    />
    <button
      type="submit"
      disabled={!dbReady}
      class="h-14 w-full rounded-full bg-gradient-to-r from-marine via-[#2B4A72] to-[#3E6A8F] text-lg font-bold text-white shadow-[0_14px_28px_rgba(29,53,87,0.3),inset_0_1px_0_rgba(255,255,255,0.2)] transition hover:brightness-110 disabled:opacity-60"
    >
      Créer mon compte
    </button>
    <p data-status class="min-h-[1.5rem] text-center text-base text-marine/80" role="status" aria-live="polite"></p>
  </form>

  <p class="mt-4 border-t border-marine/10 pt-5 text-center text-base text-marine/75">
    Vous avez déjà un compte ?
    <a
      href={invitation ? `/compte/connexion?invitation=${encodeURIComponent(invitationToken)}` : "/compte/connexion"}
      class="inline-flex min-h-[44px] items-center font-semibold text-aquarelle-bleu underline underline-offset-4"
    >
      Se connecter
    </a>
  </p>
</AuthLayout>

<script>
  import { wireAuthForm } from "@/scripts/auth-forms";

  wireAuthForm({
    formId: "register-form",
    endpoint: "/api/auth/register",
    pending: "Création du compte…",
    fallbackError: "Inscription impossible.",
    body: (fd, form) => ({
      name: String(fd.get("name") ?? ""),
      email: String(fd.get("email") ?? ""),
      password: String(fd.get("password") ?? ""),
      invitation: form.dataset.invitation || undefined,
    }),
    onSuccess: () => {
      window.location.href = "/compte";
    },
  });
</script>
