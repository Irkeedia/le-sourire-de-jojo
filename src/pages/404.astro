---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page introuvable — Le Sourire de Jojo" description="La page demandée n’existe pas." noindex>
  <section class="section">
    <div class="wrap stack center" style="max-width: 640px">
      <span class="eyebrow" style="justify-self: center">Erreur 404</span>
      <h1 class="display">Page <em>introuvable</em></h1>
      <p class="lead" style="margin-inline: auto">Ce lien mène peut-être à une ancienne adresse : le site a été simplifié en cinq pages.</p>
      <div class="btn-row" style="justify-content: center; margin-top: 24px">
        <a class="btn btn--primary" href="/">Retour à l’accueil</a>
        <a class="btn btn--secondary" href="/contact">Nous contacter</a>
      </div>
    </div>
  </section>
</BaseLayout>
