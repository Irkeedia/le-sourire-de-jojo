---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import { COMMUNES_ZONE } from "@/lib/catalogue";
import { PACK_IDS, PACK_LABELS, type PackId } from "@/lib/packs";

const title = "Contact — Le Sourire de Jojo";
const description =
  "Demandez votre visite d’évaluation offerte à domicile : Corbarieu, Montauban et alentours (Tarn-et-Garonne). Réponse personnalisée, sans engagement.";

const packParam = Astro.url.searchParams.get("pack") ?? "";
const objetParam = Astro.url.searchParams.get("objet") ?? "";
const safePack = PACK_IDS.includes(packParam as PackId) ? packParam : "";
const defaultSubject = safePack
  ? `Demande — ${PACK_LABELS[safePack as PackId]}`
  : objetParam === "partenariat"
    ? "Demande de partenariat"
    : "";
---

<BaseLayout title={title} description={description} breadcrumb={[{ href: "/", label: "Accueil" }, { label: "Contact" }]}>
  <section class="page-hero" aria-labelledby="page-title">
    <img class="page-hero__flower" src="/images/fleurs/3.webp" alt="" aria-hidden="true" />
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span></nav>
      <div class="split split--7-5" style="align-items: end">
        <div class="stack">
          <span class="eyebrow">Contact</span>
          <h1 class="display" id="page-title">Parlons de <em>votre situation</em></h1>
        </div>
        <p class="lead">Une question sur les créneaux, la zone, une formule ou le carnet ? Nous répondons avec soin, sans engagement. La première visite d’évaluation est offerte.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--7-5" style="align-items: start">
      <div class="contact-form-slot" id="formulaire" style="scroll-margin-top: 100px">
        <ContactForm initialPack={safePack} defaultSubject={defaultSubject} />
      </div>

      <aside class="stack" aria-label="Coordonnées">
        <div class="card">
          <span class="eyebrow">Par téléphone</span>
          <a class="h2" href="tel:+33666309622" style="text-decoration: none; font-size: var(--fs-xl)">06 66 30 96 22</a>
          <p class="small muted">Céline Meunier Ben Neji</p>
        </div>
        <div class="card">
          <span class="eyebrow">Zone d’intervention</span>
          <ul class="communes">{COMMUNES_ZONE.map((c, i) => <li class={i === 0 ? "is-main" : undefined}>{c}</li>)}</ul>
          <p class="xs muted">Déplacements compris dans ces communes. Au-delà : barème kilométrique de l’administration, étude au cas par cas.</p>
        </div>
        <div class="card card--muted">
          <span class="eyebrow">Bon à savoir</span>
          <ul class="checklist small">
            <li>Visite d’évaluation offerte (environ 45 min)</li>
            <li>Crédit d’impôt de 50 %, sous conditions</li>
            <li>Aucune prospection commerciale</li>
          </ul>
          <a class="link small" href="/informations-legales">Mentions légales, CGV, annulation →</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
