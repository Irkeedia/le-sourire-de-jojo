---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  FORFAIT_MENSUEL,
  FORFAITS_ACTIVITES,
  PACK_DECOUVERTE,
  TARIF_HORAIRE_BRUT_EUR as H,
  TARIF_HORAIRE_NET_EUR as HN,
  tarifNetApresCredit as net,
} from "@/lib/tarif";

const title = "Tarifs & aides — Le Sourire de Jojo";
const description =
  "38 € TTC de l’heure, forfaits, crédit d’impôt de 50 % sous conditions, Avance immédiate URSSAF et CESU préfinancés — Corbarieu, Montauban et alentours.";
const HM = FORFAIT_MENSUEL.brutEur / FORFAIT_MENSUEL.heures;
---

<BaseLayout title={title} description={description} breadcrumb={[{ href: "/", label: "Accueil" }, { label: "Tarifs & aides" }]}>
    <section class="page-hero" aria-labelledby="page-title">
      <img class="page-hero__flower" src="/images/fleurs/3.webp" alt="" aria-hidden="true" />
      <div class="wrap">
        <nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><span aria-current="page">Tarifs &amp; aides</span></nav>
        <div class="split split--7-5" style="align-items: end">
          <div class="stack">
            <span class="eyebrow">Tarifs &amp; forfaits</span>
            <h1 class="display" id="page-title">Des tarifs <em>clairs</em>, et la moitié remboursée</h1>
          </div>
          <p class="lead">Une seule base horaire : {H} € TTC. Les déplacements dans la zone d’intervention sont compris. Le crédit d’impôt de 50 % s’applique sous conditions.</p>
        </div>
      </div>
    </section>

    <section class="section" id="formules" aria-labelledby="formules-title" style="scroll-margin-top: 80px">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><span class="eyebrow__num">01</span>Formules</span>
          <h2 class="h2" id="formules-title">Choisissez <em>votre rythme</em></h2>
        </div>
        <div class="plans">
          <article class="plan reveal">
            <div class="stack"><h3 class="h3">Pack découverte</h3><p class="muted small">Accroche douce avant un engagement plus long.</p></div>
            <div class="price"><span class="price__label">Forfait {PACK_DECOUVERTE.heures} heures</span><span class="price__main"><span class="price__amount">{PACK_DECOUVERTE.brutEur}&nbsp;€</span><span class="price__unit">TTC</span></span><p class="price__note">Soit <strong>{net(PACK_DECOUVERTE.brutEur)} €</strong> après crédit d’impôt, sous conditions*.</p></div>
            <ul class="checklist"><li>Une ou plusieurs séances pour faire connaissance</li><li>Repérage des envies et du rythme</li><li>Sans engagement sur la suite</li></ul>
            <a class="btn btn--secondary" href="/contact?pack=decouverte#formulaire">Choisir</a>
          </article>
          <article class="plan plan--featured reveal">
            <span class="plan__ribbon">Recommandé</span>
            <div class="stack"><h3 class="h3">Forfait mensuel</h3><p class="muted small">Des créneaux réguliers pour ancrer le lien.</p></div>
            <div class="price"><span class="price__label">Exemple : {FORFAIT_MENSUEL.heures} h / mois</span><span class="price__main"><span class="price__amount">{FORFAIT_MENSUEL.brutEur}&nbsp;€</span><span class="price__unit">TTC / mois</span></span><p class="price__note">Soit <strong>{net(FORFAIT_MENSUEL.brutEur)} € / mois</strong> après crédit d’impôt, sous conditions*.</p></div>
            <ul class="checklist"><li>{HM} € TTC l’heure au lieu de {H} €</li><li>Planning prévisible</li><li>Continuité du carnet de sourires</li></ul>
            <a class="btn btn--light" href="/contact?pack=mensuel#formulaire">Choisir</a>
          </article>
          <article class="plan reveal">
            <div class="stack"><h3 class="h3">Ponctuel</h3><p class="muted small">À la demande, selon vos besoins du moment.</p></div>
            <div class="price"><span class="price__label">À l’heure</span><span class="price__main"><span class="price__amount">{H}&nbsp;€</span><span class="price__unit">TTC / h</span></span><p class="price__note">Soit <strong>{HN} € / h</strong> après crédit d’impôt, sous conditions*.</p></div>
            <ul class="checklist"><li>Sortie, lecture, démarche, jeu</li><li>En complément des aidants</li></ul>
            <a class="btn btn--secondary" href="/contact?pack=ponctuel#formulaire">Choisir</a>
          </article>
          <article class="plan reveal">
            <div class="stack"><h3 class="h3">Sur-mesure</h3><p class="muted small">Un parcours adapté à votre situation.</p></div>
            <div class="price"><span class="price__label">Devis après entretien</span><span class="price__main"><span class="price__amount" style="font-size: 2rem">Sur devis</span></span><p class="price__note">Même base horaire : <strong>{H} € TTC / h</strong>. Devis gratuit.</p></div>
            <ul class="checklist"><li>Situations atypiques</li><li>Besoins multiples à composer</li></ul>
            <a class="btn btn--secondary" href="/contact?pack=sur_mesure#formulaire">Demander un devis</a>
          </article>
        </div>

        <div class="card card--muted reveal" style="margin-top: 24px; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 12px 28px">
          <strong class="h4">Inclus dans toutes les formules</strong>
          <ul class="checklist small" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); flex: 1">
            <li>Visite d’évaluation offerte (≈ 45 min)</li><li>Carnet des sourires, rempli à chaque visite</li><li>Espace familles en ligne</li><li>Déplacements dans la zone</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section section--white rule-y" id="grille" aria-labelledby="grille-title" style="scroll-margin-top: 80px">
      <div class="wrap">
        <div class="section-head section-head--row">
          <div class="stack">
            <span class="eyebrow"><span class="eyebrow__num">02</span>Grille par pôle</span>
            <h2 class="h2" id="grille-title">Plus la visite est longue, <em>plus l’heure est douce</em></h2>
          </div>
          <p class="muted small" style="max-width: 40ch">Les sorties durent au moins 2 heures. Prix TTC, déplacements compris dans la zone.</p>
        </div>
        <div class="table-wrap reveal">
          <table class="table">
            <thead><tr><th scope="col">Pôle d’activité</th><th scope="col">Durée</th><th scope="col" class="num">Prix TTC</th><th scope="col" class="num">Après crédit d’impôt*</th></tr></thead>
            <tbody>
              {FORFAITS_ACTIVITES.map((f) => (
                <tr><td>{f.label}</td><td>{f.duree}</td><td class="num ttc">{f.brutEur} €</td><td class="num net">{net(f.brutEur)} €</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section" id="simulateur" aria-labelledby="sim-title" style="scroll-margin-top: 80px">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><span class="eyebrow__num">03</span>Simulateur</span>
          <h2 class="h2" id="sim-title">Estimez <em>votre budget</em> mensuel</h2>
          <p class="lead">Une estimation indicative, sur la base horaire de {H} € TTC. Le devis précis est établi après la visite d’évaluation.</p>
        </div>
        <div class="sim reveal" data-sim data-rate={H}>
          <div class="sim__form">
            <div class="range">
              <div class="range__head"><label for="sim-h">Durée de chaque visite</label><output data-sim-hours-out>2 h</output></div>
              <input id="sim-h" type="range" min="1" max="4" step="1" value="2" data-sim-hours />
              <div class="range__head xs muted" style="font-weight: 400"><span>1 h</span><span>4 h</span></div>
            </div>
            <div class="field">
              <span class="field__label small" style="font-weight: 600">Fréquence</span>
              <div class="seg" role="group" aria-label="Fréquence des visites">
                <button type="button" data-freq="1" aria-pressed="false">1 / mois</button>
                <button type="button" data-freq="2" aria-pressed="false">2 / mois</button>
                <button type="button" data-freq="4" aria-pressed="true">1 / semaine</button>
                <button type="button" data-freq="8" aria-pressed="false">2 / semaine</button>
              </div>
            </div>
            <div class="sim__line"><span class="muted">Prix d’une visite</span><strong data-sim-ttc>76 €</strong></div>
          </div>
          <div class="sim__result" aria-live="polite">
            <span class="price__label">Budget mensuel estimé</span>
            <div><span class="sim__total" data-sim-month>304 €</span> <span class="muted small">TTC / mois</span></div>
            <p class="price__note" style="font-size: var(--fs-sm)">Soit <strong data-sim-net>152 €</strong> / mois après crédit d’impôt de 50 %, sous conditions*.</p>
            <a class="btn btn--primary" href="/contact#formulaire" style="justify-self: start">Recevoir un devis gratuit</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--sauge rule-y" id="aides" aria-labelledby="aides-title" style="scroll-margin-top: 80px">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><span class="eyebrow__num">04</span>Aides &amp; financement</span>
          <h2 class="h2" id="aides-title">Trois façons d’<em>alléger la facture</em></h2>
        </div>
        <div class="grid grid-3">
          <article class="card reveal"><span class="card__icon card__icon--sauge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4z"/><path d="M8 15l8-8M8.5 8.5h.01M15.5 15.5h.01"/></svg></span><h3 class="h3">Crédit d’impôt de 50 %</h3><p class="muted small">La moitié des sommes versées vous est remboursée par l’État, dans la limite des plafonds en vigueur, que vous soyez imposable ou non.</p></article>
          <article class="card reveal"><span class="card__icon card__icon--bleu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg></span><h3 class="h3">L’Avance immédiate URSSAF</h3><p class="muted small">Vous ne payez que la moitié de la facture : l’URSSAF verse directement l’autre moitié. Plus besoin d’attendre l’année suivante.</p></article>
          <article class="card reveal"><span class="card__icon card__icon--jaune"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 15h3"/></svg></span><h3 class="h3">Les CESU préfinancés</h3><p class="muted small">Offerts par certaines caisses de retraite, mutuelles ou employeurs : acceptés lorsque le devis ou le contrat le prévoit.</p></article>
        </div>
        <div class="notice reveal" style="margin-top: 24px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg><span>L’APA et la PCH ne financent pas ces prestations, mais Céline peut intervenir en complément des aides déjà en place.</span></div>
        <p class="footnote" style="margin-top: 20px">* Crédit d’impôt prévu à l’article 199 sexdecies du CGI : payé par la personne aidée, hors espèces. Pour les sorties, il est limité aux heures passées au domicile sur l’année. La rédaction d’une biographie n’y ouvre pas droit. Montants indicatifs, précisés au devis.</p>
      </div>
    </section>
</BaseLayout>
