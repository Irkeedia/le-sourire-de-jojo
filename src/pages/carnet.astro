---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FloralAccent from "@/components/FloralAccent.astro";

const title = "Le carnet de sourires — Le Sourire de Jojo";
const description =
  "Le carnet de sourires : journal de liaison entre les séances et livre de souvenirs partagé — Montauban, Tarn-et-Garonne.";

const contenuCarnet = [
  {
    title: "Préférences & habitudes",
    detail: "Chansons, goûts, rythme du jour, ce qui apaise ou stimule — pour que chaque séance reprenne là où la précédente s’est arrêtée.",
  },
  {
    title: "Souvenirs & photos",
    detail: "Pages écrites, images collées, petits dessins ou citations : une mémoire tangible, bienveillante, pas un dossier médical.",
  },
  {
    title: "Messages pour la famille",
    detail: "Un mot pour les proches absents, un compte-rendu doux de la séance, les petits faits marquants de la semaine.",
  },
  {
    title: "Continuité entre les séances",
    detail: "Inside jokes, objectifs atteints, promesses pour la prochaine fois — pour que personne ne se sente « hors boucle ».",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumb={[{ href: "/", label: "Accueil" }, { label: "Le carnet de sourires" }]}
>
  <article class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
    <h1 class="font-display text-4xl text-marine md:text-5xl">Le carnet de sourires</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-marine/85">
      Notre <strong class="text-marine">outil phare</strong> : un journal de liaison et de souvenirs entre les séances — pour la personne
      accompagnée, la famille et toute personne de confiance.
    </p>

    <section class="mt-12 max-w-3xl space-y-5 text-marine/90 leading-relaxed" aria-labelledby="concept-carnet">
      <h2 id="concept-carnet" class="font-display text-2xl text-marine md:text-3xl">Journal de liaison &amp; souvenirs</h2>
      <p class="text-lg">
        Le carnet n’est pas un gadget : c’est le fil conducteur entre nos rencontres. Un{' '}
        <strong class="text-marine">journal de liaison</strong> et en même temps un{' '}
        <strong class="text-marine">livre de souvenirs</strong> où s’inscrivent ce qui compte vraiment.
      </p>
      <p>
        Y sont notés les petits détails qui font la différence — une chanson aimée, une photo ratée devenue culte, une promesse pour la
        semaine suivante, un mot pour les proches qui ne sont pas là ce jour-là.
      </p>
      <p>
        Pour les familles, il trace une mémoire partagée ; pour la personne accompagnée, il restitue la continuité lorsque les journées se
        ressemblent. C’est un objet tangible de dignité et de joie.
      </p>
    </section>

    <section class="relative mt-14 overflow-hidden rounded-3xl border border-marine/15 bg-gradient-to-br from-white to-sauge/20 p-8 md:p-10" aria-labelledby="contenu-carnet-title">
      <FloralAccent position="top" />
      <h2 id="contenu-carnet-title" class="relative font-display text-2xl text-marine md:text-3xl">Que trouve-t-on dans le carnet ?</h2>
      <ul class="relative mt-8 grid gap-4 sm:grid-cols-2">
        {
          contenuCarnet.map((item) => (
            <li class="rounded-2xl border border-marine/12 bg-white/90 p-5 shadow-sm">
              <h3 class="font-display text-xl text-marine">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-marine/85">{item.detail}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-14 rounded-2xl border border-marine/15 bg-sauge/15 p-6 md:p-8" aria-labelledby="carnet-en-ligne-title">
      <h2 id="carnet-en-ligne-title" class="font-display text-2xl text-marine">Carnet en ligne (espace famille)</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-marine/85">
        Les familles peuvent aussi accéder à un <strong class="text-marine">espace privé</strong> pour relire et ajouter des entrées entre
        les séances — le même esprit de liaison, accessible depuis un compte personnel sécurisé.
      </p>
      <p class="mt-6 flex flex-wrap gap-3">
        <a
          href="/compte/connexion"
          class="inline-flex items-center justify-center rounded-xl bg-marine px-5 py-3 font-semibold text-ivoire shadow hover:bg-marine/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-marine"
        >
          Connexion à mon compte
        </a>
        <a
          href="/compte/inscription"
          class="inline-flex items-center justify-center rounded-xl border-2 border-marine bg-white/90 px-5 py-3 font-semibold text-marine hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-marine"
        >
          Créer un compte famille
        </a>
      </p>
    </section>

    <section class="mt-14" aria-labelledby="galerie-carnet">
      <h2 id="galerie-carnet" class="font-display text-3xl text-marine">Visuels du carnet</h2>
      <p class="mt-4 max-w-3xl text-marine/85">
        Un objet soigné, pensé pour durer : reliure, pages à remplir, détails qui reflètent l’identité du Sourire de Jojo.
      </p>

      <div class="mt-10 grid gap-8 md:grid-cols-3">
        <figure class="overflow-hidden rounded-2xl border border-marine/15 bg-white shadow-sm">
          <img
            src="/images/carnet-placeholder.svg"
            data-photo="/images/carnet-ferme.webp"
            alt="Carnet fermé, reliure et détails du Sourire de Jojo"
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
            class="photo-replace h-auto w-full object-cover"
          />
          <figcaption class="px-4 py-3 text-center text-sm text-marine/75">Fermé — première impression</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-marine/15 bg-white shadow-sm">
          <img
            src="/images/carnet-placeholder.svg"
            data-photo="/images/carnet-ouvert.webp"
            alt="Carnet ouvert sur une séance récente"
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
            class="photo-replace h-auto w-full object-cover"
          />
          <figcaption class="px-4 py-3 text-center text-sm text-marine/75">Ouvert — dialogue avec les pages</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-marine/15 bg-white shadow-sm">
          <img
            src="/images/carnet-placeholder.svg"
            data-photo="/images/carnet-pages.webp"
            alt="Exemples de pages intérieures remplies"
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
            class="photo-replace h-auto w-full object-cover"
          />
          <figcaption class="px-4 py-3 text-center text-sm text-marine/75">Pages intérieures — souvenirs écrits et collés</figcaption>
        </figure>
      </div>

      <script>
        document.querySelectorAll("img.photo-replace").forEach((img) => {
          const el = img;
          const hi = el.dataset.photo;
          if (!hi) return;
          const probe = new window.Image();
          probe.onload = () => {
            el.src = hi;
          };
          probe.onerror = () => {};
          probe.src = hi;
        });
      </script>
    </section>

    <section class="mt-16 rounded-2xl border border-marine/15 bg-rose-vieux/15 p-8 text-center md:p-10" aria-labelledby="carnet-cta-title">
      <h2 id="carnet-cta-title" class="font-display text-2xl text-marine md:text-3xl">Envie d’en savoir plus ?</h2>
      <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-marine/85">
        Le carnet s’intègre naturellement à nos formules — forfait mensuel, pack famille ou accompagnement sur-mesure. Parlons-en lors
        d’un premier échange.
      </p>
      <p class="mt-8">
        <a
          href="/contact#formulaire"
          class="inline-flex items-center justify-center rounded-xl bg-marine px-8 py-3 font-semibold text-ivoire shadow hover:bg-marine/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-marine"
        >
          Nous contacter
        </a>
      </p>
    </section>
  </article>
</BaseLayout>
