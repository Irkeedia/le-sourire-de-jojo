{
  "name": "le-sourire-de-jojo",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "node ./dist/server/entry.mjs",
    "build:presentation-deck": "esbuild src/scripts/presentation-deck.ts --outfile=public/scripts/presentation-deck.js --format=iife --target=es2020",
    "build": "npm run build:presentation-deck && astro build",
    "preview": "astro preview",
    "generate:presentation-pdf": "node scripts/generate-presentation-pdf.mjs",
    "generate:encryption-key": "node scripts/generate-encryption-key.mjs",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.5",
    "@astrojs/tailwind": "^6.0.0",
    "@astrojs/vercel": "^8.2.11",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "astro": "^5.18.2",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "mongoose": "^8.14.0",
    "nodemailer": "^8.0.10",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "mongodb-memory-server": "^10.4.3",
    "playwright": "^1.60.0",
    "typescript": "^5.8.3"
  }
}
